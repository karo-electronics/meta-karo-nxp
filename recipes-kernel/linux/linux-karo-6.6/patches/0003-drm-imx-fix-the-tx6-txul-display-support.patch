From: CSouffargi <cs@karo-electronics.de>
Date: Fri, 18 Sep 2026 16:12:52 +0200
Subject: [PATCH] drm/imx: fix the TX6/TXUL display support

Delta of karo-linux c1358a477c2a on top of karo-tx-linux 3ebeb74e758d.

* drm/imx: ldb: match "fsl,imx6dl-ldb" with the i.MX6Q LVDS mux, so
  the i.MX6S/DL find the panel on port@4.
* drm/panel: simple: set the LVDS connector type on edt_et1010g0dsa
  and the nlt_nl12880bc20 SPWG/JEIDA panels; drop the negedge
  pixdata flag of edt_et1010g0dsa.
* drm/imx: ipuv3: install the mode config funcs from the CRTC bind.

Upstream-Status: Pending
---
 drivers/gpu/drm/imx/imx-ldb.c          | 10 ++++++++++
 drivers/gpu/drm/imx/ipuv3/ipuv3-crtc.c |  7 +++++++
 drivers/gpu/drm/imx/ipuv3/ipuv3-kms.h  |  2 +-
 drivers/gpu/drm/panel/panel-simple.c   |  6 +++++-
 4 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/imx/imx-ldb.c b/drivers/gpu/drm/imx/imx-ldb.c
index c45fc8f4744d..36c5e3f75a60 100644
--- a/drivers/gpu/drm/imx/imx-ldb.c
+++ b/drivers/gpu/drm/imx/imx-ldb.c
@@ -542,6 +542,16 @@ static struct bus_mux imx6q_lvds_mux[2] = {
  */
 static const struct of_device_id imx_ldb_dt_ids[] = {
 	{ .compatible = "fsl,imx6q-ldb", .data = imx6q_lvds_mux, },
+	/*
+	 * i.MX6S/DL have the very same LVDS input multiplexer in GPR3 as the
+	 * i.MX6Q, only with fewer valid sources (a single IPU). Their vendor
+	 * dtsi spells the compatible "fsl,imx6dl-ldb", which used to fall
+	 * through to the i.MX53 entry below: with no mux, the driver looked
+	 * for the output port at index 2 instead of 4 (see the binding: "port@2
+	 * on i.MX5, port@4 on i.MX6"), never found the panel and silently fell
+	 * back to the first display-timings of the device tree.
+	 */
+	{ .compatible = "fsl,imx6dl-ldb", .data = imx6q_lvds_mux, },
 	{ .compatible = "fsl,imx53-ldb", .data = NULL, },
 	{ }
 };
diff --git a/drivers/gpu/drm/imx/ipuv3/ipuv3-crtc.c b/drivers/gpu/drm/imx/ipuv3/ipuv3-crtc.c
index 2538c8df0999..055d1f2f90f9 100644
--- a/drivers/gpu/drm/imx/ipuv3/ipuv3-crtc.c
+++ b/drivers/gpu/drm/imx/ipuv3/ipuv3-crtc.c
@@ -389,6 +389,13 @@ static int ipu_drm_bind(struct device *dev, struct device *master, void *data)
 	ipu_crtc->dev = dev;
 	ipu_crtc->plane[0] = primary_plane;
 
+	/* The DPU and LCDIF CRTC drivers do the same from their own bind. */
+	if (!drm->mode_config.funcs)
+		drm->mode_config.funcs = &ipuv3_drm_mode_config_funcs;
+
+	if (!drm->mode_config.helper_private)
+		drm->mode_config.helper_private = &ipuv3_drm_mode_config_helpers;
+
 	crtc = &ipu_crtc->base;
 	crtc->port = pdata->of_node;
 	drm_crtc_helper_add(crtc, &ipu_helper_funcs);
diff --git a/drivers/gpu/drm/imx/ipuv3/ipuv3-kms.h b/drivers/gpu/drm/imx/ipuv3/ipuv3-kms.h
index 72f80a91e33e..2decf3699f90 100644
--- a/drivers/gpu/drm/imx/ipuv3/ipuv3-kms.h
+++ b/drivers/gpu/drm/imx/ipuv3/ipuv3-kms.h
@@ -16,6 +16,6 @@
 #define _IPUV3_KMS_H_
 
 extern const struct drm_mode_config_funcs ipuv3_drm_mode_config_funcs;
-extern struct drm_mode_config_helper_funcs ipuv3_drm_mode_config_helpers;
+extern const struct drm_mode_config_helper_funcs ipuv3_drm_mode_config_helpers;
 
 #endif
diff --git a/drivers/gpu/drm/panel/panel-simple.c b/drivers/gpu/drm/panel/panel-simple.c
index ef69ef32efc3..4a1c1bcfcde1 100644
--- a/drivers/gpu/drm/panel/panel-simple.c
+++ b/drivers/gpu/drm/panel/panel-simple.c
@@ -2003,7 +2003,8 @@ static const struct panel_desc edt_et1010g0dsa = {
 		.height = 136,
 	},
 	.bus_format = MEDIA_BUS_FMT_RGB888_1X7X4_SPWG,
-	.bus_flags = DRM_BUS_FLAG_DE_HIGH | DRM_BUS_FLAG_PIXDATA_DRIVE_NEGEDGE,
+	.bus_flags = DRM_BUS_FLAG_DE_HIGH,
+	.connector_type = DRM_MODE_CONNECTOR_LVDS,
 };
 
 static const struct display_timing evervision_vgg804821_timing = {
@@ -3196,6 +3197,7 @@ static const struct panel_desc nlt_nl12880bc20_jeida = {
 		.height = 163,
 	},
 	.bus_format = MEDIA_BUS_FMT_RGB888_1X7X4_JEIDA,
+	.connector_type = DRM_MODE_CONNECTOR_LVDS,
 };
 
 static const struct panel_desc nlt_nl12880bc20_spwg_18 = {
@@ -3207,6 +3209,7 @@ static const struct panel_desc nlt_nl12880bc20_spwg_18 = {
 		.height = 163,
 	},
 	.bus_format = MEDIA_BUS_FMT_RGB666_1X7X3_SPWG,
+	.connector_type = DRM_MODE_CONNECTOR_LVDS,
 };
 
 static const struct panel_desc nlt_nl12880bc20_spwg_24 = {
@@ -3218,6 +3221,7 @@ static const struct panel_desc nlt_nl12880bc20_spwg_24 = {
 		.height = 163,
 	},
 	.bus_format = MEDIA_BUS_FMT_RGB888_1X7X4_SPWG,
+	.connector_type = DRM_MODE_CONNECTOR_LVDS,
 };
 
 static const struct drm_display_mode nvd_9128_mode = {
