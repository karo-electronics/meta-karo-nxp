 .../freescale/imx95-qs95-5610-qsbase95.dts    | 163 ------------------
 .../boot/dts/freescale/imx95-qs95-5610.dts    |   5 +
 .../freescale/imx95-qs95-enetc0-ksz9131.dtso  |  91 ++++++++++
 .../freescale/imx95-qs95-enetc1-ksz9131.dtso  |  91 ++++++++++
 .../boot/dts/freescale/imx95-qs95-pcie.dtso   |  48 ++++++
 6 files changed, 242 insertions(+), 166 deletions(-)
 delete mode 100644 arch/arm64/boot/dts/freescale/imx95-qs95-5610-qsbase95.dts
 create mode 100644 arch/arm64/boot/dts/freescale/imx95-qs95-enetc0-ksz9131.dtso
 create mode 100644 arch/arm64/boot/dts/freescale/imx95-qs95-enetc1-ksz9131.dtso
 create mode 100644 arch/arm64/boot/dts/freescale/imx95-qs95-pcie.dtso

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 3bffa482419e..f858caa32ac6 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -890,16 +890,20 @@ imx943-orangebox-netc-m33-dtbs := imx943-orangebox.dtb \
 dtb-$(CONFIG_ARCH_MXC) += imx943-orangebox-netc-m33.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx95-qs95-5610.dtb
-dtb-$(CONFIG_ARCH_MXC) += imx95-qs95-5610-qsbase95.dtb
 DTC_FLAGS_imx95-qs95-5610 := -@
-DTC_FLAGS_imx95-qs95-5610-qsbase95 := -@
 dtb-$(CONFIG_ARCH_MXC) += \
+	imx95-qs95-enetc0-ksz9131.dtbo \
+	imx95-qs95-enetc1-ksz9131.dtbo \
+	imx95-qs95-pcie.dtbo \
 	imx95-qs95-lvds-panel.dtbo \
 	imx95-qs95-cam.dtbo \
 	imx95-qs95-raspi-display.dtbo
+DTC_FLAGS_imx95-qs95-enetc0-ksz9131 := -@
+DTC_FLAGS_imx95-qs95-enetc1-ksz9131 := -@
+DTC_FLAGS_imx95-qs95-pcie := -@
 DTC_FLAGS_imx95-qs95-lvds-panel := -@
 DTC_FLAGS_imx95-qs95-cam := -@
-DTC_FLAGS_imx95-qs95-rapsi-display := -@
+DTC_FLAGS_imx95-qs95-raspi-display := -@
 
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk-flexspi-m2.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-5610-qsbase95.dts b/arch/arm64/boot/dts/freescale/imx95-qs95-5610-qsbase95.dts
