diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-enetc0-ksz9131.dtso b/arch/arm64/boot/dts/freescale/imx95-qs95-enetc0-ksz9131.dtso
new file mode 100644
index 000000000000..8b400682bc34
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-enetc0-ksz9131.dtso
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2026 Ka-Ro electronics GmbH
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "imx95-pinfunc.h"
+
+&{/chosen} {
+	overlays {
+		qs95-enetc0-ksz9131;
+	};
+};
+
+&enetc_port0 {
+	phy-handle = <&ethphy0>;
+	phy-mode = "rgmii-id";
+	pinctrl-0 = <&pinctrl_ethphy0 &pinctrl_enetc0>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&netc_emdio {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	pinctrl-0 = <&pinctrl_emdio>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	ethphy0: ethernet-phy@3 {
+		reg = <3>;
+		interrupt-parent = <&gpio2>;
+		interrupts = <24 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&gpio2 28 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <10000>;
+		reset-deassert-us = <120000>;
+
+		rxd0-skew-psec = <100>;
+		rxd1-skew-psec = <180>;
+		rxd2-skew-psec = <104>;
+		rxd3-skew-psec = <115>;
+		txd0-skew-psec = <292>;
+		txd1-skew-psec = <258>;
+		txd2-skew-psec = <239>;
+		txd3-skew-psec = <229>;
+		rxdv-skew-psec = <111>;
+		txen-skew-psec = <192>;
+		rxc-skew-psec = <112>;
+		txc-skew-psec = <110>;
+	};
+};
+
+&scmi_iomuxc {
+	pinctrl_emdio: emdiogrp {
+		fsl,pins = <
+			/* FSEL1=11b: IMX95RM SW_PAD_CTL bits 8-7, IMX95IEC 4.11.4.1 */
+			IMX95_PAD_ENET1_MDC__NETCMIX_TOP_NETC_MDC		0x186
+			IMX95_PAD_ENET1_MDIO__NETCMIX_TOP_NETC_MDIO		0x186
+		>;
+	};
+
+	pinctrl_ethphy0: ethphy0grp {
+		fsl,pins = <
+			/* DSE=X4: IMX95RM SW_PAD_CTL bits 6-1, X5/X6 need 1.8 V NVCC */
+			IMX95_PAD_GPIO_IO28__GPIO2_IO_BIT28  			0x11e
+			IMX95_PAD_GPIO_IO24__GPIO2_IO_BIT24  			0x11e
+		>;
+	};
+
+	pinctrl_enetc0: enetc0grp {
+		fsl,pins = <
+			IMX95_PAD_ENET1_TD3__NETCMIX_TOP_ETH0_RGMII_TD3		0x51e
+			IMX95_PAD_ENET1_TD2__NETCMIX_TOP_ETH0_RGMII_TD2		0x51e
+			IMX95_PAD_ENET1_TD1__NETCMIX_TOP_ETH0_RGMII_TD1		0x51e
+			IMX95_PAD_ENET1_TD0__NETCMIX_TOP_ETH0_RGMII_TD0		0x51e
+			IMX95_PAD_ENET1_TX_CTL__NETCMIX_TOP_ETH0_RGMII_TX_CTL	0x51e
+			/* FSEL1=11b: IMX95RM SW_PAD_CTL bits 8-7, IMX95IEC 4.11.4.1 */
+			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x19e
+			IMX95_PAD_ENET1_RX_CTL__NETCMIX_TOP_ETH0_RGMII_RX_CTL	0x300
+			IMX95_PAD_ENET1_RXC__NETCMIX_TOP_ETH0_RGMII_RX_CLK	0x500
+			IMX95_PAD_ENET1_RD0__NETCMIX_TOP_ETH0_RGMII_RD0		0x500
+			IMX95_PAD_ENET1_RD1__NETCMIX_TOP_ETH0_RGMII_RD1		0x300
+			IMX95_PAD_ENET1_RD2__NETCMIX_TOP_ETH0_RGMII_RD2		0x300
+			IMX95_PAD_ENET1_RD3__NETCMIX_TOP_ETH0_RGMII_RD3		0x300
+		>;
+	};
+};
