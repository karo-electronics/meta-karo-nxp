+		gpio = <&gpio2 15 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&pinctrl_pcie0>;
+	pinctrl-names = "default";
+	reset-gpio = <&gpio2 17 GPIO_ACTIVE_LOW>;
+	host-wake-gpio = <&gpio2 14 GPIO_ACTIVE_LOW>;
+	vpcie-supply = <&reg_m2_pwr>;
+	supports-clkreq;
+	status = "okay";
+};
+
+&scmi_iomuxc {
+	pinctrl_pcie0: pcie0grp {
+		fsl,pins = <
+			IMX95_PAD_GPIO_IO15__GPIO2_IO_BIT15					0x31e		// PCIE_PWR_EN
+			IMX95_PAD_GPIO_IO14__GPIO2_IO_BIT14					0x31e		// PCIE_DET_WAKE
+			IMX95_PAD_GPIO_IO32__HSIOMIX_TOP_PCIE1_CLKREQ_B		0x40000b1e  // PCIE_CLKREQ
+			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17					0x31e		// PCIE_RST_B
+		>;
+	};
+};
