index 000000000000..fa9a843423c8
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-lvds-panel.dtso
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2026 Ka-Ro electronics GmbH
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include "imx95-clock.h"
+
+#define PIXCLK 68200000
+
+&{/} {
+	chosen {
+		overlays {
+			qs95-lvds-panel;
+		};
+	};
+
+	lvds_panel: lvds-panel { /* Tianma TM101JVHG32 */
+		compatible = "tianma,tm101jvhg32", "panel-lvds";
+		width-mm = <217>;
+		height-mm = <136>;
+		data-mapping = "vesa-24";
+		status = "okay";
+
+		panel-timing {
+			clock-frequency = <PIXCLK>;
+			hactive = <1280>;
+			vactive = <800>;
+			hfront-porch = <64>;
+			hback-porch = <100>;
+			hsync-len = <1>;
+			vfront-porch = <40>;
+			vback-porch = <61>;
+			vsync-len = <1>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <0>;
+		};
+
+		port {
+			lvds_panel_in: endpoint {
+				remote-endpoint = <&dl_bridge_out>;
+			};
+		};
+	};
+};
+
+&dpu {
+	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
+			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
+			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
+	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>,
+			  <0>, <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>;
+	assigned-clock-rates = <0>, <(PIXCLK * 6 * 8)>, <(PIXCLK * 6)>;
+};
+
+&lpi2c2 {
+    dsi_lvds_bridge: sn65dsi83@2c {
+		compatible = "ti,sn65dsi83";
+		reg = <0x2c>;
+		vcc-supply = <&reg_1p8v>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				dl_bridge_in: endpoint {
+					remote-endpoint = <&dsi_out>;
+					data-lanes = <1 2>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+				dl_bridge_out: endpoint {
+					remote-endpoint = <&lvds_panel_in>;
+				};
+			};
+		};
+	};
+};
+
+&mipi_dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			dsi_out: endpoint {
+				remote-endpoint = <&dl_bridge_in>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
+&display_pixel_link {
+	status = "okay";
+};
+
+&pixel_interleaver {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	channel@0 {
+		reg = <0>;
+		status = "okay";
+	};
+};
