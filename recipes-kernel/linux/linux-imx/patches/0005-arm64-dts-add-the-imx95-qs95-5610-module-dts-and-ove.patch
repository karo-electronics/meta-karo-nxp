+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "imx95-pinfunc.h"
+
+&{/chosen} {
+	overlays {
+		qs95-pcie;
+	};
+};
+
+&{/} {
+	reg_m2_pwr: regulator-m2-pwr {
+		compatible = "regulator-fixed";
+		regulator-max-microvolt = <3300000>;
+		regulator-min-microvolt = <3300000>;
+		regulator-name = "M.2-power";
+		gpio = <&gpio2 15 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+};
+
+&pcie0 {
+	pinctrl-0 = <&pinctrl_pcie0>;
+	pinctrl-names = "default";
+	reset-gpio = <&gpio2 17 GPIO_ACTIVE_LOW>;
+	host-wake-gpio = <&gpio2 14 GPIO_ACTIVE_LOW>;
+	vpcie-supply = <&reg_m2_pwr>;
+	supports-clkreq;
+	status = "okay";
+};
+
+&scmi_iomuxc {
+	pinctrl_pcie0: pcie0grp {
+		fsl,pins = <
+			IMX95_PAD_GPIO_IO15__GPIO2_IO_BIT15					0x31e		// PCIE_PWR_EN
+			IMX95_PAD_GPIO_IO14__GPIO2_IO_BIT14					0x31e		// PCIE_DET_WAKE
+			IMX95_PAD_GPIO_IO32__HSIOMIX_TOP_PCIE1_CLKREQ_B		0x40000b1e  // PCIE_CLKREQ
+			IMX95_PAD_GPIO_IO17__GPIO2_IO_BIT17					0x31e		// PCIE_RST_B
+		>;
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-raspi-display.dtso b/arch/arm64/boot/dts/freescale/imx95-qs95-raspi-display.dtso
new file mode 100644
index 000000000000..a68dea209266
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-raspi-display.dtso
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2026 Robin Lintermann <rl@karo-electronics.com>
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "imx95-clock.h"
+
+#define PIXCLK 26250000
+
+&{/} {
+	chosen {
+		overlays {
+			qs95-raspi-display;
+		};
+	};
+
+	rpi_panel: rpi-panel {
+		compatible = "panel-dpi";
+		backlight = <&reg_rpi_display>;
+		power-supply = <&reg_rpi_display>;
+		width-mm = <154>;
+		height-mm = <86>;
+		data-mapping = "rgb24";
+		default-on;
+		status = "okay";
+
+		panel-timing {
+			clock-frequency = <PIXCLK>;
+			hactive = <800>;
+			vactive = <480>;
+			hfront-porch = <131>;
+			hback-porch = <45>;
+			hsync-len = <2>;
+			vfront-porch = <7>;
+			vback-porch = <22>;
+			vsync-len = <2>;
+			hsync-active = <0>;
+			vsync-active = <0>;
+			de-active = <1>;
+			pixelclk-active = <1>;
+		};
+
+		port {
+			rpi_panel_in: endpoint {
+				remote-endpoint = <&dd_bridge_out>;
+			};
+		};
+	};
+
+	reg_bridge: reg-bridge {
+		compatible = "regulator-fixed";
+		regulator-name = "bridge_reg";
+		gpio = <&reg_rpi_display 0 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&reg_rpi_display>;
+		enable-active-high;
+	};
+};
+
+&dpu {
+	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
+			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
+			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
+	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>,
+			  <0>, <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>;
+	assigned-clock-rates = <0>, <(PIXCLK * 16 * 8)>, <(PIXCLK * 16)>;
+};
+
+&mipi_dsi {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+    dsi_dpi_bridge: tc358762@0 {
+        reg = <0>;
+		compatible = "toshiba,tc358762";
+		vddc-supply = <&reg_bridge>;
+		status = "okay";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				dd_bridge_in: endpoint {
+					remote-endpoint = <&dsi_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				dd_bridge_out: endpoint {
+					remote-endpoint = <&rpi_panel_in>;
+				};
+			};
+		};
+	};
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			dsi_out: endpoint {
+				remote-endpoint = <&dd_bridge_in>;
+				data-lanes = <1>;
+			};
+		};
+	};
+};
+
+&lpi2c2 {
+	touchpanel@38 {
+		compatible = "edt,edt-ft5506";
+		reg = <0x38>;
+		vcc-supply = <&reg_rpi_display>;
+		reset-gpio = <&reg_rpi_display 1 GPIO_ACTIVE_LOW>;
+
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+	};
+
+	reg_rpi_display: reg-rpi-display@45 {
+		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
+		reg = <0x45>;
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+};
+
+&display_pixel_link {
+	status = "okay";
+};
+
+&pixel_interleaver {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	channel@0 {
+		reg = <0>;
+		status = "okay";
+	};
+};
