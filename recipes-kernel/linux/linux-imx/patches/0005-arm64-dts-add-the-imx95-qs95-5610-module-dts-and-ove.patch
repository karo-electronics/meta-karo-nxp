+
+&{/} {
+	chosen {
+		overlays {
+			qs95-cam;
+		};
+	};
+
+	imx219_clk: imx219-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+};
+
+&lpi2c2 {
+	cam: imx219@10 {
+		compatible = "sony,imx219";
+		reg = <0x10>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_imx219_reset>;
+		reset-gpios = <&gpio2 25 GPIO_ACTIVE_HIGH>;
+		clocks = <&imx219_clk>;
+		orientation = <2>;
+		rotation = <0>;
+		status = "okay";
+
+		port {
+			cam_out: endpoint {
+				remote-endpoint = <&csi0_in>;
+				data-lanes = <1 2>;
+				clock-lanes = <0>;
+				clock-noncontinuous;
+				link-frequencies = /bits/ 64 <456000000>;
+			};
+		};
+	};
+};
+
+&dphy_rx {
+	status = "okay";
+};
+
+&mipi_csi0 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			csi0_in: endpoint {
+				remote-endpoint = <&cam_out>;
+				data-lanes = <1 2>;
+				clock-lanes = <0>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			csi0_out: endpoint {
+				remote-endpoint = <&formatter_0_in>;
+			};
+		};
+	};
+};
+
+&csi_pixel_formatter_0 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			formatter_0_in: endpoint {
+				remote-endpoint = <&csi0_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			formatter_0_out: endpoint {
+				remote-endpoint = <&isi_in_2>;
+			};
+		};
+	};
+};
+
+&isi {
+	/* ERR053003 p.14: ISI writes RAW MSB-aligned, right-shift in software */
+	/* ERR053260 p.13: CHNL_IMG_CTRL FORMAT must match the sensor native RAW */
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@2 {
+			reg = <2>;
+			isi_in_2: endpoint {
+				remote-endpoint = <&formatter_0_out>;
+			};
+		};
+	};
+};
+
+&scmi_iomuxc {
+	pinctrl_imx219_reset: imx219resetgrp {
+		fsl,pins = <
+			IMX95_PAD_GPIO_IO25__GPIO2_IO_BIT25		0x06
+		>;
+	};
+};
diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-copro.dtso b/arch/arm64/boot/dts/freescale/imx95-qs95-copro.dtso
