From 8caa05d1a79990aa39ea8442546d0be4449a0eb6 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 14:35:06 +0200
Subject: [PATCH] arm64: dts: imx95-qs95: 256 MiB CMA for a 2 GiB module

- 960 MiB came from the 16 GiB imx95-19x19-evk
- NXP uses 256 MiB on its 2 GiB i.MX93 boards
- alloc-ranges kept: CMA stays below 4 GiB for DMA
- An overlay can raise size if a product needs more

Upstream-Status: Pending
---
 arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
index 999aad498381..b8d753123de0 100644
--- a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
@@ -78,7 +78,8 @@ linux_cma: linux,cma {
 			compatible = "shared-dma-pool";
 			alloc-ranges = <0 0x80000000 0 0x7f000000>;
 			reusable;
-			size = <0 0x3c000000>;
+			/* 256 MiB like NXP imx93-11x11-evk.dts (2 GiB); raise it in your overlay */
+			size = <0 0x10000000>;
 			linux,cma-default;
 		};
 
-- 
2.43.0

