From c5e4ff8a16842974d6083e34123b27f94c406973 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 14:51:13 +0200
Subject: [PATCH] arm64: dts: imx95-qs95: disable USB park mode in HS,
 ERR052487

- IMX95_P21N ERR052487 p.47, ERR051670 p.51: host may lock up
- Workaround wants PARKMODE_DISABLE SS, HS and FSLS set
- SS already comes from imx95.dtsi, HS added here
- FSLS bit: no dwc3 property in this kernel, left out

Upstream-Status: Pending
---
 arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
index 401f2a9e48d6..2c4e9d2e6f40 100644
--- a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
@@ -521,6 +521,8 @@ &usb3_dwc3 {
 	usb-role-switch;
 	snps,dis-u1-entry-quirk;
 	snps,dis-u2-entry-quirk;
+	/* ERR052487, ERR051670: park mode off in HS too */
+	snps,parkmode-disable-hs-quirk;
 	status = "okay";
 };
 
-- 
2.43.0

