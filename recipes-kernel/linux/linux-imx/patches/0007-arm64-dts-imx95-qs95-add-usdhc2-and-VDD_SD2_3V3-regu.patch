From 082344e5a0c870d42aab4fdc9eea9d0316f9edb3 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 11:38:31 +0200
Subject: [PATCH] arm64: dts: imx95-qs95: add usdhc2 and VDD_SD2_3V3 regulator

- Both nodes disabled: QSBASE95 has no SD2 slot
- LDO1 always on, it also feeds NVCC_ENET
- PF09 GPIO1 VSELECT and GPIO2 LDO1EN as the EVK

Upstream-Status: Pending
---
 .../boot/dts/freescale/imx95-qs95-5610.dts    | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
index 34979ab5c30b..5f6ea221d258 100644
--- a/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
+++ b/arch/arm64/boot/dts/freescale/imx95-qs95-5610.dts
@@ -69,6 +69,23 @@ reg_usb_vbus: regulator-vbus {
 		enable-active-high;
 	};
 
+	/* PF09 LDO1, GPIO2 LDO1EN input (PF09 12.8.10.2), module pin 42 */
+	/* LDO1 also feeds NVCC_ENET and both PHYs: keep it on */
+	reg_usdhc2_vmmc: regulator-usdhc2 {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
+		regulator-name = "VDD_SD2_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio3 7 GPIO_ACTIVE_HIGH>;
+		off-on-delay-us = <12000>;
+		enable-active-high;
+		regulator-boot-on;
+		regulator-always-on;
+		status = "disabled";
+	};
+
 	reserved-memory {
 		ranges;
 		#address-cells = <2>;
@@ -316,6 +333,56 @@ IMX95_PAD_SD1_DATA7__USDHC1_DATA7			0x13fe
 			IMX95_PAD_SD1_STROBE__USDHC1_STROBE			0x15fe
 		>;
 	};
+
+	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
+		fsl,pins = <
+			IMX95_PAD_SD2_RESET_B__GPIO3_IO_BIT7			0x31e
+		>;
+	};
+
+	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
+		fsl,pins = <
+			IMX95_PAD_SD2_CD_B__GPIO3_IO_BIT0			0x31e
+		>;
+	};
+
+	/* USDHC2_VSELECT to PF09 GPIO1, LDO2 3.3/1.8 V (PF09 Tab.85) */
+	pinctrl_usdhc2: usdhc2grp {
+		fsl,pins = <
+			IMX95_PAD_SD2_CLK__USDHC2_CLK				0x158e
+			IMX95_PAD_SD2_CMD__USDHC2_CMD				0x138e
+			IMX95_PAD_SD2_DATA0__USDHC2_DATA0			0x138e
+			IMX95_PAD_SD2_DATA1__USDHC2_DATA1			0x138e
+			IMX95_PAD_SD2_DATA2__USDHC2_DATA2			0x138e
+			IMX95_PAD_SD2_DATA3__USDHC2_DATA3			0x138e
+			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
+
+	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
+		fsl,pins = <
+			IMX95_PAD_SD2_CLK__USDHC2_CLK				0x158e
+			IMX95_PAD_SD2_CMD__USDHC2_CMD				0x138e
+			IMX95_PAD_SD2_DATA0__USDHC2_DATA0			0x138e
+			IMX95_PAD_SD2_DATA1__USDHC2_DATA1			0x138e
+			IMX95_PAD_SD2_DATA2__USDHC2_DATA2			0x138e
+			IMX95_PAD_SD2_DATA3__USDHC2_DATA3			0x138e
+			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
+
+	/* X6 drive at 1.8 V only (IMX95IEC), reached after VSELECT */
+	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
+		fsl,pins = <
+			IMX95_PAD_SD2_CLK__USDHC2_CLK				0x15fe
+			IMX95_PAD_SD2_CMD__USDHC2_CMD				0x13fe
+			IMX95_PAD_SD2_DATA0__USDHC2_DATA0			0x13fe
+			IMX95_PAD_SD2_DATA1__USDHC2_DATA1			0x13fe
+			IMX95_PAD_SD2_DATA2__USDHC2_DATA2			0x13fe
+			IMX95_PAD_SD2_DATA3__USDHC2_DATA3			0x13fe
+			IMX95_PAD_SD2_VSELECT__USDHC2_VSELECT			0x51e
+		>;
+	};
 };
 
 /* Tj max 105 C industrial (IMX95IEC Tab.23); SM resets at 107 C */
@@ -478,6 +545,20 @@ &usdhc1 {
 	status = "okay";
 };
 
+/* SD2 pads 82-88 (QS95 data sheet p.10), enable with reg_usdhc2_vmmc */
+&usdhc2 {
+	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
+	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
+	pinctrl-3 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
+	cd-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;
+	fsl,cd-gpio-wakeup-disable;
+	vmmc-supply = <&reg_usdhc2_vmmc>;
+	bus-width = <4>;
+	status = "disabled";
+};
+
 &vpuctrl {
 	boot = <&vpu_boot>;
 	sram = <&sram1>;
-- 
2.43.0

