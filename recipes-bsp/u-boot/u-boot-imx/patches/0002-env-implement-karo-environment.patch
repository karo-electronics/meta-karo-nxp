 baseboard=qsbase95
-bootcmd=bootflow scan -lb; run bsp_bootcmd
-initrd_addr=0x93800000
-initrd_high=0xffffffffffffffff
-kernel_addr_r=CONFIG_SYS_LOAD_ADDR
-image=Image
-splashimage=0xA0000000
+boot_mode=mmc
+bootargs_mmc=run default_bootargs; setenv bootargs ${bootargs} root=${mmcroot} ${append_bootargs} ${dyndbg}
+bootargs_nfs=run default_bootargs; setenv bootargs ${bootargs} root=/dev/nfs nfsroot=${nfs_server}:${nfsroot},nolock,v3 ip=dhcp ${append_bootargs} ${dyndbg}
+bootcmd=run bootcmd_${boot_mode} bootm_cmd
+bootcmd_mmc=run loadkernel bootargs_mmc
+bootcmd_nfs=run loadkernel bootargs_nfs
+bootm_cmd=booti ${loadaddr} ${initrd_addr} ${fdt_addr}
 console=ttyLP0,115200 earlycon
-fdt_addr_r=0x93000000
-fdt_addr=0x93000000
-fdt_file=imx95-qs95-5610-qsbase95.dtb
-cntr_addr=0xA8000000
-cntr_file=os_cntr_signed.bin
-boot_fit=no
-bootm_size=0x10000000
+debug_overlays=yes
+default_bootargs=setenv bootargs console=${console} panic=-1
+dyndbg=dyndbg=\\"-p\\"
 emmc_boot_ack=1
 emmc_boot_part=1
 emmc_dev=0
 mmcdev=0
 mmcpart=1
 mmcroot=/dev/mmcblk0p2 rootwait rw
-mmcautodetect=yes
-prepare_mcore=setenv mcore_args pd_ignore_unused;
-loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}
-loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr_r} ${fdt_file}
-loadcntr=fatload mmc ${mmcdev}:${mmcpart} ${cntr_addr} ${cntr_file}
-overlays_qsbase95=qs95-lvds-panel qs95-cam
-auth_os=booti ${cntr_addr}
-boot_os=booti ${loadaddr} - ${fdt_addr_r};
-mmcargs=setenv bootargs ${mcore_args} console=${console} root=${mmcroot} ${append_bootargs}
-mmcboot=echo Booting from mmc ...;
-		run mmcargs;
-		if test ${sec_boot} = yes; then
-			run auth_os;
-		else
-			if test ${boot_fit} = yes || test ${boot_fit} = try; then
-				bootm ${loadaddr};
-			else
-				run boot_os;
-			fi;
-		fi;
-netargs=setenv bootargs ${mcore_args} console=${console} root=/dev/nfs
-		ip=dhcp nfsroot=${serverip}:${nfsroot},v3,tcp ${append_bootargs}
-netboot=echo Booting from net ...;
-		run netargs;
-		if test ${ip_dyn} = yes; then
-			setenv get_cmd dhcp;
-		else
-			setenv get_cmd tftp;
-		fi;
-		if test ${sec_boot} = yes; then
-			${get_cmd} ${cntr_addr} ${cntr_file};
-			run auth_os;
-		else
-			${get_cmd} ${loadaddr} ${image};
-			if test ${boot_fit} = yes || test ${boot_fit} = try; then
-				bootm ${loadaddr};
-			else
-				if ${get_cmd} ${fdt_addr_r} ${fdt_file}; then
-					run boot_os;
-				else
-					echo WARN: Cannot load the DT;
-				fi;
-			fi;
-		fi;
-bsp_bootcmd=echo Running BSP bootcmd ...;
-			mmc dev ${mmcdev};
-			if mmc rescan; then
-				if test ${sec_boot} = yes; then
-					if run loadcntr; then
-						run mmcboot;
-					else run netboot;
-					fi;
-				else
-					if run loadimage; then
-						run mmcboot;
-					else run netboot;
-					fi;
-				fi;
-			fi;
+fastboot_dev=mmc
+fdtaddr=93000000
+fdtsave=save mmc ${mmcdev} ${fdt_addr} /${fdt_file} ${fdt_size}
+fdt_addr=93000000
+fdt_file=imx95-qs95-5610-qsbase95.dtb
+fdt_high=a3000000
+initrd_addr=-
+initrd_high=a3800000
+linux_image=Image
+loadaddr=90400000
+loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdt_file}
+loadkernel=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${linux_image}
+overlays_qsbase95=qs95-raspi-display qs95-cam
+otg_mode=peripheral
