diff --git a/arch/arm/mach-imx/Kconfig b/arch/arm/mach-imx/Kconfig
index f2b00248d90..72c16578898 100644
--- a/arch/arm/mach-imx/Kconfig
+++ b/arch/arm/mach-imx/Kconfig
@@ -561,3 +561,5 @@ config BOOTLOADER_MENU
 	bootloader menu feature for android device.
 
 endif
+
+source "board/karo/Kconfig"
diff --git a/board/karo/Kconfig b/board/karo/Kconfig
new file mode 100644
index 00000000000..c3bc42c5109
--- /dev/null
+++ b/board/karo/Kconfig
@@ -0,0 +1,22 @@
+config UBOOT_IGNORE_ENV
+       bool
+       help
+	 Ignore non-volatile environment settings and use default
+	 environment only.
+
+choice
+	prompt "U-Boot image variant"
+	default KARO_UBOOT_DEFAULT
+
+config KARO_UBOOT_DEFAULT
+	bool "Standard U-Boot image"
+
+config KARO_UBOOT_MFG
+	bool "U-Boot image for use with Freescale's MfGTool or UUU"
+	select UBOOT_IGNORE_ENV
+
+config KARO_UBOOT_NOENV
+	bool "U-Boot using only built-in environment"
+	select UBOOT_IGNORE_ENV
+
+endchoice
diff --git a/board/karo/common/Makefile b/board/karo/common/Makefile
index d52a294d2e3..d600fd664ba 100644
--- a/board/karo/common/Makefile
+++ b/board/karo/common/Makefile
@@ -5,7 +5,5 @@
 #
 
 ifndef CONFIG_XPL_BUILD
-obj-y += env.o fdt.o
-else
-obj- := __dummy__.o
+	obj-y += env.o fdt.o
 endif
diff --git a/board/karo/common/env.c b/board/karo/common/env.c
index 069fcdd5cf6..1ce4984153c 100644
--- a/board/karo/common/env.c
+++ b/board/karo/common/env.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * (C) Copyright 2023 Lothar Waßmann <LW@KARO-electronics.de>
+ * (C) Copyright 2026 Lothar Waßmann <LW@KARO-electronics.de>
  *
  */
 
@@ -53,6 +53,13 @@ static void karo_env_set_uboot_vars(void)
 {
 	env_set("board_name", KARO_BOARD_NAME);
 
+	if (IS_ENABLED(CONFIG_KARO_UBOOT_MFG))
+		env_set("board_rev", "mfg");
+	else if (IS_ENABLED(CONFIG_UBOOT_IGNORE_ENV))
+		env_set("board_rev", "noenv");
+	else
+		env_set("board_rev", "default");
+
 	if (!env_get("soc_prefix"))
 		env_set("soc_prefix", SOC_PREFIX);
 	if (!env_get("soc_family"))
@@ -106,6 +113,14 @@ void karo_set_ethaddr(int index)
 	}
 }
 
+#ifdef CONFIG_UBOOT_IGNORE_ENV
+void karo_env_cleanup(void)
+{
+	printf("Using default environment\n");
+	env_set_default(NULL, 0);
+	karo_env_set_uboot_vars();
+}
+#else
 static const char * const cleanup_vars[] = {
 	"bootargs",
 	"fileaddr",
@@ -128,3 +143,4 @@ void karo_env_cleanup(void)
 	}
 	karo_env_set_uboot_vars();
 }
+#endif
diff --git a/board/karo/common/fdt.c b/board/karo/common/fdt.c
index 2d921eb1ac8..b865235336f 100644
--- a/board/karo/common/fdt.c
+++ b/board/karo/common/fdt.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * (C) Copyright 2023 Lothar Waßmann <LW@KARO-electronics.de>
+ * (C) Copyright 2026 Lothar Waßmann <LW@KARO-electronics.de>
  *
  */
 
@@ -30,6 +30,7 @@ static void karo_set_fdtsize(void *fdt)
 	env_set_hex("fdt_size", fdt_totalsize(fdt));
 }
 
+#ifdef CONFIG_KARO_UBOOT_DEFAULT
 static char *karo_fdt_overlay_filename(const char *prefix, const char *overlay,
 				       const char *dev_type, const char *dev_part)
 {
@@ -61,6 +62,12 @@ static char *karo_fdt_overlay_filename(const char *prefix, const char *overlay,
 	return NULL;
 }
 
+#ifdef DEBUG
+static bool fdt_overlay_debug = 1;
+#else
+static bool fdt_overlay_debug;
+#endif
+
 int karo_load_fdt_overlay(void *fdt, const char *dev_type, const char *dev_part,
 			  const char *overlay)
 {
@@ -85,8 +92,9 @@ int karo_load_fdt_overlay(void *fdt, const char *dev_type, const char *dev_part,
 		}
 	}
 
-	printf("loading FDT overlay for '%s' from %s %s '%s'\n",
-		overlay, dev_type, dev_part, filename);
+	if (fdt_overlay_debug)
+		printf("loading FDT overlay for '%s' from %s %s '%s'\n",
+			overlay, dev_type, dev_part, filename);
 
 	if (fs_set_blk_dev(dev_type, dev_part, FS_TYPE_ANY)) {
 		ret = -ENOENT;
@@ -156,7 +164,7 @@ int karo_fdt_get_overlays(const char *baseboard, char **overlays)
 		}
 		*overlays = env_get(overlay_var);
 		free(overlay_var);
-		if (strstr(*overlays, "setenv overlays"))
+		if (*overlays && strstr(*overlays, "setenv overlays"))
 			*overlays += strlen("setenv overlays ");
 	} else {
 		*overlays = env_get("overlays");
@@ -170,6 +178,8 @@ void karo_fdt_apply_overlays(void *fdt, const char *dev_type, const char *dev_pa
 	const char *baseboard = env_get("baseboard");
 	char *overlays;
 
+	fdt_overlay_debug |= env_get_yesno("debug_overlays") == 1;
+
 	ret = karo_fdt_get_overlays(baseboard, &overlays);
 	if (ret == 0 && overlays) {
 		char *overlay_list = strdup(overlays);
@@ -198,6 +208,11 @@ void karo_fdt_apply_overlays(void *fdt, const char *dev_type, const char *dev_pa
 	if (ret)
 		memset(fdt, 0, sizeof(struct fdt_header));
 }
+#else
+static inline void karo_fdt_apply_overlays(void *fdt, const char *dev_type, const char *dev_part)
+{
+}
+#endif
 
 int karo_load_fdt(const char *fdt_file)
 {
@@ -261,8 +276,20 @@ int karo_load_fdt(const char *fdt_file)
 }
 
 #ifdef CONFIG_OF_BOARD_SETUP
+static int karo_fdt_set_dr_mode(void *blob, int node, const char *mode)
+{
+	if (!fdtdec_get_is_enabled(blob, node)) {
+		printf("usbotg interface is disabled\n");
+		return 0;
+	}
+
+	printf("switching usbotg interface to %s mode\n", mode);
+	return fdt_setprop_string(blob, node, "dr_mode", mode);
+}
+
 int ft_karo_common_setup(void *blob, struct bd_info *bd)
 {
+	int node;
 	const char *serno_str;
 
 	serno_str = env_get("serial#");
@@ -275,6 +302,22 @@ int ft_karo_common_setup(void *blob, struct bd_info *bd)
 
 	fdt_fixup_ethernet(blob);
 
+	node = fdt_path_offset(blob, "usbotg");
+	if (node > 0) {
+		const char *otg_mode = env_get("otg_mode");
+
+		if (strcmp(otg_mode, "peripheral") == 0 ||
+		    strcmp(otg_mode, "device") == 0 ||
+		    strcmp(otg_mode, "host") == 0) {
+			karo_fdt_set_dr_mode(blob, node, otg_mode);
+		} else if (!otg_mode || strcmp(otg_mode, "none") == 0) {
+			printf("disabling usbotg interface\n");
+			fdt_status_disabled(blob, node);
+		} else if (otg_mode) {
+			printf("Invalid otg_mode: '%s'\n", otg_mode);
+		}
+	}
+
 	return 0;
 }
 
