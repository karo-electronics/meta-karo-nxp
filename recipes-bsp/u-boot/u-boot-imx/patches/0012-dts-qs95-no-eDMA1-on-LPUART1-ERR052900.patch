From 7a2351beccf2dc32894404d2099d13d349907f94 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 14:51:14 +0200
Subject: [PATCH] dts: qs95: no eDMA1 on LPUART1, ERR052900

- IMX95_P21N ERR052900 p.27: DMA1 overflows the LPUART1 TX buffer
- Mirrors the Linux tree, U-Boot drives LPUART by PIO

Upstream-Status: Pending
---
 arch/arm/dts/imx95-qs95-5610.dts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm/dts/imx95-qs95-5610.dts b/arch/arm/dts/imx95-qs95-5610.dts
index 61c2aea1a68..8daf4faac6a 100644
--- a/arch/arm/dts/imx95-qs95-5610.dts
+++ b/arch/arm/dts/imx95-qs95-5610.dts
@@ -150,6 +150,9 @@
 };
 
 &lpuart1 {
+	/* ERR052900: eDMA1 corrupts LPUART1 TX, PIO only */
+	/delete-property/ dmas;
+	/delete-property/ dma-names;
 	pinctrl-0 = <&pinctrl_uart1>;
 	pinctrl-names = "default";
 	status = "okay";
-- 
2.43.0

