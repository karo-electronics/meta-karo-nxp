diff --git a/board/karo/imx95/qs95-9610-qsbase95.env b/board/karo/imx95/qs95-9610-qsbase95.env
new file mode 100644
index 00000000000..525eb1a91ce
--- /dev/null
+++ b/board/karo/imx95/qs95-9610-qsbase95.env
@@ -0,0 +1,32 @@
+append_bootargs=quiet
+autoload=no
+baseboard=qsbase95
+boot_mode=mmc
+bootargs_mmc=run default_bootargs; setenv bootargs ${bootargs} root=PARTUUID=${uuid_rootfs} rootwait rw ${append_bootargs} ${dyndbg}
+bootargs_nfs=run default_bootargs; setenv bootargs ${bootargs} root=/dev/nfs nfsroot=${nfs_server}:${nfsroot},nolock,v3 ip=dhcp ${append_bootargs} ${dyndbg}
+bootcmd=run bootcmd_${boot_mode} bootm_cmd
+bootcmd_mmc=run loadkernel bootargs_mmc
+bootcmd_nfs=run loadkernel bootargs_nfs
+bootm_cmd=booti ${loadaddr} ${initrd_addr} ${fdt_addr}
+console=ttyLP0,115200 earlycon
+debug_overlays=yes
+default_bootargs=setenv bootargs console=${console} panic=-1 pci=pcie_bus_perf
+dyndbg=dyndbg='"-p"'
+emmc_boot_ack=1
+emmc_boot_part=1
+emmc_dev=0
+fastboot_dev=mmc
+mmcdev=0
+mmcpart=1
+fdtaddr=93000000
+fdtsave=save mmc ${mmcdev} ${fdt_addr} /${fdt_file} ${fdt_size}
+fdt_addr=93000000
+fdt_file=imx95-qs95-9610.dtb
+fdt_high=a3000000
+initrd_addr=-
+initrd_high=a3800000
+linux_image=Image
+loadaddr=90400000
+loadfdt=load mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdt_file}
+loadkernel=load mmc ${mmcdev}:${mmcpart} ${loadaddr} ${linux_image}
+otg_mode=peripheral
