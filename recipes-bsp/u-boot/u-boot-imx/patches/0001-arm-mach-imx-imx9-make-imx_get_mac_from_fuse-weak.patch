From 6f1bb35fab4f29d9dbfbf4263c44f6b15f717949 Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Mon, 2 Nov 2026 15:28:48 +0000
Subject: [PATCH] arm: mach-imx: imx9: make imx_get_mac_from_fuse() weak

Mark imx_get_mac_from_fuse() as __weak in both the legacy and the SCMI
based i.MX9 SoC code so that boards can override it with their own
implementation, e.g. to derive the MAC address from board specific
fuses.

Signed-off-by: Robin Lintermann <rl@karo-electronics.de>

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 arch/arm/mach-imx/imx9/scmi/soc.c | 2 +-
 arch/arm/mach-imx/imx9/soc.c      | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm/mach-imx/imx9/scmi/soc.c b/arch/arm/mach-imx/imx9/scmi/soc.c
index 79114704d6d..f12901764e0 100644
--- a/arch/arm/mach-imx/imx9/scmi/soc.c
+++ b/arch/arm/mach-imx/imx9/scmi/soc.c
@@ -772,7 +772,7 @@ static inline void eth_addr_add(u8 *addr, long offset)
 	u64_to_ether_addr(u, addr);
 }
 
-void imx_get_mac_from_fuse(int dev_id, unsigned char *mac)
+__weak void imx_get_mac_from_fuse(int dev_id, unsigned char *mac)
 {
 	u32 val[2] = {};
 	int ret, num_of_macs;
diff --git a/arch/arm/mach-imx/imx9/soc.c b/arch/arm/mach-imx/imx9/soc.c
index ca14a2de7cc..1b4059896c6 100644
--- a/arch/arm/mach-imx/imx9/soc.c
+++ b/arch/arm/mach-imx/imx9/soc.c
@@ -543,7 +543,7 @@ phys_size_t get_effective_memsize(void)
 	}
 }
 
-void imx_get_mac_from_fuse(int dev_id, unsigned char *mac)
+__weak void imx_get_mac_from_fuse(int dev_id, unsigned char *mac)
 {
 	u32 val[2] = {};
 	int ret;
