From b3e76c767048af3f1607e4d2a4d0d1a81578c0c2 Mon Sep 17 00:00:00 2001
From: Robin Lintermann <rl@karo-electronics.de>
Date: Mon, 2 Nov 2026 15:29:07 +0000
Subject: [PATCH] fastboot: do not tie UUU support to the FSL implementation

FASTBOOT_UUU_SUPPORT does not require FSL_FASTBOOT. Drop the
unconditional 'select FSL_FASTBOOT' so that UUU can be used with the
standard fastboot flash implementation, and remove the g_fastboot_stdio
references from f_fastboot.c, since that stdio device is provided by
the FSL implementation (fb_fsl_common.c) and is not guaranteed to be
built when UUU support is enabled.

Upstream-Status: Inappropriate [karo-specific]
Signed-off-by: Robin Lintermann <rl@karo-electronics.de>

Generated by Mistral Vibe.
Co-Authored-By: Mistral Vibe <vibe@mistral.ai>
---
 drivers/fastboot/Kconfig        |  1 -
 drivers/usb/gadget/f_fastboot.c | 16 ----------------
 2 files changed, 17 deletions(-)

diff --git a/drivers/fastboot/Kconfig b/drivers/fastboot/Kconfig
index a8dfdc87c7f..fca70fc307e 100644
--- a/drivers/fastboot/Kconfig
+++ b/drivers/fastboot/Kconfig
@@ -103,7 +103,6 @@ config FASTBOOT_FLASH
 config FASTBOOT_UUU_SUPPORT
 	bool "Enable UUU support"
 	default y if ARCH_MX7 || ARCH_MX6 || ARCH_IMX8 || ARCH_IMX8M || ARCH_MX7ULP
-	select FSL_FASTBOOT
 	select FAT_WRITE
 	select CMD_GPT
 	select RANDOM_UUID
diff --git a/drivers/usb/gadget/f_fastboot.c b/drivers/usb/gadget/f_fastboot.c
index 8c758643782..5b0109b9269 100644
--- a/drivers/usb/gadget/f_fastboot.c
+++ b/drivers/usb/gadget/f_fastboot.c
@@ -206,10 +206,6 @@ static struct usb_gadget_strings *fastboot_strings[] = {
 	NULL,
 };
 
-#if CONFIG_IS_ENABLED(FASTBOOT_UUU_SUPPORT)
-extern struct stdio_dev g_fastboot_stdio;
-#endif
-
 static void rx_handler_command(struct usb_ep *ep, struct usb_request *req);
 
 static void fastboot_fifo_complete(struct usb_ep *ep, struct usb_request *req)
@@ -306,10 +302,6 @@ static int fastboot_bind(struct usb_configuration *c, struct usb_function *f)
 	if (s)
 		g_dnl_set_serialnumber((char *)s);
 
-#if CONFIG_IS_ENABLED(FASTBOOT_UUU_SUPPORT)
-	stdio_register(&g_fastboot_stdio);
-#endif
-
 	return 0;
 }
 
@@ -318,14 +310,6 @@ static void fastboot_unbind(struct usb_configuration *c, struct usb_function *f)
 	f->os_desc_table = NULL;
 	list_del(&fb_os_desc.ext_prop);
 	memset(fastboot_func, 0, sizeof(*fastboot_func));
-
-#if CONFIG_IS_ENABLED(FASTBOOT_UUU_SUPPORT) && CONFIG_IS_ENABLED(SYS_STDIO_DEREGISTER)
-	struct stdio_dev *dev;
-	dev = stdio_get_by_name("fastboot");
-	if (dev)
-		stdio_deregister_dev(dev, 1);
-#endif
-
 }
 
 static void fastboot_disable(struct usb_function *f)
