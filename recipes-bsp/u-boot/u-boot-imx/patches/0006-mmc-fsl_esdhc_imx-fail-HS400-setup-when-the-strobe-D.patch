From 4c39ef17c290b293027d25df5bca86e2f0995dee Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 16:58:05 +0200
Subject: [PATCH] mmc: fsl_esdhc_imx: fail HS400 setup when the strobe DLL does
 not lock

- IMX95RM 76.3.10.5 step 11: REF and SLV lock before any transfer
- STROBE_DLL_STATUS polled up to 5 ms instead of a blind 5 ms wait
- Error returned, the MMC core falls back to the next bus mode
- QS95 v2: Macronix MX52LM08A11 in HS400ES, mmc info 14/09

Upstream-Status: Pending
---
 drivers/mmc/fsl_esdhc_imx.c | 28 ++++++++++++++++++----------
 1 file changed, 18 insertions(+), 10 deletions(-)

diff --git a/drivers/mmc/fsl_esdhc_imx.c b/drivers/mmc/fsl_esdhc_imx.c
index a8562ba0a7c..64af50eb2f4 100644
--- a/drivers/mmc/fsl_esdhc_imx.c
+++ b/drivers/mmc/fsl_esdhc_imx.c
@@ -706,11 +706,12 @@ static void esdhc_reset_tuning(struct mmc *mmc)
 	}
 }
 
-static void esdhc_set_strobe_dll(struct mmc *mmc)
+static int esdhc_set_strobe_dll(struct mmc *mmc)
 {
 	struct fsl_esdhc_priv *priv = dev_get_priv(mmc->dev);
 	struct fsl_esdhc *regs = priv->esdhc_regs;
 	u32 val;
+	int ret;
 
 	if (priv->clock > ESDHC_STROBE_DLL_CLK_FREQ) {
 		esdhc_write32(&regs->strobe_dllctrl, ESDHC_STROBE_DLL_CTRL_RESET);
@@ -726,14 +727,18 @@ static void esdhc_set_strobe_dll(struct mmc *mmc)
 			(priv->strobe_dll_delay_target <<
 			 ESDHC_STROBE_DLL_CTRL_SLV_DLY_TARGET_SHIFT);
 		esdhc_write32(&regs->strobe_dllctrl, val);
-		/* wait 5us to make sure strobe dll status register stable */
-		mdelay(5);
-		val = esdhc_read32(&regs->strobe_dllstat);
-		if (!(val & ESDHC_STROBE_DLL_STS_REF_LOCK))
-			pr_warn("HS400 strobe DLL status REF not lock!\n");
-		if (!(val & ESDHC_STROBE_DLL_STS_SLV_LOCK))
-			pr_warn("HS400 strobe DLL status SLV not lock!\n");
+		/* IMX95RM 76.3.10.5 step 11: both locks before any HS400 transfer */
+		ret = read_poll_timeout(esdhc_read32, val,
+					(val & ESDHC_STROBE_DLL_STS_REF_LOCK) &&
+					(val & ESDHC_STROBE_DLL_STS_SLV_LOCK),
+					1, 5000, &regs->strobe_dllstat);
+		if (ret) {
+			printf("HS400 strobe DLL not locked: status 0x%x\n", val);
+			return ret;
+		}
 	}
+
+	return 0;
 }
 
 static int esdhc_set_timing(struct mmc *mmc)
@@ -986,8 +991,11 @@ static int esdhc_set_ios_common(struct fsl_esdhc_priv *priv, struct mmc *mmc)
 	 * target clock rate. So call esdhc_set_strobe_dll() after the
 	 * clock updated.
 	 */
-	if (mmc->selected_mode == MMC_HS_400 || mmc->selected_mode == MMC_HS_400_ES)
-		esdhc_set_strobe_dll(mmc);
+	if (mmc->selected_mode == MMC_HS_400 || mmc->selected_mode == MMC_HS_400_ES) {
+		ret = esdhc_set_strobe_dll(mmc);
+		if (ret)
+			return ret;
+	}
 
 	if (priv->signal_voltage != mmc->signal_voltage) {
 		ret = esdhc_set_voltage(mmc);
-- 
