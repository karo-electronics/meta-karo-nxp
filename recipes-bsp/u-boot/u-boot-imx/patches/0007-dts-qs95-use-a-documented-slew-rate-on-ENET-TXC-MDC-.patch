From c53dbc9b04e9b15b30b0f413475593b1b015ad82 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Fri, 11 Sep 2026 10:28:10 +0200
Subject: [PATCH] dts: qs95: use a documented slew rate on ENET TXC, MDC and
 MDIO

FSEL1 = 00b is a reserved encoding of the pad slew-rate field
(IMX95RM Rev.5, SW_PAD_CTL_PAD_ENET1_TXC, bits 8-7: "00b - Reserved,
01b - Reserved, 10b - Fast Slew Rate, 11b - Fast Slew Rate"). The
QS95/QSBASE95 device tree programmed 0x01e on ENET1_TXC and ENET2_TXC
and 0x006 on ENET1_MDC and ENET1_MDIO, which selects that reserved
value on the two 125 MHz RGMII transmit clocks and on the MDIO bus.
The pads reset to FSEL1 = 10b, so the device tree was actively
degrading a correct power-on setting.

The RGMII timings of the data sheet are only specified for
"CTL[5:0] = 001111 and SL[1:0] = 11" (IMX95IEC Rev.8, 4.11.4.1).
Program FSEL1 = 11b and leave the other fields untouched: drive
strength stays X4 on the TX clocks and X2 on MDC/MDIO, no pull is
added. The NXP EVKs use 0x58e / 0x50e / 0x90e (X3, open drain on
MDIO); those differences are out of scope of this change.

  ENET1_TXC, ENET2_TXC : 0x01e -> 0x19e
  ENET1_MDC, ENET1_MDIO: 0x006 -> 0x186

Upstream-Status: Pending
---
 arch/arm/dts/imx95-qs95-5610-qsbase95.dts | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/arch/arm/dts/imx95-qs95-5610-qsbase95.dts b/arch/arm/dts/imx95-qs95-5610-qsbase95.dts
index fe47d1649df..a14601a0bd5 100644
--- a/arch/arm/dts/imx95-qs95-5610-qsbase95.dts
+++ b/arch/arm/dts/imx95-qs95-5610-qsbase95.dts
@@ -101,8 +101,9 @@
 &scmi_iomuxc {
 	pinctrl_emdio: emdiogrp {
 		fsl,pins = <
-			IMX95_PAD_ENET1_MDC__NETCMIX_TOP_NETC_MDC		0x006
-			IMX95_PAD_ENET1_MDIO__NETCMIX_TOP_NETC_MDIO		0x006
+			/* FSEL1=11b: IMX95RM SW_PAD_CTL bits 8-7, IMX95IEC 4.11.4.1 */
+			IMX95_PAD_ENET1_MDC__NETCMIX_TOP_NETC_MDC		0x186
+			IMX95_PAD_ENET1_MDIO__NETCMIX_TOP_NETC_MDIO		0x186
 		>;
 	};
 
@@ -127,7 +128,8 @@
 			IMX95_PAD_ENET1_TD1__NETCMIX_TOP_ETH0_RGMII_TD1		0x51e
 			IMX95_PAD_ENET1_TD0__NETCMIX_TOP_ETH0_RGMII_TD0		0x51e
 			IMX95_PAD_ENET1_TX_CTL__NETCMIX_TOP_ETH0_RGMII_TX_CTL	0x51e
-			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x01e
+			/* FSEL1=11b: IMX95RM SW_PAD_CTL bits 8-7, IMX95IEC 4.11.4.1 */
+			IMX95_PAD_ENET1_TXC__NETCMIX_TOP_ETH0_RGMII_TX_CLK	0x19e
 			IMX95_PAD_ENET1_RX_CTL__NETCMIX_TOP_ETH0_RGMII_RX_CTL	0x300
 			IMX95_PAD_ENET1_RXC__NETCMIX_TOP_ETH0_RGMII_RX_CLK	0x500
 			IMX95_PAD_ENET1_RD0__NETCMIX_TOP_ETH0_RGMII_RD0		0x500
@@ -144,7 +146,8 @@
 			IMX95_PAD_ENET2_TD1__NETCMIX_TOP_ETH1_RGMII_TD1		0x51e
 			IMX95_PAD_ENET2_TD0__NETCMIX_TOP_ETH1_RGMII_TD0		0x51e
 			IMX95_PAD_ENET2_TX_CTL__NETCMIX_TOP_ETH1_RGMII_TX_CTL	0x51e
-			IMX95_PAD_ENET2_TXC__NETCMIX_TOP_ETH1_RGMII_TX_CLK	0x01e
+			/* FSEL1=11b: IMX95RM SW_PAD_CTL bits 8-7, IMX95IEC 4.11.4.1 */
+			IMX95_PAD_ENET2_TXC__NETCMIX_TOP_ETH1_RGMII_TX_CLK	0x19e
 			IMX95_PAD_ENET2_RX_CTL__NETCMIX_TOP_ETH1_RGMII_RX_CTL	0x300
 			IMX95_PAD_ENET2_RXC__NETCMIX_TOP_ETH1_RGMII_RX_CLK	0x300
 			IMX95_PAD_ENET2_RD0__NETCMIX_TOP_ETH1_RGMII_RD0		0x500
-- 
2.43.0

