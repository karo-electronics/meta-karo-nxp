From 31c27608462e88471ea8d82a634f3efa1b889599 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 14:51:14 +0200
Subject: [PATCH] dts: qs95: disable USB park mode in HS, ERR052487

- IMX95_P21N ERR052487 p.47, ERR051670 p.51: host may lock up
- Mirrors the Linux tree, U-Boot dwc3 ignores the property

Upstream-Status: Pending
---
 arch/arm/dts/imx95-qs95-5610.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm/dts/imx95-qs95-5610.dts b/arch/arm/dts/imx95-qs95-5610.dts
index 8daf4faac6a..dbf44890714 100644
--- a/arch/arm/dts/imx95-qs95-5610.dts
+++ b/arch/arm/dts/imx95-qs95-5610.dts
@@ -387,6 +387,8 @@
 	usb-role-switch;
 	snps,dis-u1-entry-quirk;
 	snps,dis-u2-entry-quirk;
+	/* ERR052487, ERR051670: park mode off in HS too */
+	snps,parkmode-disable-hs-quirk;
 	status = "okay";
 };
 
-- 
2.43.0

