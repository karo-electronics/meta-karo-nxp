From 518e25f76bbd82d41f659cd8cc1c599c2135787c Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 14:34:43 +0200
Subject: [PATCH] dts: qs95: 256 MiB CMA for a 2 GiB module

- Mirrors the Linux tree, U-Boot does not use CMA
- 960 MiB came from the 16 GiB imx95-19x19-evk
- NXP uses 256 MiB on its 2 GiB i.MX93 boards

Upstream-Status: Pending
---
 arch/arm/dts/imx95-qs95-5610.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm/dts/imx95-qs95-5610.dts b/arch/arm/dts/imx95-qs95-5610.dts
index 8095918556e..61c2aea1a68 100644
--- a/arch/arm/dts/imx95-qs95-5610.dts
+++ b/arch/arm/dts/imx95-qs95-5610.dts
@@ -75,7 +75,8 @@
 			compatible = "shared-dma-pool";
 			alloc-ranges = <0 0x80000000 0 0x7f000000>;
 			reusable;
-			size = <0 0x3c000000>;
+			/* 256 MiB like NXP imx93-11x11-evk.dts (2 GiB); raise it in your overlay */
+			size = <0 0x10000000>;
 			linux,cma-default;
 		};
 
-- 
2.43.0

