append_bootargs=quiet
autoload=no
baseboard=mb7
boot_mode=nand
bootargs_nfs=run default_bootargs; setenv bootargs ${bootargs} root=/dev/nfs nfsroot=${nfs_server}:${nfsroot},nolock,v3 ip=dhcp ${append_bootargs}
bootargs_ubifs=run default_bootargs; setenv bootargs ${bootargs} ubi.mtd=rootfs root=ubi0:rootfs rootfstype=ubifs ${append_bootargs}
bootcmd=run bootcmd_${boot_mode} bootm_cmd
bootcmd_nand=setenv autostart no; run bootargs_ubifs; nboot linux
bootcmd_nfs=setenv autostart no; run bootargs_nfs; nboot linux
bootm_cmd=bootm ${loadaddr} - ${fdt_addr}
console=ttymxc0,115200
default_bootargs=setenv bootargs console=${console} panic=-1 ro
fdt_addr=0x13000000
fdt_file=imx6dl-tx6s-8034-mb7.dtb
fdtsave=fdt resize; nand erase.part dtb; nand write ${fdt_addr} dtb ${fdt_size}
loadaddr=0x12000000
loadfdt_nand=nand read ${fdt_addr} dtb
mmcdev=0
mmcpart=1
otg_mode=peripheral
touchpanel=edt-ft5x06
