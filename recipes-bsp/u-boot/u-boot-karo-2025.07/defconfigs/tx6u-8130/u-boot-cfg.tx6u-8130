CONFIG_ENV_SIZE=0x20000
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_IS_IN_NAND=y
CONFIG_DEFAULT_DEVICE_TREE="imx6dl-tx6u-8030"
CONFIG_SYS_PROMPT="TX6U U-Boot > "
CONFIG_MTDIDS_DEFAULT="nand0=gpmi-nand"
CONFIG_MTDPARTS_DEFAULT="mtdparts=gpmi-nand:4m(nandboot),384k@0x400000(env),12m@0x460000(linux),40m@0x1060000(rootfs),72320k@0x3860000(userfs),512k@0x7f00000(dtb),512k@0x7f80000(bbt)ro"
CONFIG_OF_LIST="imx6dl-tx6u-8030 imx6dl-tx6u-8030-mb7"
CONFIG_ENV_RANGE=0x60000
CONFIG_DEFAULT_ENV_FILE="board/$(VENDOR)/$(BOARD)/tx6u-8130-mb7.env"
CONFIG_MX6DL=y
CONFIG_KARO_TX6U_8130=y
