# CONFIG_WATCHDOG_AUTOSTART is not set
CONFIG_IMX_WATCHDOG=y
CONFIG_TEXT_BASE=0x87800000
CONFIG_VIDEO_MXS=y
CONFIG_VIDEO_BMP_GZIP=y
