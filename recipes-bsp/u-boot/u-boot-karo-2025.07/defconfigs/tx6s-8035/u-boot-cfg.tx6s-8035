CONFIG_ENV_SIZE=0x1000
CONFIG_ENV_OFFSET=0x1ff000
CONFIG_ENV_IS_IN_MMC=y
CONFIG_DEFAULT_DEVICE_TREE="imx6dl-tx6s-8035"
CONFIG_SYS_PROMPT="TX6S U-Boot > "
CONFIG_OF_LIST="imx6dl-tx6s-8035 imx6dl-tx6s-8035-mb7"
CONFIG_DEFAULT_ENV_FILE="board/$(VENDOR)/$(BOARD)/tx6s-8035-mb7.env"
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_SYS_MMC_ENV_PART=1
CONFIG_MX6S=y
CONFIG_KARO_TX6S_8035=y
