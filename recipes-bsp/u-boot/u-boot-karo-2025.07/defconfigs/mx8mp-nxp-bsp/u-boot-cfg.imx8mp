CONFIG_IMX_CONFIG="board/$(VENDOR)/$(BOARD)/imximage-imx8mp.cfg"
CONFIG_SPL_STACK=0x96f800
CONFIG_SPL_SYS_MALLOC_F_LEN=0x10000
CONFIG_SPL_TEXT_BASE=0x920000
CONFIG_SPL_BSS_START_ADDR=0x95f800
CONFIG_SPL_SIZE_LIMIT=0x2c000
CONFIG_SPL_SIZE_LIMIT_PROVIDE_STACK=0x2000
CONFIG_ARMV8_SPL_EXCEPTION_VECTORS=y
CONFIG_SPL_IMX_ROMAPI_LOADADDR=0x48000000
CONFIG_SPL_MAX_SIZE=0x2c400
CONFIG_SPL_SYS_REPORT_STACK_F_USAGE=y
CONFIG_SPL_BOOTROM_SUPPORT=y
CONFIG_SPL_CLK_IMX8MP=y
CONFIG_CLK_IMX8MP=y
CONFIG_MISC=y
# CONFIG_SPL_MISC is not set
CONFIG_PHY_SMSC=y
CONFIG_DWC_ETH_QOS=y
CONFIG_DWC_ETH_QOS_IMX=y
CONFIG_PHY=y
CONFIG_PHY_IMX8MQ_USB=y
CONFIG_POWER_DOMAIN=y
CONFIG_IMX8M_POWER_DOMAIN=y
CONFIG_IMX8MP_HSIOMIX_BLKCTRL=y
CONFIG_IMX8MP_MEDIAMIX_BLKCTRL=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_DWC3=y
CONFIG_USB_XHCI_DWC3_OF_SIMPLE=y
CONFIG_USB_EHCI_HCD=y
# CONFIG_USB_EHCI_MX7 is not set
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GENERIC=y
