CONFIG_SPL_SYS_MALLOC_F_LEN=0xa000
CONFIG_BOOTDELAY=1
# CONFIG_SPL_BANNER_PRINT is not set
CONFIG_HUSH_PARSER=y
CONFIG_CMD_BMP=y
CONFIG_VIDEO=y
