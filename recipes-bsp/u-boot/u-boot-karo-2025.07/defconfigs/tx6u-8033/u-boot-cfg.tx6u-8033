CONFIG_ENV_SIZE=0x1000
CONFIG_ENV_OFFSET=0x1ff000
CONFIG_ENV_IS_IN_MMC=y
CONFIG_DEFAULT_DEVICE_TREE="imx6dl-tx6u-8033"
CONFIG_SYS_PROMPT="TX6U U-Boot > "
CONFIG_OF_LIST="imx6dl-tx6u-8033 imx6dl-tx6u-8033-mb7"
CONFIG_DEFAULT_ENV_FILE="board/$(VENDOR)/$(BOARD)/tx6u-8033-mb7.env"
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_SYS_MMC_ENV_PART=1
CONFIG_MX6DL=y
CONFIG_KARO_TX6U_8033=y
