CONFIG_NR_DRAM_BANKS=1
CONFIG_IMX_CONFIG="board/$(VENDOR)/$(BOARD)/imximage-imx8mn.cfg"
CONFIG_SPL_MMC=y
CONFIG_SPL_STACK=0x952800
CONFIG_SPL_SYS_MALLOC_F_LEN=0xd000
CONFIG_SPL_TEXT_BASE=0x912000
CONFIG_SPL_BSS_START_ADDR=0x952800
CONFIG_SPL_SIZE_LIMIT=0x2e000
CONFIG_SPL_SIZE_LIMIT_PROVIDE_STACK=0x2000
CONFIG_SPL_IMX_ROMAPI_LOADADDR=0x48000000
CONFIG_SPL_MAX_SIZE=0x2c000
CONFIG_SPL_SYS_REPORT_STACK_F_USAGE=y
CONFIG_SPL_BOOTROM_SUPPORT=y
CONFIG_SPL_CLK_IMX8MN=y
CONFIG_CLK_IMX8MN=y
CONFIG_PHY_SMSC=y
CONFIG_FEC_MXC=y
CONFIG_USB_EHCI_HCD=y
CONFIG_CI_UDC=y
