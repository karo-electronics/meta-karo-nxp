From cac6a02a908054a9223df5839c0452bbacf1efa9 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Mon, 14 Sep 2026 15:24:08 +0200
Subject: [PATCH] boards: krimx95: read back and guard the PMIC rails at boot

- SW1-SW5, LDO1, LDO2 and both PF53 read once in BRD_SM_InitComplete
- Windows from IMX95IEC Table 22 p.25-27, Micron z42m p.1
- One log line per rail, boot refused if a rail is out
- Independent of the PF09 OTP variant: reads the live setting

Upstream-Status: Inappropriate [board-specific]
---
 boards/krimx95/sm/brd_sm.c         |  8 ++-
 boards/krimx95/sm/brd_sm_voltage.c | 82 ++++++++++++++++++++++++++++++
 boards/krimx95/sm/brd_sm_voltage.h |  7 +++
 3 files changed, 96 insertions(+), 1 deletion(-)

diff --git a/boards/krimx95/sm/brd_sm.c b/boards/krimx95/sm/brd_sm.c
index 4f5d88a..9070da7 100755
--- a/boards/krimx95/sm/brd_sm.c
+++ b/boards/krimx95/sm/brd_sm.c
@@ -725,8 +725,14 @@ static int32_t BRD_SM_InitComplete(uint32_t mSel)
        enabled a power domain, configure a clock SSC, clock rate, or pin.
        Not safe to call LMM functions! */
 
+    /* Rails read back once, IMX95IEC Table 22 windows, refuse out-of-window */
+    status = BRD_SM_VoltageGuard();
+
     /* Init clock override */
-    status = BRD_SM_ClockInit();
+    if (status == SM_ERR_SUCCESS)
+    {
+        status = BRD_SM_ClockInit();
+    }
 
     /* Supplies sit at their boot levels now; safe to arm the monitors */
     if (status == SM_ERR_SUCCESS)
diff --git a/boards/krimx95/sm/brd_sm_voltage.c b/boards/krimx95/sm/brd_sm_voltage.c
index 7291e3c..8d705f0 100755
--- a/boards/krimx95/sm/brd_sm_voltage.c
+++ b/boards/krimx95/sm/brd_sm_voltage.c
@@ -767,3 +767,85 @@ uint32_t BRD_SM_ArmVoltModeGet(void)
     return s_modeArm;
 }
 
+/*--------------------------------------------------------------------------*/
+/* Rail windows: IMX95IEC Table 22 p.25-27, Micron z42m p.1 for VDD2      */
+/*--------------------------------------------------------------------------*/
+static const struct
+{
+    uint32_t domainId;
+    const char *name;
+    int32_t minUv;
+    int32_t maxUv;
+} s_railWindow[] =
+{
+    /* VDD_SOC/VDD_ARM: all Table 22 setpoints, 0.61 V to 0.955 V */
+    {DEV_SM_VOLT_SOC,          "vdd_soc",      610000,  955000},
+    {DEV_SM_VOLT_ARM,          "vdd_arm",      610000,  955000},
+    /* NVCC 3.3 V mode: 3.0 V to 3.45 V */
+    {BRD_SM_VOLT_VDD_GPIO_3P3, "vdd_gpio_3p3", 3000000, 3450000},
+    /* VDD_ANA_0P8: 0.795 V to 0.88 V */
+    {BRD_SM_VOLT_VDD_ANA_0P8,  "vdd_ana_0p8",  795000,  880000},
+    /* VDD_ANA_1P8: 1.71 V to 1.89 V */
+    {BRD_SM_VOLT_VDD_GPIO_1P8, "vdd_gpio_1p8", 1710000, 1890000},
+    /* VDDQ_DDR LPDDR4X: 0.57 V to 0.65 V */
+    {BRD_SM_VOLT_VDDQ_DDR,     "vddq_ddr",     570000,  650000},
+    /* Micron VDD2: 1.06 V to 1.17 V */
+    {BRD_SM_VOLT_VDD2_DDR,     "vdd2_ddr",     1060000, 1170000},
+    /* LDO1 feeds NVCC_ENET and the PHYs: 3.3 V mode */
+    {BRD_SM_VOLT_SD_CARD,      "vdd_sd2_3v3",  3000000, 3450000},
+    /* NVCC_SD2 is 1.8 V or 3.3 V by VSELECT */
+    {BRD_SM_VOLT_NVCC_SD2,     "nvcc_sd2",     1650000, 3450000},
+};
+
+/* OTP ID char: first letter A-Z, second 0-9 then A-Z (Tables 9-10) */
+static inline int BRD_SM_OtpIdChar(uint8_t code, char first)
+{
+    int c = (int) code;
+
+    if ((first == '0') && (c >= 10))
+    {
+        c = 'A' + (c - 10);
+    }
+    else
+    {
+        c = first + c;
+    }
+
+    return c;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Read every PMIC rail once, log it, refuse a rail out of its window    */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageGuard(void)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint32_t num = (uint32_t) (sizeof(s_railWindow) / sizeof(s_railWindow[0]));
+    uint8_t *id = NULL;
+    uint8_t idLen = 0U;
+
+    /* PF09 OTP ID: PROG_ID1/2 registers 0x03/0x04, data sheet Tables 9-10 */
+    if (PF09_PmicInfoGet(&g_pf09Dev, &id, &idLen) && (idLen >= 5U))
+    {
+        printf("  - PF09 dev 0x%02X rev 0x%02X OTP ID %c%c\n", id[0], id[2],
+            BRD_SM_OtpIdChar(id[3] & 0x1FU, 'A'), BRD_SM_OtpIdChar(id[4] & 0x3FU, '0'));
+    }
+
+    for (uint32_t i = 0U; i < num; i++)
+    {
+        int32_t uV = 0;
+        int32_t rc = BRD_SM_VoltageLevelGet(s_railWindow[i].domainId, &uV);
+        bool ok = (rc == SM_ERR_SUCCESS) && (uV >= s_railWindow[i].minUv)
+            && (uV <= s_railWindow[i].maxUv);
+
+        printf("  - %s: %d uV%s\n", s_railWindow[i].name, (int) uV,
+            ok ? "" : " OUT OF WINDOW");
+
+        if (!ok)
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+    }
+
+    return status;
+}
diff --git a/boards/krimx95/sm/brd_sm_voltage.h b/boards/krimx95/sm/brd_sm_voltage.h
index b74f923..f688059 100755
--- a/boards/krimx95/sm/brd_sm_voltage.h
+++ b/boards/krimx95/sm/brd_sm_voltage.h
@@ -191,6 +191,13 @@ int32_t BRD_SM_VoltageLevelSet(uint32_t domainId, int32_t voltageLevel);
  */
 int32_t BRD_SM_VoltageLevelGet(uint32_t domainId, int32_t *voltageLevel);
 
+/*!
+ * Read every PMIC rail once, log it, refuse a rail out of its window.
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_VoltageGuard(void);
+
 /*!
  * Suspend voltage modes/levels.
  *
-- 
