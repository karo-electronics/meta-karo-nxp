From 569abd91f715a65e7481d9ebe106038a1b884575 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Fri, 11 Sep 2026 19:41:39 +0200
Subject: [PATCH] configs: krimx95: SM console on LPUART1, LPUART2 given to the
 A55

QS95 data sheet p.10: pads 91/92 are UART_RXD_B/UART_TXD_B, a customer
UART (LPUART2). The SM debug console moves to LPUART1, shared with the
A55 console; LPUART2 and its two pins go to the A55 LM.

Upstream-Status: Inappropriate [board-specific]
---
 configs/krimx95.cfg            | 9 +++++----
 configs/krimx95/config_board.h | 2 +-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/configs/krimx95.cfg b/configs/krimx95.cfg
index 34f28f5..47020e9 100644
--- a/configs/krimx95.cfg
+++ b/configs/krimx95.cfg
@@ -41,7 +41,7 @@ include ../devices/MIMX95/configtool/device.cfg
 # Board                                                                    #
 #==========================================================================#
 
-BOARD               DEBUG_UART_INSTANCE=2
+BOARD               DEBUG_UART_INSTANCE=1
 BOARD               DEBUG_UART_BAUDRATE=115200
 
 BOARD               I2C_INSTANCE=1
@@ -243,7 +243,7 @@ IOMUXC              OWNER
 IOMUX_GPR           OWNER
 JTAG                OWNER
 LPI2C1              OWNER
-LPUART2             OWNER
+LPUART1             ACCESS
 M33_CACHE_CTRL      OWNER
 M33_PCF             OWNER
 M33_PSF             OWNER
@@ -317,8 +317,6 @@ PIN_FCCU_ERR0         OWNER
 PIN_I2C1_SCL          OWNER
 PIN_I2C1_SDA          OWNER
 PIN_PDM_BIT_STREAM1   OWNER
-PIN_UART2_RXD         OWNER
-PIN_UART2_TXD         OWNER
 PIN_WDOG_ANY          OWNER
 PIN_GPIO_IO34         OWNER
 
@@ -781,6 +779,7 @@ LPTPM4              OWNER
 LPTPM5              OWNER
 LPTPM6              OWNER
 LPUART1             OWNER
+LPUART2             OWNER
 LPUART3             OWNER
 LPUART4             OWNER
 LPUART5             OWNER
@@ -996,6 +995,8 @@ PIN_SD3_DATA2        OWNER
 PIN_SD3_DATA3        OWNER
 PIN_UART1_RXD        OWNER, test
 PIN_UART1_TXD        OWNER
+PIN_UART2_RXD        OWNER
+PIN_UART2_TXD        OWNER
 PIN_XSPI1_DATA0      OWNER
 PIN_XSPI1_DATA1      OWNER
 PIN_XSPI1_DATA2      OWNER
diff --git a/configs/krimx95/config_board.h b/configs/krimx95/config_board.h
index c9d5687..e89cfad 100755
--- a/configs/krimx95/config_board.h
+++ b/configs/krimx95/config_board.h
@@ -54,7 +54,7 @@
 /* Defines */
 
 /*! Config for UART instance */
-#define BOARD_DEBUG_UART_INSTANCE    2U
+#define BOARD_DEBUG_UART_INSTANCE    1U
 /*! Config for UART baudrate */
 #define BOARD_DEBUG_UART_BAUDRATE    115200U
 
-- 
2.43.0

