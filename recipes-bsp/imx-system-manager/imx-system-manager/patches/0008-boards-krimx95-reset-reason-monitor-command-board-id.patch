From 2f0ee9960310ab47da21ea344a20f54332fee843 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Thu, 10 Sep 2026 12:54:28 +0200
Subject: [PATCH] boards: krimx95: reset reason, monitor command, board
 identity

- SFAULT_FLG in shutdown record
- PF53 boot flags in extInfo
- conditional valid avoids overwrite
- monitor pmic console command
- BRD_SM_NAME QS95-5610
- M7 boot[0]=0 (no image)

Upstream-Status: Inappropriate [board-specific]
---
 boards/krimx95/sm/brd_sm.c | 50 +++++++++++++++++++++++++++++++++++---
 boards/krimx95/sm/brd_sm.h |  3 ++-
 2 files changed, 48 insertions(+), 5 deletions(-)

diff --git a/boards/krimx95/sm/brd_sm.c b/boards/krimx95/sm/brd_sm.c
index 998f701..4f5d88a 100755
--- a/boards/krimx95/sm/brd_sm.c
+++ b/boards/krimx95/sm/brd_sm.c
@@ -254,7 +254,36 @@ void BRD_SM_TimerTick(uint32_t msec)
 /*--------------------------------------------------------------------------*/
 int32_t BRD_SM_Custom(int32_t argc, const char * const argv[])
 {
-    return SM_ERR_SUCCESS;
+    int32_t status = SM_ERR_SUCCESS;
+
+#ifdef MONITOR
+    /* Same journal as the SCMI control, readable without an agent */
+    if ((argc > 0) && (strcmp(argv[0], "pmic") == 0))
+    {
+        printf("pf09: cnt=%u ioErr=%u ewarn=%u poll=%u vmon=%u\n",
+            g_pf09Fault.cnt, g_pf09Fault.ioErr, (uint32_t) g_pf09Fault.ewarn,
+            (uint32_t) g_intbPolling, g_vmonFaultCnt);
+
+        for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+        {
+            printf(" %02X", (uint32_t) g_pf09Fault.last[idx]);
+        }
+        printf("\n");
+
+        for (uint32_t idx = 0U; idx < 2U; idx++)
+        {
+            printf("pf53%u: cnt=%u ioErr=%u last=%02X%02X\n", idx + 1U,
+                g_pf53Fault[idx].cnt, g_pf53Fault[idx].ioErr,
+                (uint32_t) g_pf53Fault[idx].last[0],
+                (uint32_t) g_pf53Fault[idx].last[1]);
+        }
+
+        printf("boot: 0x%08X 0x%08X\n", g_pmicFaultFlags, g_pf53BootFlags);
+    }
+#endif
+
+    /* Return status */
+    return status;
 }
 
 /*--------------------------------------------------------------------------*/
@@ -415,9 +444,9 @@ void BRD_SM_ShutdownRecordLoad(dev_sm_rst_rec_t *shutdownRec)
     }
 #endif
 
-    /* PMIC reset? */
-    if ((g_pmicFaultFlags & (PF09_XFAIL_FLG | PF09_WD_FLG
-        | PF09_HFAULT_FLG)) != 0U)
+    /* Only PMIC-caused stops; a valid record already names the true cause */
+    if (((g_pmicFaultFlags & (PF09_XFAIL_FLG | PF09_WD_FLG | PF09_HFAULT_FLG
+        | PF09_SFAULT_FLG)) != 0U) && !shutdownRec->valid)
     {
         shutdownRec->valid = true;
         shutdownRec->reset = true;
@@ -427,6 +456,13 @@ void BRD_SM_ShutdownRecordLoad(dev_sm_rst_rec_t *shutdownRec)
         shutdownRec->extLen = 1U;
         shutdownRec->extInfo[0] = g_pmicFaultFlags;
     }
+
+    /* PF53 latches read at init; a wdog or sw stop deserves them just as much */
+    if (shutdownRec->extLen < DEV_SM_NUM_EXT_INFO)
+    {
+        shutdownRec->extInfo[shutdownRec->extLen] = g_pf53BootFlags;
+        shutdownRec->extLen++;
+    }
 }
 
 /*--------------------------------------------------------------------------*/
@@ -692,6 +728,12 @@ static int32_t BRD_SM_InitComplete(uint32_t mSel)
     /* Init clock override */
     status = BRD_SM_ClockInit();
 
+    /* Supplies sit at their boot levels now; safe to arm the monitors */
+    if (status == SM_ERR_SUCCESS)
+    {
+        status = BRD_SM_VmonInit();
+    }
+
     /* Return status */
     return status;
 }
diff --git a/boards/krimx95/sm/brd_sm.h b/boards/krimx95/sm/brd_sm.h
index feba6ae..44b73c6 100755
--- a/boards/krimx95/sm/brd_sm.h
+++ b/boards/krimx95/sm/brd_sm.h
@@ -61,7 +61,8 @@
 /* Defines */
 
 /*! Board name string */
-#define BRD_SM_NAME  "i.MX95 EVK"
+/* MISC_BOARD_INFO must identify the module, not the reference design */
+#define BRD_SM_NAME  "QS95-5610"
 
 /*! Board attributes */
 #define BRD_SM_ATTR  0x0
-- 
2.43.0

