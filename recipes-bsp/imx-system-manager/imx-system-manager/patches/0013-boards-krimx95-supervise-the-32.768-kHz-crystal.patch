From 403c00856c8e07bebf5a9e2aa05ac9d95acd518c Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Tue, 15 Sep 2026 16:58:04 +0200
Subject: [PATCH] boards: krimx95: supervise the 32.768 kHz crystal

BLK_CTRL_BBSMMIX snvs_clkrst_ctrl (0x4441_0004) bit 15 xtal_ok reads
"XTAL clock is in frequency range and is source of 32 kHz clock",
bits 14/13 flag a slow or fast crystal (IMX95RM Rev.5, 183.2.1.2,
p.11241). The SXOSC "manages the 32 kHz Ring Oscillator (ROSC) and
external crystal oscillator input" (IMX95RM 182.1, p.11238) and the
integrated oscillator "is not suitable for long-term timekeeping"
(IMX95RM 17.5.2, p.366); the ROSC accuracy is documented nowhere,
the SRM Rev.2 draft included. UG10210 Rev.2.0 4.3 (p.56) asks to
"ensure that all the clock sources are running as expected" and 4.4
wants the 32.768 kHz clock active before POR_B is released.

Nothing reads xtal_ok today, not the SM, not U-Boot, not Linux: a
dead or mis-loaded Q1 (Epson MC-146, 7 pF) leaves the RTC, the WDOG
lpo_clk and the LPTMRs on the ring oscillator without any trace. The
TRDC keeps the register M33-only (A55 reads end in a Bus error under
Linux and a Synchronous Abort in U-Boot), so only the SM can do it.

Check once 3 s after boot, past the crystal start-up, then once an
hour from the board tick. On loss set the sticky syslog bit
BIT32(16), served by SCMI MISC_SYSLOG (Linux imx-sm-misc.c,
SCMI_IMX_MISC_SYSLOG_GET), and print the register; print again on
recovery.

Upstream-Status: Pending
---
 boards/krimx95/sm/brd_sm.c | 42 ++++++++++++++++++++++++++++++++++++++
 boards/krimx95/sm/brd_sm.h |  7 +++++++
 2 files changed, 49 insertions(+)

diff --git a/boards/krimx95/sm/brd_sm.c b/boards/krimx95/sm/brd_sm.c
index 9070da7..abdab29 100755
--- a/boards/krimx95/sm/brd_sm.c
+++ b/boards/krimx95/sm/brd_sm.c
@@ -121,9 +121,14 @@
 
 /* Local variables */
 
+static uint32_t s_xtalElapsedMs = 0U;
+static uint32_t s_xtalPeriodMs = BRD_SM_XTAL_GRACE_MS;
+static bool s_xtalLost = false;
+
 /* Local functions */
 
 static int32_t BRD_SM_InitComplete(uint32_t mSel);
+static void BRD_SM_XtalTick(uint32_t msec);
 
 /*--------------------------------------------------------------------------*/
 /* Init board                                                               */
@@ -242,6 +247,8 @@ void BRD_SM_TimerTick(uint32_t msec)
     /* Kick the dog */
     BOARD_WdogRefresh();
 
+    BRD_SM_XtalTick(msec);
+
     /* Ties with IRQ56, but thread code holding the LPI2C would be cut in two */
     if (!g_pmicBusy)
     {
@@ -249,6 +256,41 @@ void BRD_SM_TimerTick(uint32_t msec)
     }
 }
 
+/*--------------------------------------------------------------------------*/
+/* Supervise the 32.768 kHz crystal                                         */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_XtalTick(uint32_t msec)
+{
+    s_xtalElapsedMs += msec;
+
+    if (s_xtalElapsedMs >= s_xtalPeriodMs)
+    {
+        /* xtal_ok, tst_xtal_slow, tst_xtal_fast: IMX95RM 183.2.1.2 */
+        uint32_t ctrl = BLK_CTRL_BBSMMIX_BBSMMIX1->SNVS_CLKRST_CTRL;
+        bool lost = ((ctrl & BLK_CTRL_BBSMMIX_SNVS_CLKRST_CTRL_XTAL_OK_MASK)
+            == 0U);
+
+        s_xtalElapsedMs = 0U;
+        s_xtalPeriodMs = BRD_SM_XTAL_PERIOD_MS;
+
+        if (lost != s_xtalLost)
+        {
+            s_xtalLost = lost;
+
+            if (lost)
+            {
+                /* Sticky syslog bit, RTC now on the ring oscillator */
+                DEV_SM_ErrorLog(BRD_SM_ERR_XTAL32K);
+                printf("32K XTAL lost, clkrst 0x%08X\n", ctrl);
+            }
+            else
+            {
+                printf("32K XTAL back\n");
+            }
+        }
+    }
+}
+
 /*--------------------------------------------------------------------------*/
 /* Custom monitor function                                                  */
 /*--------------------------------------------------------------------------*/
diff --git a/boards/krimx95/sm/brd_sm.h b/boards/krimx95/sm/brd_sm.h
index 44b73c6..18928ad 100755
--- a/boards/krimx95/sm/brd_sm.h
+++ b/boards/krimx95/sm/brd_sm.h
@@ -67,6 +67,13 @@
 /*! Board attributes */
 #define BRD_SM_ATTR  0x0
 
+/*! 32.768 kHz crystal start-up grace and check period, ms */
+#define BRD_SM_XTAL_GRACE_MS   3000U
+#define BRD_SM_XTAL_PERIOD_MS  3600000U
+
+/*! Syslog bit: 32K crystal dropped, RTC on ROSC, IMX95RM 182.1 */
+#define BRD_SM_ERR_XTAL32K  BIT32(16U)
+
 /*! Perf voltage drop */
 #define BOARD_PERF_VDROP  20000
 
