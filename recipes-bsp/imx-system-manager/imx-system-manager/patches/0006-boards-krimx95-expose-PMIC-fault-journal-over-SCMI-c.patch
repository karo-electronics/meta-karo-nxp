+#ifndef BRD_SM_CONTROL_H
+#define BRD_SM_CONTROL_H
+
+/*==========================================================================*/
+/*!
+ * @addtogroup BRD_SM_MX95EVK
+ * @{
+ *
+ * @file
+ * @brief
+ *
+ * Header file containing the SM API for the board controls.
+ */
+/*==========================================================================*/
+
+/* Includes */
+
+#include "sm.h"
+#include "dev_sm.h"
+
+/* Defines */
+
+/* Set to 0 to reclaim the slot bytes if the image ever grows past 179200 */
+#ifndef BOARD_PMIC_CTRL
+/*! Expose the PMIC fault journal over SCMI */
+#define BOARD_PMIC_CTRL  1
+#endif
+
+/*! Number of board controls */
+#define BRD_SM_NUM_CTRL  1UL
+
+/*! Total number of controls */
+#define SM_NUM_CTRL  (DEV_SM_NUM_CTRL + BRD_SM_NUM_CTRL)
+
+/*!
+ * @name BRD_SM control domain indexes
+ */
+/** @{ */
+/* Id kept in both images so config_scmi.h compiles either way */
+#define BRD_SM_CTRL_PMIC_FAULT  (DEV_SM_NUM_CTRL + 0U)
+/** @} */
+
+/*! Words returned by a read of ::BRD_SM_CTRL_PMIC_FAULT */
+#define BRD_SM_PMIC_FAULT_LEN  10U
+
+/*!
+ * @name PMIC fault control status word (word 7)
+ *
+ * Bits 31:16 hold the MON1/MON2 fault count.
+ */
+/** @{ */
+#define BRD_SM_PMIC_STAT_POLLING  0x1U  /*!< INTB stuck, PF09 polled */
+#define BRD_SM_PMIC_STAT_EWARN    0x2U  /*!< PF09 shutdown under way */
+/** @} */
+
+#if BOARD_PMIC_CTRL
+
+/*!
+ * @name Board redirection defines
+ * @{
+ */
+#define SM_CONTROLSET          BRD_SM_ControlSet          /*!< Control set */
+#define SM_CONTROLGET          BRD_SM_ControlGet          /*!< Control get */
+#define SM_CONTROLEXTSET       BRD_SM_ControlExtSet       /*!< Ext set */
+#define SM_CONTROLEXTGET       BRD_SM_ControlExtGet       /*!< Ext get */
+#define SM_CONTROLACTION       BRD_SM_ControlAction       /*!< Ctrl action */
+#define SM_CONTROLFLAGSSET     BRD_SM_ControlFlagsSet     /*!< Ctrl flags */
+/** @} */
+
+/* Types */
+
+/* Functions */
+
+/*!
+ * @name Board control functions
+ * @{
+ */
+
+/*!
+ * Set a board control value.
+ *
+ * Writing a single zero to ::BRD_SM_CTRL_PMIC_FAULT clears the fault
+ * journals. Any other value is refused.
+ *
+ * @param[in]     ctrlId   Index of control to write
+ * @param[in]     numVal   Number of array elements
+ * @param[in]     val      Pointer to array of values to set
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlSet(uint32_t ctrlId, uint32_t numVal,
+    const uint32_t *val);
+
+/*!
+ * Get a board control value.
+ *
+ * ::BRD_SM_CTRL_PMIC_FAULT returns ::BRD_SM_PMIC_FAULT_LEN words.
+ *
+ * @param[in]     ctrlId   Index of control to read
+ * @param[out]    numRtn   Return pointer to number of array elements
+ * @param[out]    rtn      Pointer to array to store return
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlGet(uint32_t ctrlId, uint32_t *numRtn, uint32_t *rtn);
+
+/*!
+ * Set an extended board control value.
+ *
+ * @param[in]     ctrlId   Index of control to write
+ * @param[in]     addr     Address of write
+ * @param[in]     numVal   Number of array elements
+ * @param[in]     val      Pointer to array of values to set
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlExtSet(uint32_t ctrlId, uint32_t addr,
+    uint32_t numVal, const uint32_t *val);
+
+/*!
+ * Get an extended board control value.
+ *
+ * @param[in]     ctrlId   Index of control to read
+ * @param[in]     addr     Address of read
+ * @param[in]     numRtn   Number of array elements
+ * @param[out]    rtn      Pointer to array to store return
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlExtGet(uint32_t ctrlId, uint32_t addr,
+    uint32_t numRtn, uint32_t *rtn);
+
+/*!
+ * Perform action on a board control.
+ *
+ * @param[in]     ctrlId   Index of control to take action
+ * @param[in]     action   Action to take
+ * @param[in]     numArg   Number of argument array elements
+ * @param[in]     arg      Pointer to array of argument values
+ * @param[out]    numRtn   Return pointer to number of array elements
+ * @param[out]    rtn      Pointer to array to store return
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlAction(uint32_t ctrlId, uint32_t action,
+    uint32_t numArg, const uint32_t *arg, uint32_t *numRtn, uint32_t *rtn);
+
+/*!
+ * Configure notification flags for a control.
+ *
+ * @param[in]     ctrlId   Index of control to configure
+ * @param[in]     flags    Notification flags
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_ControlFlagsSet(uint32_t ctrlId, uint32_t flags);
+
+/** @} */
+
+#endif /* BOARD_PMIC_CTRL */
+
+/* Moved to brd_sm_voltage.h when VMON lands */
+extern uint32_t g_vmonFaultCnt;
+
+#endif /* BRD_SM_CONTROL_H */
+
+/** @} */
diff --git a/boards/krimx95/sm/brd_sm_handlers.c b/boards/krimx95/sm/brd_sm_handlers.c
index 3d18be3..41c9669 100755
--- a/boards/krimx95/sm/brd_sm_handlers.c
+++ b/boards/krimx95/sm/brd_sm_handlers.c
@@ -630,8 +630,14 @@ void BRD_SM_IntbTick(void)
 /*--------------------------------------------------------------------------*/
 void BRD_SM_PmicFaultNotify(uint32_t flags)
 {
-    /* Detect and record now; the SCMI delivery to the agent lands in a later patch */
+#if BOARD_PMIC_CTRL
+    /* Queued, not sent, so calling from the INTB and tick ISRs is safe */
+    LMM_MiscControlEvent(BRD_SM_CTRL_PMIC_FAULT,
+        flags | BRD_SM_PMIC_FLAG_ANY);
+#else
+    /* The SM detects and records; the reporting path belongs to the agent */
     (void) flags;
+#endif
 }
 
