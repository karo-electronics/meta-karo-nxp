From c4545f6b20b6b8ae35161fe5a2c4549e2e68e723 Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Wed, 9 Sep 2026 16:43:41 +0200
Subject: [PATCH] boards: krimx95: record PMIC faults and supervise the PF53

- PF09 journal: count, last latches, EWARN
- HFAULT and IO_INT captured at boot
- PF53 latches captured at boot, FAULT_CNT
- PF53 service each second, W1C, PGOOD window
- rail-off skip on VDD_ARM off
- GPO4_STBY explicit
- notify flags PF09, PF53, EWARN

Upstream-Status: Inappropriate [board-specific]
---
 boards/krimx95/sm/brd_sm_handlers.c | 231 +++++++++++++++++++++++++++-
 boards/krimx95/sm/brd_sm_handlers.h |  54 ++++++-
 boards/krimx95/sm/brd_sm_voltage.c  |   8 +
 3 files changed, 289 insertions(+), 4 deletions(-)

diff --git a/boards/krimx95/sm/brd_sm_handlers.c b/boards/krimx95/sm/brd_sm_handlers.c
index 1175dad..3d18be3 100755
--- a/boards/krimx95/sm/brd_sm_handlers.c
+++ b/boards/krimx95/sm/brd_sm_handlers.c
@@ -67,6 +67,20 @@
 /* A released line goes back to interrupt mode; check once a second */
 #define BOARD_INTB_REARM_TICKS      100U
 
+/* PF53 latches are W1C; one second bounds ISR load without losing faults */
+#define BOARD_PF53_POLL_TICKS       100U
+
+/* PF53 INT_STATUS1: SDWN BG_ERR CRC DVS_DONE ILIM VMON_UV VMON_OV VIN_OVLO */
+#define BOARD_PF53_ST1_FAULTS       0xEFU
+/* PF53 Tab.106: THERM_110/125/140 and FSYNC swing both ways, not faults */
+#define BOARD_PF53_ST2_FAULTS       0xE8U
+
+/* PF53 12.5: PGOOD_STUCK_AT_0 needs 100ms low; a poll can land before, so skip two */
+#define BOARD_PF53_PGOOD_IGN_POLLS  2U
+
+/* PF09 12.7 Tab.58: EWARN_I, the one interrupt with no mask and no latch */
+#define BOARD_PF09_SYS_EWARN        0x80U
+
 /* Local types */
 
 /* Local variables */
@@ -75,6 +89,13 @@ static uint32_t s_intbSpurious = 0U;
 static uint32_t s_intbIoErr = 0U;
 static uint32_t s_intbWindow = 0U;
 static uint32_t s_intbTicks = 0U;
+static uint32_t s_pf53Ticks = 0U;
+static uint8_t s_pf53PgoodIgn[2] =
+    { BOARD_PF53_PGOOD_IGN_POLLS, BOARD_PF53_PGOOD_IGN_POLLS };
+
+/* An unpowered PF53 answers nothing; reads would only count I2C errors */
+static bool s_pf53RailOff[2] = { false, false };
+
 /* PF09 12.7: a masked latch never asserts INTB, so nothing may clear it here */
 static const uint8_t s_pf09Unmasked[PF09_MASK_LEN] =
 {
@@ -102,9 +123,15 @@ PF53_Type g_pf5302Dev;
 uint32_t g_pmicFaultFlags = 0U;
 bool g_intbPolling = false;
 volatile bool g_pmicBusy = false;
+brd_sm_pf09_fault_t g_pf09Fault = { 0U, 0U, { 0U }, false };
+brd_sm_pf53_fault_t g_pf53Fault[2] = { { 0U, 0U, { 0U, 0U } },
+    { 0U, 0U, { 0U, 0U } } };
+uint32_t g_pf53BootFlags = 0U;
 
 /* Local functions */
 
+static void BRD_SM_Pf53BootCapture(const PF53_Type *dev, uint32_t shift);
+
 /*--------------------------------------------------------------------------*/
 /* Init serial devices                                                      */
 /*--------------------------------------------------------------------------*/
@@ -210,6 +237,20 @@ int32_t BRD_SM_SerialDevicesInit(void)
             }
         }
 
+        /* PF09 0x3A bit7: OTP leaves GPO4_STBY clear, make VDD_ARM standby explicit */
+        if (status == SM_ERR_SUCCESS)
+        {
+            bool ctrl = true;
+
+            if (!PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF09_STATE_VSTBY,
+                false)
+                || !PF09_GpioCtrlGet(&g_pf09Dev, PF09_GPIO4, PF09_STATE_VSTBY,
+                &ctrl) || ctrl)
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
         /* Set the OV debounce to 50us due to errata ER011/12
            for rev B0 */
         if (g_pf09Dev.id[PF09_REG_REV_ID] == PF09_REV_B0)
@@ -233,6 +274,23 @@ int32_t BRD_SM_SerialDevicesInit(void)
             }
         }
 
+        /* PF09 0x2E: stale hard fault flags persist and would pollute the next capture */
+        if ((status == SM_ERR_SUCCESS)
+            && ((g_pmicFaultFlags & PF09_HFAULT_FLG) == 0U))
+        {
+            uint8_t hFlags = 0U;
+
+            if (PF09_PmicRead(&g_pf09Dev, PF09_REG_HFAULT_FLAGS, &hFlags)
+                && (hFlags != 0U))
+            {
+                /* Same layout as the driver: hard fault flags in bits 8-15 */
+                g_pmicFaultFlags |= ((uint32_t) hFlags) << 8U;
+
+                (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_HFAULT_FLAGS,
+                    hFlags, 0xFFU);
+            }
+        }
+
         /* Handle any already pending PF09 interrupts */
         if (status == SM_ERR_SUCCESS)
         {
@@ -256,6 +314,10 @@ int32_t BRD_SM_SerialDevicesInit(void)
                         0xFFU);
                 }
             }
+            else
+            {
+                g_pf09Fault.ioErr++;
+            }
         }
 
         /* PWRUP_I is masked from here on, so no later service would clear it */
@@ -277,6 +339,10 @@ int32_t BRD_SM_SerialDevicesInit(void)
         {
             status = SM_ERR_HARDWARE_ERROR;
         }
+        else
+        {
+            BRD_SM_Pf53BootCapture(&g_pf5301Dev, 16U);
+        }
     }
 
     if (status == SM_ERR_SUCCESS)
@@ -290,6 +356,10 @@ int32_t BRD_SM_SerialDevicesInit(void)
         {
             status = SM_ERR_HARDWARE_ERROR;
         }
+        else
+        {
+            BRD_SM_Pf53BootCapture(&g_pf5302Dev, 0U);
+        }
     }
 
     /* Configure the PF09 INTB interrupt */
@@ -342,6 +412,27 @@ void BRD_SM_IntbConfig(void)
     }
 }
 
+/*--------------------------------------------------------------------------*/
+/* Capture the boot latches of one PF53 into g_pf53BootFlags                 */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_Pf53BootCapture(const PF53_Type *dev, uint32_t shift)
+{
+    uint8_t val = 0U;
+
+    /* PF53 Tab.102: the tick clears these latches, the post-mortem needs them */
+    if (PF53_PmicRead(dev, PF53_REG_INT_STATUS1, &val))
+    {
+        g_pf53BootFlags |= ((uint32_t) val) << (shift + 8U);
+    }
+
+    /* PF53 Tab.144: FAULT_CNT bits 7:4 count the faults of the previous power cycle */
+    if (PF53_PmicRead(dev, PF53_REG_FLT_CNT1, &val))
+    {
+        /* FLT_CNT_CLR sits in 0x1A, beyond the driver range; VIN POR clears anyway */
+        g_pf53BootFlags |= ((uint32_t) (val >> 4U)) << (shift + 4U);
+    }
+}
+
 /*--------------------------------------------------------------------------*/
 /* GPIO5 output 1 handler                                                   */
 /*--------------------------------------------------------------------------*/
@@ -390,11 +481,96 @@ void Reserved72_IRQHandler(void)
     RGPIO_ClearPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1, flags);
 }
 
+/*--------------------------------------------------------------------------*/
+/* Read and clear the fault latches of one PF53                             */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_Pf53Service(const PF53_Type *dev, uint32_t idx)
+{
+    uint8_t st[PF53_MASK_LEN] = { 0U, 0U };
+
+    /* A failed PF09 init leaves the handles empty, and the tick runs anyway */
+    if ((dev != NULL) && (dev->i2cBase != NULL) && !s_pf53RailOff[idx])
+    {
+        if (PF53_IntStatus(dev, st))
+        {
+            uint8_t f1 = st[0] & BOARD_PF53_ST1_FAULTS;
+            uint8_t f2 = st[1] & BOARD_PF53_ST2_FAULTS;
+
+            /* The latch appears one poll or more after PWRON, so hold the window open */
+            if (s_pf53PgoodIgn[idx] != 0U)
+            {
+                s_pf53PgoodIgn[idx]--;
+                f2 &= (uint8_t) ~0x80U;
+            }
+
+            if ((f1 | f2) != 0U)
+            {
+                g_pf53Fault[idx].cnt++;
+
+                /* One report per new signature, not one per tick */
+                if ((f1 != g_pf53Fault[idx].last[0])
+                    || (f2 != g_pf53Fault[idx].last[1]))
+                {
+                    g_pf53Fault[idx].last[0] = f1;
+                    g_pf53Fault[idx].last[1] = f2;
+                    BRD_SM_PmicFaultNotify((idx == 0U)
+                        ? BRD_SM_PMIC_FLAG_PF5301 : BRD_SM_PMIC_FLAG_PF5302);
+                }
+            }
+
+            /* PF53 Tab.102/106: W1C, and a partial mask makes the driver read first */
+            if (st[0] != 0U)
+            {
+                (void) PF53_PmicWrite(dev, PF53_REG_INT_STATUS1, st[0], 0xFFU);
+            }
+            if (st[1] != 0U)
+            {
+                (void) PF53_PmicWrite(dev, PF53_REG_INT_STATUS2, st[1], 0xFFU);
+            }
+        }
+        else
+        {
+            g_pf53Fault[idx].ioErr++;
+        }
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Ignore the PGOOD_STUCK latch of a PF53 for a while                       */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_Pf53PgoodIgnore(uint32_t idx)
+{
+    /* PGOOD_STUCK latches on every PWRON sequence, not only on the first */
+    if (idx < 2U)
+    {
+        s_pf53PgoodIgn[idx] = BOARD_PF53_PGOOD_IGN_POLLS;
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Suspend or resume the polling of one PF53                                */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_Pf53RailOff(uint32_t idx, bool off)
+{
+    if (idx < 2U)
+    {
+        s_pf53RailOff[idx] = off;
+    }
+}
+
 /*--------------------------------------------------------------------------*/
 /* INTB tick: age the spurious count, poll and re-arm when stuck            */
 /*--------------------------------------------------------------------------*/
 void BRD_SM_IntbTick(void)
 {
+    /* Both PF53 once a second; a rail off answers nothing and is skipped */
+    s_pf53Ticks++;
+    if ((s_pf53Ticks % BOARD_PF53_POLL_TICKS) == 0U)
+    {
+        BRD_SM_Pf53Service(&g_pf5301Dev, 0U);
+        BRD_SM_Pf53Service(&g_pf5302Dev, 1U);
+    }
+
     if (!g_intbPolling)
     {
         /* Age the count so old glitches do not accumulate */
@@ -414,11 +590,18 @@ void BRD_SM_IntbTick(void)
         {
             uint8_t sysInt = 0U;
 
-            if (PF09_PmicRead(&g_pf09Dev, PF09_REG_SYSTEM_INT, &sysInt)
-                && (sysInt != 0U))
+            if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_SYSTEM_INT, &sysInt))
+            {
+                g_pf09Fault.ioErr++;
+            }
+            else if (sysInt != 0U)
             {
                 (void) BRD_SM_Pf09Handler();
             }
+            else
+            {
+                /* Line still low with nothing latched; keep polling */
+            }
         }
 
         /* Line high again: clear stale flag and re-arm the interrupt */
@@ -462,11 +645,13 @@ brd_sm_pf09_status_t BRD_SM_Pf09Handler(void)
     /* Read status of interrupts */
     if (!PF09_IntStatus(&g_pf09Dev, stat, PF09_MASK_LEN))
     {
+        g_pf09Fault.ioErr++;
         rc = BRD_SM_PF09_INT_IOERR;
     }
     else
     {
         bool pending = false;
+        bool changed = false;
         bool therm;
         uint8_t thermStat;
 
@@ -477,10 +662,27 @@ brd_sm_pf09_status_t BRD_SM_Pf09Handler(void)
             {
                 pending = true;
             }
+            if (stat[idx] != g_pf09Fault.last[idx])
+            {
+                changed = true;
+            }
         }
 
+        /* Service maintenance needs the rail identity, kept before any write */
         if (pending)
         {
+            g_pf09Fault.cnt++;
+
+            for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+            {
+                g_pf09Fault.last[idx] = stat[idx];
+            }
+
+            if (changed)
+            {
+                BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_PF09);
+            }
+
             rc = BRD_SM_PF09_INT_CAUSE;
         }
 
@@ -516,6 +718,31 @@ brd_sm_pf09_status_t BRD_SM_Pf09Handler(void)
         {
             BRD_SM_SensorHandler();
         }
+
+        /* PF09 12.7 Tab.58: EWARN has no latch, so no group can report it */
+        if (!pending)
+        {
+            uint8_t sysInt = 0U;
+
+            if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_SYSTEM_INT, &sysInt))
+            {
+                g_pf09Fault.ioErr++;
+                rc = BRD_SM_PF09_INT_IOERR;
+            }
+            else if ((sysInt & BOARD_PF09_SYS_EWARN) != 0U)
+            {
+                /* The rails are going away; polling would only starve the M33 */
+                g_pf09Fault.ewarn = true;
+                NVIC_DisableIRQ(Reserved72_IRQn);
+                g_intbPolling = false;
+                rc = BRD_SM_PF09_INT_CAUSE;
+                BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_EWARN);
+            }
+            else
+            {
+                /* No cause at all; the caller ages the spurious count */
+            }
+        }
     }
 
     /* Return status */
diff --git a/boards/krimx95/sm/brd_sm_handlers.h b/boards/krimx95/sm/brd_sm_handlers.h
index 81e36ea..29116bc 100755
--- a/boards/krimx95/sm/brd_sm_handlers.h
+++ b/boards/krimx95/sm/brd_sm_handlers.h
@@ -63,6 +63,10 @@
 /** @{ */
 /* An agent subscribes with a flag mask, so one bit must be in every report */
 #define BRD_SM_PMIC_FLAG_ANY            0x01U  /*!< Set on every report */
+#define BRD_SM_PMIC_FLAG_PF09           0x02U  /*!< PF09 latch memorized */
+#define BRD_SM_PMIC_FLAG_PF5301         0x04U  /*!< PF5301 latch memorized */
+#define BRD_SM_PMIC_FLAG_PF5302         0x08U  /*!< PF5302 latch memorized */
+#define BRD_SM_PMIC_FLAG_EWARN          0x10U  /*!< PF09 shutdown under way */
 #define BRD_SM_PMIC_FLAG_INTB_STUCK     0x20U  /*!< INTB stuck, now polling */
 #define BRD_SM_PMIC_FLAG_INTB_RESTORED  0x40U  /*!< INTB released, IRQ re-armed */
 /** @} */
@@ -75,11 +79,28 @@
 /*! Outcome of one PF09 service */
 typedef enum
 {
-    BRD_SM_PF09_INT_CAUSE, /*!< A latch explained the interrupt */
+    BRD_SM_PF09_INT_CAUSE, /*!< A status register explained the interrupt */
     BRD_SM_PF09_INT_EMPTY, /*!< Read succeeded, no cause found */
     BRD_SM_PF09_INT_IOERR  /*!< I2C failed, absence of a cause is not proven */
 } brd_sm_pf09_status_t;
 
+/*! PF09 fault journal */
+typedef struct
+{
+    uint32_t cnt;                 /*!< Services that found a latch */
+    uint32_t ioErr;               /*!< I2C failures while servicing */
+    uint8_t last[PF09_MASK_LEN];  /*!< Raw latches of the last fault */
+    bool ewarn;                   /*!< EWARN_I seen, shutdown under way */
+} brd_sm_pf09_fault_t;
+
+/*! PF53 fault journal */
+typedef struct
+{
+    uint32_t cnt;                 /*!< Services that found a latch */
+    uint32_t ioErr;               /*!< I2C failures while servicing */
+    uint8_t last[PF53_MASK_LEN];  /*!< Last INT_STATUS1/2 faults kept */
+} brd_sm_pf53_fault_t;
+
 /* External variables */
 
 /*! Handle to access PF09 */
@@ -100,6 +121,15 @@ extern bool g_intbPolling;
 /*! True while thread code owns the PMIC bus; the tick then skips its service */
 extern volatile bool g_pmicBusy;
 
+/*! PF09 fault journal since boot */
+extern brd_sm_pf09_fault_t g_pf09Fault;
+
+/*! PF5301 / PF5302 fault journals since boot */
+extern brd_sm_pf53_fault_t g_pf53Fault[2];
+
+/*! PF53 latches captured at boot, before the first tick cleared them */
+extern uint32_t g_pf53BootFlags;
+
 /* Functions */
 
 /*!
@@ -136,12 +166,32 @@ void BRD_SM_IntbTick(void);
  */
 brd_sm_pf09_status_t BRD_SM_Pf09Handler(void);
 
+/*!
+ * Ignore the PGOOD_STUCK latch of a PF53 for a while.
+ *
+ * PGOOD_STUCK_AT_0 needs PGOOD low for more than 100ms, so the exemption
+ * lasts several polls rather than a single one.
+ *
+ * @param[in]     idx      PF53 index (0 = PF5301, 1 = PF5302).
+ */
+void BRD_SM_Pf53PgoodIgnore(uint32_t idx);
+
+/*!
+ * Suspend or resume the polling of one PF53.
+ *
+ * An unpowered PF53 cannot answer; polling it would only count I2C errors.
+ *
+ * @param[in]     idx      PF53 index (0 = PF5301, 1 = PF5302).
+ * @param[in]     off      True while the rail is off.
+ */
+void BRD_SM_Pf53RailOff(uint32_t idx, bool off);
+
 /*!
  * Report a memorized PMIC fault.
  *
  * Called from interrupt context. The default implementation does nothing.
  *
- * @param[in]     flags    Bitmap of ::BRD_SM_PMIC_FLAG_INTB_STUCK and friends.
+ * @param[in]     flags    Bitmap of ::BRD_SM_PMIC_FLAG_PF09 and friends.
  */
 void BRD_SM_PmicFaultNotify(uint32_t flags);
 
diff --git a/boards/krimx95/sm/brd_sm_voltage.c b/boards/krimx95/sm/brd_sm_voltage.c
index 430cb46..f8054bb 100755
--- a/boards/krimx95/sm/brd_sm_voltage.c
+++ b/boards/krimx95/sm/brd_sm_voltage.c
@@ -186,6 +186,14 @@ int32_t BRD_SM_VoltageModeSet(uint32_t domainId, uint8_t voltMode)
                 mode);
             break;
         case DEV_SM_VOLT_ARM:
+            /* An unpowered PF5301 answers nothing; polling it only counts I2C errors */
+            BRD_SM_Pf53RailOff(0U, !enable);
+
+            /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
+            if (enable)
+            {
+                BRD_SM_Pf53PgoodIgnore(0U);
+            }
             rc = PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
                 enable);
             if (enable && rc)
-- 
2.43.0

