+** ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
+** (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;
+** LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON
+** ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+** (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS
+** SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+**
+**
+** ###################################################################
+*/
+
+/*==========================================================================*/
+/* File containing the implementation of the handlers for the board.        */
+/*==========================================================================*/
+
+/* Includes */
+
+#include "sm.h"
+#include "brd_sm.h"
+#include "dev_sm.h"
+#include "lmm.h"
+#include "fsl_lpi2c.h"
+#include "fsl_rgpio.h"
+
+/* Local defines */
+
+/* I2C device addresses */
+#define BOARD_PF09_DEV_ADDR         0x08U
+#define BOARD_PF5301_DEV_ADDR       0x2AU
+#define BOARD_PF5302_DEV_ADDR       0x29U
+
+/* PF09 INTB (pin 41) on GPIO_IO34 = GPIO5.IO[14], WAKEUPMIX */
+#define BOARD_INTB_PIN              14U
+
+/* Level IRQ with no PMIC latch means a stuck line; stop before the M33 starves */
+#define BOARD_INTB_SPURIOUS_MAX     64U
+
+/* Isolated glitches over a lifetime must not trip the guard; count inside 100ms */
+#define BOARD_INTB_SPURIOUS_WINDOW  10U
+
+/* PF09 12.7: SYSTEM_INT sums all groups, one byte read per tick keeps alarms alive */
+#define BOARD_INTB_POLL_TICKS       1U
+
+/* PF53 latches are W1C; one second bounds ISR load without losing faults */
+#define BOARD_PF53_POLL_TICKS       100U
+
+/* PF53 INT_STATUS1: SDWN BG_ERR CRC DVS_DONE ILIM VMON_UV VMON_OV VIN_OVLO */
+#define BOARD_PF53_ST1_FAULTS       0xEFU
+/* PF53 Tab.106: THERM_110/125/140 and FSYNC swing both ways, not faults */
+#define BOARD_PF53_ST2_FAULTS       0xE8U
+
+/* PF53 12.5: PGOOD_STUCK_AT_0 needs 100ms low; a poll can land before, so skip two */
+#define BOARD_PF53_PGOOD_IGN_POLLS  2U
+
+/* PF09 12.7 Tab.58: EWARN_I, the one interrupt with no mask and no latch */
+#define BOARD_PF09_SYS_EWARN        0x80U
+
+/* Local types */
+
+/* Local variables */
+
+/* Shared between the INTB ISR (prio 14) and the tick (prio 0): volatile */
+static volatile uint32_t s_intbSpurious = 0U;
+static volatile uint32_t s_intbIoErr = 0U;
+static volatile uint32_t s_intbWindow = 0U;
+static volatile uint32_t s_intbTicks = 0U;
+static volatile uint32_t s_pf53Ticks = 0U;
+static volatile uint8_t s_pf53PgoodIgn[2] =
+    { BOARD_PF53_PGOOD_IGN_POLLS, BOARD_PF53_PGOOD_IGN_POLLS };
+
+/* An unpowered PF53 answers nothing; reads would only count I2C errors */
+static volatile bool s_pf53RailOff[2] = { false, false };
+
+/* ISR -> tick: PF09 service deferred to prio 0 */
+static volatile bool s_intbPending = false;
+/* Mirrors the NVIC enable state of Reserved72_IRQn */
+static volatile bool s_intbIrqEn = true;
+/* EWARN seen: the line stays low on purpose, do not poll or re-arm */
+static volatile bool s_intbEwarn = false;
+
+/* PF09 12.7: a masked latch never asserts INTB, so nothing may clear it here */
+static const uint8_t s_pf09Unmasked[PF09_MASK_LEN] =
+{
+    [PF09_MASK_IDX_STATUS1] = 0x31U,
+    /* THERM is unmasked at runtime, so its bits are added by the service */
+    [PF09_MASK_IDX_STATUS2] = 0xF0U,
+    [PF09_MASK_IDX_STATUS3] = 0x04U,
+    [PF09_MASK_IDX_SW_ILIM] = 0x9FU,
+    [PF09_MASK_IDX_LDO_ILIM] = 0x07U,
+    /* Bits 7:6 are MON1/MON2, unmasked by BRD_SM_VmonInit when VMON is built */
+    [PF09_MASK_IDX_SW_UV] = 0xDFU,
+    [PF09_MASK_IDX_SW_OV] = 0xDFU,
+    [PF09_MASK_IDX_LDO_UV] = 0x0BU,
+    [PF09_MASK_IDX_LDO_OV] = 0x0BU,
+    /* PF09 Tab.60: ERRMON, FCCU1, FCCU0; RSTB/FS0B/PGOOD_FLT carry no action */
+    [PF09_MASK_IDX_IO] = 0x38U
+};
+
+/* Global variables */
+
+PF09_Type g_pf09Dev;
+PF53_Type g_pf5301Dev;
+PF53_Type g_pf5302Dev;
+
+uint32_t g_pmicFaultFlags = 0U;
+volatile bool g_intbPolling = false;
+volatile bool g_pmicBusy = false;
+brd_sm_pf09_fault_t g_pf09Fault = { 0U, 0U, { 0U }, false };
+brd_sm_pf53_fault_t g_pf53Fault[2] = { { 0U, 0U, { 0U, 0U } },
+    { 0U, 0U, { 0U, 0U } } };
+uint32_t g_pf53BootFlags = 0U;
+
+/* Local functions */
+
+static void BRD_SM_Pf53BootCapture(const PF53_Type *dev, uint32_t shift);
+
+/*--------------------------------------------------------------------------*/
+/* Init serial devices                                                      */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_SerialDevicesInit(void)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    LPI2C_Type *const s_i2cBases[] = LPI2C_BASE_PTRS;
+
+    if (status == SM_ERR_SUCCESS)
+    {
+        /* Fill in PF09 PMIC handle */
+        g_pf09Dev.i2cBase = s_i2cBases[BOARD_I2C_INSTANCE];
+        g_pf09Dev.devAddr = BOARD_PF09_DEV_ADDR;
+        g_pf09Dev.crcEn = true;
+
+        /* Initialize PF09 PMIC */
+        if (!PF09_Init(&g_pf09Dev))
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+
+        /* VMON1/2 stay off until the boot levels are applied (BRD_SM_VmonInit) */
+        if (status == SM_ERR_SUCCESS)
+        {
+            if (!PF09_MonitorEnable(&g_pf09Dev, PF09_VMON1, false)
+                || !PF09_MonitorEnable(&g_pf09Dev, PF09_VMON2, false))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* Disable the PWRUP interrupt */
+        if (status == SM_ERR_SUCCESS)
+        {
+            const uint8_t mask[PF09_MASK_LEN] =
+            {
+                [PF09_MASK_IDX_STATUS1] = 0x08U
+            };
+
+            if (!PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, false))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* PF09 12.7: only PWRUP is unmasked at reset; faults need explicit unmask */
+        if (status == SM_ERR_SUCCESS)
+        {
+            const uint8_t mask[PF09_MASK_LEN] =
+            {
+                /* STATUS1: VIN_OV, I2C_CRC, DCRC; SDWN stays masked, clearing it aborts shutdown */
+                [PF09_MASK_IDX_STATUS1] = 0x31U,
+                /* STATUS2: VANA_OV, VDIG_OV, BGMON, CLKMON; THERM set by PF09_TempAlarmSet */
+                [PF09_MASK_IDX_STATUS2] = 0xF0U,
+                /* STATUS3: BAD_CMD only; WD unused, LBIST/SHS carry no action */
+                [PF09_MASK_IDX_STATUS3] = 0x04U,
+                /* SW_ILIM: SW1LS OCP plus SW1-5 current limits */
+                [PF09_MASK_IDX_SW_ILIM] = 0x9FU,
+                [PF09_MASK_IDX_LDO_ILIM] = 0x07U,
+                /* SW_UV/OV: SW1-5 here; MON1/2 are unmasked by BRD_SM_VmonInit */
+                [PF09_MASK_IDX_SW_UV] = 0x1FU,
+                [PF09_MASK_IDX_SW_OV] = 0x1FU,
+                /* LDO_UV/OV: LDO1, LDO2, VAON; LDO3 bypasses VDD_SOC and follows DVS */
+                [PF09_MASK_IDX_LDO_UV] = 0x0BU,
+                [PF09_MASK_IDX_LDO_OV] = 0x0BU,
+                /* PF09 Tab.60: ERRMON and FCCU0/1 report SoC faults back to the PMIC */
+                [PF09_MASK_IDX_IO] = 0x38U
+            };
+
+            if (!PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, true))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* Change the LDO3 sequence */
+        if (status == SM_ERR_SUCCESS)
+        {
+            if (!PF09_PmicWrite(&g_pf09Dev, PF09_REG_LDO3_PWRUP,
+                0x1EU, 0xFFU))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* Set the LDO3 OV bypass */
+        if (status == SM_ERR_SUCCESS)
+        {
+            if (!PF09_PmicWrite(&g_pf09Dev, PF09_REG_LDO3_CFG2,
+                0xFCU, 0xFFU))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* Enable the LDO3 in RUN mode */
+        if (status == SM_ERR_SUCCESS)
+        {
+            if (!PF09_PmicWrite(&g_pf09Dev, PF09_REG_LDO3_RUN,
+                0x20U, 0xFFU))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* PF09 0x3A bit7: OTP leaves GPO4_STBY clear, make VDD_ARM standby explicit */
+        if (status == SM_ERR_SUCCESS)
+        {
+            bool ctrl = true;
+
+            if (!PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF09_STATE_VSTBY,
+                false)
+                || !PF09_GpioCtrlGet(&g_pf09Dev, PF09_GPIO4, PF09_STATE_VSTBY,
+                &ctrl) || ctrl)
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* Set the OV debounce to 50us due to errata ER011/12
+           for rev B0 */
+        if (g_pf09Dev.id[PF09_REG_REV_ID] == PF09_REV_B0)
+        {
+            if (status == SM_ERR_SUCCESS)
+            {
+                if (!PF09_PmicWrite(&g_pf09Dev, PF09_REG_VMON_CFG1,
+                    0x94U, 0xFFU))
+                {
+                    status = SM_ERR_HARDWARE_ERROR;
+                }
+            }
+        }
+
+        /* Save and clear any fault flags */
+        if (status == SM_ERR_SUCCESS)
+        {
+            if (!PF09_FaultFlags(&g_pf09Dev, &g_pmicFaultFlags, true))
+            {
+                status = SM_ERR_HARDWARE_ERROR;
+            }
+        }
+
+        /* PF09 0x2E: stale hard fault flags persist and would pollute the next capture */
+        if ((status == SM_ERR_SUCCESS)
+            && ((g_pmicFaultFlags & PF09_HFAULT_FLG) == 0U))
+        {
+            uint8_t hFlags = 0U;
+
+            if (PF09_PmicRead(&g_pf09Dev, PF09_REG_HFAULT_FLAGS, &hFlags)
+                && (hFlags != 0U))
+            {
+                /* Same layout as the driver: hard fault flags in bits 8-15 */
+                g_pmicFaultFlags |= ((uint32_t) hFlags) << 8U;
+
+                (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_HFAULT_FLAGS,
+                    hFlags, 0xFFU);
+            }
+        }
+
+        /* Handle any already pending PF09 interrupts */
+        if (status == SM_ERR_SUCCESS)
+        {
+            (void) BRD_SM_Pf09Handler();
+        }
+
+        /* IO_INT was masked until now, so no service ever reported it */
+        if (status == SM_ERR_SUCCESS)
+        {
+            uint8_t ioInt = 0U;
+
+            if (PF09_PmicRead(&g_pf09Dev, PF09_REG_IO_INT, &ioInt))
+            {
+                /* The journal is rewritten by every service, this must outlive it */
+                g_pmicFaultFlags |= ((uint32_t) ioInt) << BRD_SM_PMIC_IO_SHIFT;
+
+                /* PF09 12.7.2: W1C, and a masked IO latch is cleared nowhere else */
+                if (ioInt != 0U)
+                {
+                    (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_IO_INT, ioInt,
+                        0xFFU);
+                }
+            }
+            else
+            {
+                g_pf09Fault.ioErr++;
+            }
+        }
+
+        /* PWRUP_I is masked from here on, so no later service would clear it */
+        if (status == SM_ERR_SUCCESS)
+        {
+            (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_STATUS1_INT, 0x08U,
+                0xFFU);
+        }
+    }
+
+    if (status == SM_ERR_SUCCESS)
+    {
+        /* Fill in PF5301 PMIC handle */
+        g_pf5301Dev.i2cBase = s_i2cBases[BOARD_I2C_INSTANCE];
+        g_pf5301Dev.devAddr = BOARD_PF5301_DEV_ADDR;
+
+        /* Initialize PF5301 PMIC */
+        if (!PF53_Init(&g_pf5301Dev))
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+        else
+        {
+            BRD_SM_Pf53BootCapture(&g_pf5301Dev, 16U);
+        }
+    }
+
+    if (status == SM_ERR_SUCCESS)
+    {
+        /* Fill in PF5302 PMIC handle */
+        g_pf5302Dev.i2cBase = s_i2cBases[BOARD_I2C_INSTANCE];
+        g_pf5302Dev.devAddr = BOARD_PF5302_DEV_ADDR;
+
+        /* Initialize PF5302 PMIC */
+        if (!PF53_Init(&g_pf5302Dev))
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+        else
+        {
+            BRD_SM_Pf53BootCapture(&g_pf5302Dev, 0U);
+        }
+    }
+
+    /* Configure the PF09 INTB interrupt */
+    if (status == SM_ERR_SUCCESS)
+    {
+        BRD_SM_IntbConfig();
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Configure INTB pin and interrupt                                         */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_IntbConfig(void)
+{
+    /* LOCK only clears on reset; nonzero means this ran already */
+    if (GPIO5->LOCK == 0U)
+    {
+        rgpio_pin_config_t gpioConfig =
+        {
+            kRGPIO_DigitalInput,
+            0U
+        };
+
+        /* TF-A imx9_bl31_setup.c sets PCNS/ICNS non-secure for GPIO2-5; keep pin 14 secure */
+        GPIO5->PCNS = ~(1UL << BOARD_INTB_PIN);
+        GPIO5->PCNP = ~(1UL << BOARD_INTB_PIN);
+
+        /* RGPIO ICNS: a secure pin cannot target a non-secure output; own both first */
+        GPIO5->ICNS = 0U;
+        GPIO5->ICNP = 0U;
+
+        /* Output 0 belongs to Linux gpio-vf610; level low so no latch is ever missed */
+        RGPIO_PinInit(GPIO5, BOARD_INTB_PIN, &gpioConfig);
+        RGPIO_SetPinInterruptConfig(GPIO5, BOARD_INTB_PIN,
+            kRGPIO_InterruptOutput1, kRGPIO_InterruptLogicZero);
+
+        /* RGPIO ICR.LK: locked until next system reset; gpio-vf610 probe zeroes all ICR */
+        GPIO5->ICR[BOARD_INTB_PIN] |= RGPIO_ICR_LK_MASK;
+
+        /* Hand output 0 back so Linux GPIO interrupts keep working */
+        GPIO5->ICNS = RGPIO_ICNS_NSE0_MASK;
+        GPIO5->ICNP = RGPIO_ICNP_NPE0_MASK;
+
+        /* RGPIO LOCK: PCNS/ICNS/PCNP/ICNP not writable until next reset */
+        GPIO5->LOCK = RGPIO_LOCK_PCNS_MASK | RGPIO_LOCK_ICNS_MASK
+            | RGPIO_LOCK_PCNP_MASK | RGPIO_LOCK_ICNP_MASK;
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Capture the boot latches of one PF53 into g_pf53BootFlags                 */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_Pf53BootCapture(const PF53_Type *dev, uint32_t shift)
+{
+    uint8_t val = 0U;
+
+    /* PF53 Tab.102: the tick clears these latches, the post-mortem needs them */
+    if (PF53_PmicRead(dev, PF53_REG_INT_STATUS1, &val))
+    {
+        g_pf53BootFlags |= ((uint32_t) val) << (shift + 8U);
+    }
+
+    /* PF53 Tab.144: FAULT_CNT bits 7:4 count the faults of the previous power cycle */
+    if (PF53_PmicRead(dev, PF53_REG_FLT_CNT1, &val))
+    {
+        /* FLT_CNT_CLR sits in 0x1A, beyond the driver range; VIN POR clears anyway */
+        g_pf53BootFlags |= ((uint32_t) (val >> 4U)) << (shift + 4U);
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* GPIO5 output 1 handler                                                   */
+/*--------------------------------------------------------------------------*/
+void Reserved72_IRQHandler(void)
+{
+    uint32_t flags = RGPIO_GetPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1);
+
+    if ((flags & (1UL << BOARD_INTB_PIN)) != 0U)
+    {
+        /* Defer the PMIC service and the notify to the tick: this handler
+           runs at prio 14 and the tick/SWI (prio 0) would preempt it in
+           the middle of an LPI2C transfer or a notify queue update */
+        s_intbPending = true;
+
+        if (RGPIO_PinRead(GPIO5, BOARD_INTB_PIN) == 0U)
+        {
+            /* Level still low: stop the re-entry storm; the tick re-arms
+               the IRQ once the line is released */
+            NVIC_DisableIRQ(Reserved72_IRQn);
+            s_intbIrqEn = false;
+        }
+    }
+
+    /* Re-read so a flag raised while handling is cleared as well (W1C) */
+    RGPIO_ClearPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1,
+        RGPIO_GetPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1));
+}
+
+/*--------------------------------------------------------------------------*/
+/* Read and clear the fault latches of one PF53                             */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_Pf53Service(const PF53_Type *dev, uint32_t idx)
+{
+    uint8_t st[PF53_MASK_LEN] = { 0U, 0U };
+
+    /* A failed PF09 init leaves the handles empty, and the tick runs anyway */
+    if ((dev != NULL) && (dev->i2cBase != NULL) && !s_pf53RailOff[idx])
+    {
+        if (PF53_IntStatus(dev, st))
+        {
+            uint8_t f1 = st[0] & BOARD_PF53_ST1_FAULTS;
+            uint8_t f2 = st[1] & BOARD_PF53_ST2_FAULTS;
+
+            /* The latch appears one poll or more after PWRON, so hold the window open */
+            if (s_pf53PgoodIgn[idx] != 0U)
+            {
+                s_pf53PgoodIgn[idx]--;
+                f2 &= (uint8_t) ~0x80U;
+            }
+
+            if ((f1 | f2) != 0U)
+            {
+                g_pf53Fault[idx].cnt++;
+
+                /* One report per new signature, not one per tick */
+                if ((f1 != g_pf53Fault[idx].last[0])
+                    || (f2 != g_pf53Fault[idx].last[1]))
+                {
+                    g_pf53Fault[idx].last[0] = f1;
+                    g_pf53Fault[idx].last[1] = f2;
+                    BRD_SM_PmicFaultNotify((idx == 0U)
+                        ? BRD_SM_PMIC_FLAG_PF5301 : BRD_SM_PMIC_FLAG_PF5302);
+                }
+            }
+
+            /* PF53 Tab.102/106: W1C, and a partial mask makes the driver read first */
+            if (st[0] != 0U)
+            {
+                (void) PF53_PmicWrite(dev, PF53_REG_INT_STATUS1, st[0], 0xFFU);
+            }
+            if (st[1] != 0U)
+            {
+                (void) PF53_PmicWrite(dev, PF53_REG_INT_STATUS2, st[1], 0xFFU);
+            }
+        }
+        else
+        {
+            g_pf53Fault[idx].ioErr++;
+        }
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Ignore the PGOOD_STUCK latch of a PF53 for a while                       */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_Pf53PgoodIgnore(uint32_t idx)
+{
+    /* PGOOD_STUCK latches on every PWRON sequence, not only on the first */
+    if (idx < 2U)
+    {
+        s_pf53PgoodIgn[idx] = BOARD_PF53_PGOOD_IGN_POLLS;
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Suspend or resume the polling of one PF53                                */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_Pf53RailOff(uint32_t idx, bool off)
+{
+    if (idx < 2U)
+    {
+        s_pf53RailOff[idx] = off;
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* INTB tick: service deferred events, poll and re-arm when stuck           */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_IntbTick(void)
+{
+    /* Both PF53 once a second; a rail off answers nothing and is skipped */
+    s_pf53Ticks++;
+    if ((s_pf53Ticks % BOARD_PF53_POLL_TICKS) == 0U)
+    {
+        BRD_SM_Pf53Service(&g_pf5301Dev, 0U);
+        BRD_SM_Pf53Service(&g_pf5302Dev, 1U);
+    }
+
+    /* Service an INTB event deferred by the ISR; at prio 0 the SWI cannot
+       preempt, so the LPI2C and the notify queue are used single-threaded */
+    if (s_intbPending)
+    {
+        brd_sm_pf09_status_t st;
+
+        s_intbPending = false;
+        st = BRD_SM_Pf09Handler();
+
+        if (st == BRD_SM_PF09_INT_CAUSE)
+        {
+            s_intbSpurious = 0U;
+            s_intbIoErr = 0U;
+        }
+        else if (st == BRD_SM_PF09_INT_EMPTY)
+        {
+            s_intbIoErr = 0U;
+            s_intbSpurious++;
+        }
+        else
+        {
+            /* A bad bus proves no cause, but a level IRQ would re-enter forever */
+            s_intbIoErr++;
+        }
+    }
+
+    if (!s_intbIrqEn && !s_intbEwarn)
+    {
+        if (RGPIO_PinRead(GPIO5, BOARD_INTB_PIN) != 0U)
+        {
+            /* Line released: clear the stale flag and re-arm the interrupt */
+            bool wasPolling = g_intbPolling;
+
+            s_intbSpurious = 0U;
+            s_intbIoErr = 0U;
+            s_intbWindow = 0U;
+            s_intbTicks = 0U;
+            g_intbPolling = false;
+            RGPIO_ClearPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1,
+                1UL << BOARD_INTB_PIN);
+            NVIC_ClearPendingIRQ(Reserved72_IRQn);
+            NVIC_EnableIRQ(Reserved72_IRQn);
+            s_intbIrqEn = true;
+
+            if (wasPolling)
+            {
+                BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_INTB_RESTORED);
+            }
+        }
+        else
+        {
+            /* Line still low with the IRQ off: poll so no alarm is lost */
+            s_intbTicks++;
+
+            /* PF09 12.7: SYSTEM_INT nonzero means an unmasked latch is pending */
+            if ((s_intbTicks % BOARD_INTB_POLL_TICKS) == 0U)
+            {
+                uint8_t sysInt = 0U;
+
+                if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_SYSTEM_INT, &sysInt))
+                {
+                    g_pf09Fault.ioErr++;
+                    s_intbIoErr++;
+                }
+                else if (sysInt != 0U)
+                {
+                    (void) BRD_SM_Pf09Handler();
+                    s_intbSpurious = 0U;
+                    s_intbIoErr = 0U;
+                }
+                else
+                {
+                    /* Line still low with nothing latched; keep polling */
+                    s_intbSpurious++;
+                }
+
+                if (!g_intbPolling
+                    && ((s_intbSpurious >= BOARD_INTB_SPURIOUS_MAX)
+                        || (s_intbIoErr >= BOARD_INTB_SPURIOUS_MAX)))
+                {
+                    /* Line stuck without PMIC cause; keep polling so no
+                       alarm is lost */
+                    g_intbPolling = true;
+                    BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_INTB_STUCK);
+                }
+            }
+        }
+    }
+    else if (!g_intbPolling)
+    {
+        /* Age the count so old glitches do not accumulate */
+        s_intbWindow++;
+        if (s_intbWindow >= BOARD_INTB_SPURIOUS_WINDOW)
+        {
+            s_intbWindow = 0U;
+            s_intbSpurious = 0U;
+        }
+    }
+}
+
+/*==========================================================================*/
+
+/*--------------------------------------------------------------------------*/
+/* Report a memorized PMIC fault                                            */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_PmicFaultNotify(uint32_t flags)
+{
+#if BOARD_PMIC_CTRL
+    /* Called from the tick (prio 0) and thread only, never from the INTB
+       ISR, so the notify queue is not touched from a preemptible context */
+    LMM_MiscControlEvent(BRD_SM_CTRL_PMIC_FAULT,
+        flags | BRD_SM_PMIC_FLAG_ANY);
+#else
+    /* The SM detects and records; the reporting path belongs to the agent */
+    (void) flags;
+#endif
+}
+
+/*--------------------------------------------------------------------------*/
+/* PF09 handler                                                             */
+/*--------------------------------------------------------------------------*/
+brd_sm_pf09_status_t BRD_SM_Pf09Handler(void)
+{
+    brd_sm_pf09_status_t rc = BRD_SM_PF09_INT_EMPTY;
+    uint8_t stat[PF09_MASK_LEN] = { 0 };
+
+    /* Read status of interrupts */
+    if (!PF09_IntStatus(&g_pf09Dev, stat, PF09_MASK_LEN))
+    {
+        g_pf09Fault.ioErr++;
+        rc = BRD_SM_PF09_INT_IOERR;
+    }
+    else
+    {
+        bool pending = false;
+        bool changed = false;
+        bool therm;
+        uint8_t thermStat;
+
+        /* Nonzero status proves the interrupt had a cause */
+        for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+        {
+            if (stat[idx] != 0U)
+            {
+                pending = true;
+            }
+            if (stat[idx] != g_pf09Fault.last[idx])
+            {
+                changed = true;
+            }
+        }
+
+        /* Service maintenance needs the rail identity, kept before any write */
+        if (pending)
+        {
+            g_pf09Fault.cnt++;
+
+            for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+            {
+                g_pf09Fault.last[idx] = stat[idx];
+            }
+
+            if (changed)
+            {
+                BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_PF09);
+            }
+
+            rc = BRD_SM_PF09_INT_CAUSE;
+        }
+
+        thermStat = stat[PF09_MASK_IDX_STATUS2] & 0x0FU;
+        therm = (thermStat != 0U);
+
+        /* MON1/MON2 UV/OV: VDD_SOC or VDD_ARM left its window; record, do not act */
+        if (((stat[PF09_MASK_IDX_SW_UV] | stat[PF09_MASK_IDX_SW_OV])
+            & 0xC0U) != 0U)
+        {
+            g_vmonFaultCnt++;
+        }
+
+        /* PF09 12.4.1.1: clearing a masked latch drops evidence and aborts a shutdown */
+        for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+        {
+            stat[idx] &= s_pf09Unmasked[idx];
+        }
+
+        /* PF09_TempAlarmSet moves the armed THERM bit, and it must still be cleared */
+        if (therm)
+        {
+            uint8_t tMask;
+
+            /* A failed read clears them all: losing evidence beats a stuck INTB */
+            if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_STATUS2_MASK, &tMask))
+            {
+                tMask = 0x00U;
+            }
+
+            stat[PF09_MASK_IDX_STATUS2] |=
+                (uint8_t) (thermStat & (uint8_t) (~tMask));
+        }
+
+        /* Clear pending */
+        (void) PF09_IntClear(&g_pf09Dev, stat, PF09_MASK_LEN);
+
+        /* Handle pending temp interrupts */
+        if (therm)
+        {
+            BRD_SM_SensorHandler();
+        }
+
+        /* PF09 12.7 Tab.58: EWARN has no latch, so no group can report it */
+        if (!pending)
+        {
+            uint8_t sysInt = 0U;
+
+            if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_SYSTEM_INT, &sysInt))
+            {
+                g_pf09Fault.ioErr++;
+                rc = BRD_SM_PF09_INT_IOERR;
+            }
+            else if ((sysInt & BOARD_PF09_SYS_EWARN) != 0U)
+            {
+                /* The rails are going away; polling would only starve the M33 */
+                g_pf09Fault.ewarn = true;
+                NVIC_DisableIRQ(Reserved72_IRQn);
+                s_intbIrqEn = false;
+                s_intbEwarn = true;
+                g_intbPolling = false;
+                rc = BRD_SM_PF09_INT_CAUSE;
+                BRD_SM_PmicFaultNotify(BRD_SM_PMIC_FLAG_EWARN);
+            }
+            else
+            {
+                /* No cause at all; the caller ages the spurious count */
+            }
+        }
+    }
+
+    /* Return status */
+    return rc;
+}
