+/*==========================================================================*/
+/* File containing the implementation of the board voltages.                */
+/*==========================================================================*/
+
+/* Includes */
+
+#include "sm.h"
+#include "brd_sm.h"
+
+/* Local defines */
+
+/* Local types */
+
+/* Local variables */
+
+static int32_t s_levelSoc = BOARD_VOLT_SOC;
+static int32_t s_levelArm = BOARD_VOLT_ARM;
+static uint32_t s_modeArm = DEV_SM_VOLT_MODE_ON;
+static uint32_t s_modeArmSave = DEV_SM_VOLT_MODE_ON;
+
+/* PF09 VMON1/2 never compare on this OTP program (tested 0.5-1.275V, 0.80V real); keep off */
+#ifndef BOARD_PF09_VMON
+#define BOARD_PF09_VMON         0
+#endif
+
+/* PF09 13.3.3.1: VMON reference range and 25mV step */
+#define BOARD_VMON_MIN_UV       500000U
+#define BOARD_VMON_MAX_UV       1275000U
+#define BOARD_VMON_STEP_UV      25000U
+
+/* PF09 Table 172: 1000us covers a 225mV ramp at 1mV/us plus I2C */
+#define BOARD_VMON_TMASK        0x01U
+
+/* VMONx_CTRL: TMASK[5:4], OVTH_STBY[3], UVTH_STBY[2], SOFTRST_EN[1], PG_EN[0] */
+#define BOARD_VMON_CTRL_TMASK_SHIFT 4U
+#define BOARD_VMON_CTRL_PG_EN       0x01U
+
+/* Reference last written to each VMON; zero means monitor off */
+static uint32_t s_vmonRefSoc = 0U;
+static uint32_t s_vmonRefArm = 0U;
+
+/* Faults seen by the MON handlers, readable for diagnostics */
+uint32_t g_vmonFaultCnt = 0U;
+
+/*--------------------------------------------------------------------------*/
+/* Round a supply level to the nearest VMON reference                       */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonRefFromLevel(int32_t microVolt, uint32_t *ref)
+{
+    bool ok = false;
+
+    if (microVolt > 0)
+    {
+        uint32_t uv = (uint32_t) microVolt;
+
+        /* PF53 steps 6.25mV, VMON steps 25mV; nearest code keeps error under 12.5mV */
+        uv = ((uv + (BOARD_VMON_STEP_UV / 2U)) / BOARD_VMON_STEP_UV)
+            * BOARD_VMON_STEP_UV;
+
+        if ((uv >= BOARD_VMON_MIN_UV) && (uv <= BOARD_VMON_MAX_UV))
+        {
+            *ref = uv;
+            ok = true;
+        }
+    }
+
+    return ok;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Point a VMON at a new supply level, or switch it off if out of range     */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonRetarget(uint8_t monitor, int32_t microVolt)
+{
+    bool rc = true;
+    uint32_t ref = 0U;
+#if BOARD_PF09_VMON == 0
+    (void) monitor; (void) microVolt; (void) ref;
+    return rc;
+#endif
+    uint32_t *cur = (monitor == PF09_VMON1) ? &s_vmonRefSoc : &s_vmonRefArm;
+
+    if (BRD_SM_VmonRefFromLevel(microVolt, &ref))
+    {
+        /* Same reference: no write, no needless TMASK window */
+        if (ref != *cur)
+        {
+            /* PF09 13.3.3.1: set point first, TMASK then hides the ramp */
+            rc = PF09_MonitorSet(&g_pf09Dev, monitor, PF09_STATE_VRUN, ref);
+            if (rc && (*cur == 0U))
+            {
+                rc = PF09_MonitorEnable(&g_pf09Dev, monitor, true);
+            }
+            if (rc)
+            {
+                *cur = ref;
+            }
+        }
+    }
+    else
+    {
+        /* Level outside 0.5-1.275V: nothing valid to compare against */
+        rc = PF09_MonitorEnable(&g_pf09Dev, monitor, false);
+        *cur = 0U;
+    }
+
+    return rc;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Stop a VMON before its supply goes away                                  */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonOff(uint8_t monitor)
+{
+    uint32_t *cur = (monitor == PF09_VMON1) ? &s_vmonRefSoc : &s_vmonRefArm;
+
+    *cur = 0U;
+#if BOARD_PF09_VMON == 0
+    (void) monitor;
+    return true;
+#else
+    return PF09_MonitorEnable(&g_pf09Dev, monitor, false);
+#endif
+}
+
+/*--------------------------------------------------------------------------*/
+/* Configure and arm both VMONs on the levels already applied               */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VmonInit(void)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    bool rc = true;
+#if BOARD_PF09_VMON == 0
+    return status;
+#endif
+    const uint8_t ctrl = (uint8_t) (BOARD_VMON_TMASK << BOARD_VMON_CTRL_TMASK_SHIFT);
+    const uint8_t ctrlMask = (uint8_t) ((0x3U << BOARD_VMON_CTRL_TMASK_SHIFT)
+        | BOARD_VMON_CTRL_PG_EN);
+
+    /* PG_EN off: a VMON fault must reach the SM, not pull PGOOD */
+    rc = rc && PF09_PmicWrite(&g_pf09Dev, PF09_REG_VMON1_CTRL, ctrl, ctrlMask);
+    rc = rc && PF09_PmicWrite(&g_pf09Dev, PF09_REG_VMON2_CTRL, ctrl, ctrlMask);
+
+    /* Arm on the real levels, VDD_ARM only if its regulator is on */
+    rc = rc && BRD_SM_VmonRetarget(PF09_VMON1, s_levelSoc);
+    if (s_modeArm == DEV_SM_VOLT_MODE_ON)
+    {
+        rc = rc && BRD_SM_VmonRetarget(PF09_VMON2, s_levelArm);
+    }
+
+    if (rc)
+    {
+        /* PF09 Table 60: MON1/MON2 are bits 6/7 of SW_UV/SW_OV masks */
+        const uint8_t mask[PF09_MASK_LEN] =
+        {
+            [PF09_MASK_IDX_SW_UV] = 0xC0U,
+            [PF09_MASK_IDX_SW_OV] = 0xC0U
+        };
+
+        rc = PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, true);
+    }
+
+    if (!rc)
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+    }
+
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Return voltage name                                                      */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageNameGet(uint32_t domainId, string *voltNameAddr,
+    int32_t *len)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    static int32_t s_maxLen = 0;
+
+    static string const s_name[BRD_SM_NUM_VOLT] =
+    {
+        "vdd_gpio_3p3",
+        "vdd_ana_0p8",
+        "vdd_gpio_1p8",
+        "vddq_ddr",
+        "vdd2_ddr",
+        "sd_card",
+        "nvcc_sd2"
+    };
+
+    /* Get max string width */
+    DEV_SM_MaxStringGet(len, &s_maxLen, s_name, BRD_SM_NUM_VOLT);
+
+    /* Check to see if domain is within bounds*/
+    if (domainId < SM_NUM_VOLT)
+    {
+        /* Check if device or board */
+        if (domainId < DEV_SM_NUM_VOLT)
+        {
+            status = DEV_SM_VoltageNameGet(domainId, voltNameAddr, len);
+        }
+        else
+        {
+            /* Return pointer to name */
+            *voltNameAddr = s_name[domainId - DEV_SM_NUM_VOLT];
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Return supported voltage range                                           */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageDescribe(uint32_t domainId,
+    dev_sm_voltage_range_t *range)
+{
+    int32_t status = SM_ERR_HARDWARE_ERROR;
+    bool rc = false;
+    PF09_RegInfo info;
+
+    /* Get voltage range/info */
+    switch (domainId)
+    {
+        case DEV_SM_VOLT_SOC:
+            status = DEV_SM_VoltageDescribe(domainId, range);
+            break;
+        case DEV_SM_VOLT_ARM:
+            status = DEV_SM_VoltageDescribe(domainId, range);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_3P3:
+            rc = PF09_RegulatorInfoGet(PF09_REG_SW1, &info);
+            break;
+        case BRD_SM_VOLT_VDD_ANA_0P8:
+            rc = PF09_RegulatorInfoGet(PF09_REG_SW2, &info);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_1P8:
+            rc = PF09_RegulatorInfoGet(PF09_REG_SW3, &info);
+            break;
+        case BRD_SM_VOLT_VDDQ_DDR:
+            rc = PF09_RegulatorInfoGet(PF09_REG_SW4, &info);
+            break;
+        case BRD_SM_VOLT_VDD2_DDR:
+            rc = PF09_RegulatorInfoGet(PF09_REG_SW5, &info);
+            break;
+        case BRD_SM_VOLT_SD_CARD:
+            rc = PF09_RegulatorInfoGet(PF09_REG_LDO1, &info);
+            break;
+        case BRD_SM_VOLT_NVCC_SD2:
+            rc = PF09_RegulatorInfoGet(PF09_REG_LDO2, &info);
+            break;
+        default:
+            status = SM_ERR_NOT_FOUND;
+            break;
+    }
+
+    /* Return results */
+    if (rc)
+    {
+        /* Set the status if parameters are out of range */
+        status = SM_ERR_INVALID_PARAMETERS;
+
+        /* Validate the parameters values are with in int32 range */
+        if (CHECK_U32_FIT_I32(info.maxV) &&
+            CHECK_U32_FIT_I32(info.minV) &&
+            CHECK_U32_FIT_I32(info.stepV))
+        {
+            range->highestVolt = (int32_t) info.maxV;
+            range->lowestVolt = (int32_t) info.minV;
+            range->stepSize = (int32_t) info.stepV;
+            status = SM_ERR_SUCCESS;
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Set voltage mode                                                         */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageModeSet(uint32_t domainId, uint8_t voltMode)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    bool enable = (voltMode == DEV_SM_VOLT_MODE_ON);
+    uint8_t mode = ((voltMode == DEV_SM_VOLT_MODE_OFF)
+        ? PF09_SW_MODE_OFF : PF09_SW_MODE_PWM);
+    bool rc;
+
+    /* Set mode */
+    switch (domainId)
+    {
+        case DEV_SM_VOLT_SOC:
+            mode = ((voltMode == DEV_SM_VOLT_MODE_OFF)
+                ? PF53_SW_MODE_OFF : PF53_SW_MODE_PWM);
+            rc = PF53_SwModeSet(&g_pf5302Dev, PF53_REG_SW1, PF53_STATE_VRUN,
+                mode);
+            break;
+        case DEV_SM_VOLT_ARM:
+            /* Monitoring a rail that is being switched off is a guaranteed UV */
+            if (!enable)
+            {
+                (void) BRD_SM_VmonOff(PF09_VMON2);
+
+                /* An unpowered PF5301 answers nothing; polling it only counts I2C errors */
+                BRD_SM_Pf53RailOff(0U, true);
+            }
+            else
+            {
+                BRD_SM_Pf53RailOff(0U, false);
+
+                /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
+                BRD_SM_Pf53PgoodIgnore(0U);
+            }
+            rc = PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
+                enable);
+            if (rc)
+            {
+                s_modeArm = voltMode;
+            }
+            if (enable && rc)
+            {
+                /* Wait for PF53 power up and ramp */
+                SystemTimeDelay(1000U);
+
+                if (s_levelArm != BOARD_VOLT_ARM)
+                {
+                    /* Restore voltage as enable resets the PF53 */
+                    status = BRD_SM_VoltageLevelSet(domainId, s_levelArm);
+                }
+                else
+                {
+                    /* Rail is back at its reset level: re-arm on it */
+                    (void) BRD_SM_VmonRetarget(PF09_VMON2, s_levelArm);
+                }
+            }
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_3P3:
+            rc = PF09_SwModeSet(&g_pf09Dev, PF09_REG_SW1, PF09_STATE_VRUN,
+                mode);
+            break;
+        case BRD_SM_VOLT_VDD_ANA_0P8:
+            rc = PF09_SwModeSet(&g_pf09Dev, PF09_REG_SW2, PF09_STATE_VRUN,
+                mode);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_1P8:
+            rc = PF09_SwModeSet(&g_pf09Dev, PF09_REG_SW3, PF09_STATE_VRUN,
+                mode);
+            break;
+        case BRD_SM_VOLT_VDDQ_DDR:
+            rc = PF09_SwModeSet(&g_pf09Dev, PF09_REG_SW4, PF09_STATE_VRUN,
+                mode);
+            break;
+        case BRD_SM_VOLT_VDD2_DDR:
+            rc = PF09_SwModeSet(&g_pf09Dev, PF09_REG_SW5, PF09_STATE_VRUN,
+                mode);
+            break;
+        case BRD_SM_VOLT_SD_CARD:
+            rc = PF09_LdoEnable(&g_pf09Dev, PF09_REG_LDO1, PF09_STATE_VRUN,
+                enable);
+            break;
+        case BRD_SM_VOLT_NVCC_SD2:
+            rc = PF09_LdoEnable(&g_pf09Dev, PF09_REG_LDO2, PF09_STATE_VRUN,
+                enable);
+            break;
+        default:
+            status = SM_ERR_NOT_FOUND;
+            break;
+    }
+
+    /* Translate error */
+    if ((status == SM_ERR_SUCCESS) && !rc)
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Get voltage mode                                                         */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageModeGet(uint32_t domainId, uint8_t *voltMode)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    bool enable;
+    uint8_t mode;
+    bool rc;
+
+    /* Get mode */
+    switch (domainId)
+    {
+        case DEV_SM_VOLT_SOC:
+            rc = PF53_SwModeGet(&g_pf5302Dev, PF53_REG_SW1, PF53_STATE_VRUN,
+                &mode);
+            enable = (mode != PF53_SW_MODE_OFF);
+            break;
+        case DEV_SM_VOLT_ARM:
+            rc = PF09_GpioCtrlGet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
+                &enable);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_3P3:
+            rc = PF09_SwModeGet(&g_pf09Dev, PF09_REG_SW1, PF09_STATE_VRUN,
+                &mode);
+            enable = (mode != PF09_SW_MODE_OFF);
+            break;
+        case BRD_SM_VOLT_VDD_ANA_0P8:
+            rc = PF09_SwModeGet(&g_pf09Dev, PF09_REG_SW2, PF09_STATE_VRUN,
+                &mode);
+            enable = (mode != PF09_SW_MODE_OFF);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_1P8:
+            rc = PF09_SwModeGet(&g_pf09Dev, PF09_REG_SW3, PF09_STATE_VRUN,
+                &mode);
+            enable = (mode != PF09_SW_MODE_OFF);
+            break;
+        case BRD_SM_VOLT_VDDQ_DDR:
+            rc = PF09_SwModeGet(&g_pf09Dev, PF09_REG_SW4, PF09_STATE_VRUN,
+                &mode);
+            enable = (mode != PF09_SW_MODE_OFF);
+            break;
+        case BRD_SM_VOLT_VDD2_DDR:
+            rc = PF09_SwModeGet(&g_pf09Dev, PF09_REG_SW5, PF09_STATE_VRUN,
+                &mode);
+            enable = (mode != PF09_SW_MODE_OFF);
+            break;
+        case BRD_SM_VOLT_SD_CARD:
+            rc = PF09_LdoIsEnabled(&g_pf09Dev, PF09_REG_LDO1, PF09_STATE_VRUN,
+                &enable);
+            break;
+        case BRD_SM_VOLT_NVCC_SD2:
+            rc = PF09_LdoIsEnabled(&g_pf09Dev, PF09_REG_LDO2, PF09_STATE_VRUN,
+                &enable);
+            break;
+        default:
+            status = SM_ERR_NOT_FOUND;
+            break;
+    }
+
+    /* Return result and translate error */
+    if (status == SM_ERR_SUCCESS)
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+        if (rc)
+        {
+            *voltMode = enable ? DEV_SM_VOLT_MODE_ON : DEV_SM_VOLT_MODE_OFF;
+            status = SM_ERR_SUCCESS;
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Set voltage level                                                        */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageLevelSet(uint32_t domainId, int32_t voltageLevel)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Check voltageLevel is positive */
+    if (CHECK_I32_POSITIVE(voltageLevel))
+    {
+        bool rc;
+        uint32_t level = (uint32_t) voltageLevel;
+
+        /* Set level */
+        switch (domainId)
+        {
+            case DEV_SM_VOLT_SOC:
+                /* A stale VMON reference would flag the ramp; move it first */
+                rc = BRD_SM_VmonRetarget(PF09_VMON1, (int32_t) level);
+                if (rc)
+                {
+                    rc = PF53_VoltageSet(&g_pf5302Dev, PF53_REG_SW1,
+                        PF53_STATE_VRUN, level);
+                }
+
+                if (rc)
+                {
+                    /* Save level to restore */
+                    s_levelSoc = (int32_t) level;
+                }
+                break;
+            case DEV_SM_VOLT_ARM:
+                /* VMON2 only tracks while PF5301 is on */
+                if (s_modeArm == DEV_SM_VOLT_MODE_ON)
+                {
+                    rc = BRD_SM_VmonRetarget(PF09_VMON2, (int32_t) level);
+                }
+                else
+                {
+                    rc = true;
+                }
+                if (rc)
+                {
+                    rc = PF53_VoltageSet(&g_pf5301Dev, PF53_REG_SW1,
+                        PF53_STATE_VRUN, level);
+                }
+
+                /* A refused write must not become the level restored later */
+                if (rc)
+                {
+                    /* Save level to restore */
+                    s_levelArm = (int32_t) level;
+                }
+                break;
+            case BRD_SM_VOLT_VDD_GPIO_3P3:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW1, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_VDD_ANA_0P8:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW2, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_VDD_GPIO_1P8:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW3, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_VDDQ_DDR:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW4, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_VDD2_DDR:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW5, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_SD_CARD:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_LDO1, PF09_STATE_VRUN,
+                    level);
+                break;
+            case BRD_SM_VOLT_NVCC_SD2:
+                rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_LDO2, PF09_STATE_VRUN,
+                    level);
+                break;
+            default:
+                status = SM_ERR_NOT_FOUND;
+                break;
+        }
+
+        /* Translate error */
+        if ((status == SM_ERR_SUCCESS) && !rc)
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+    }
+    else
+    {
+        /* Set the status if voltageLevel is negative */
+        status = SM_ERR_INVALID_PARAMETERS;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Get voltage level                                                        */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageLevelGet(uint32_t domainId, int32_t *voltageLevel)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    bool rc;
+    uint32_t level = 0U;
+
+    /* Get level */
+    switch (domainId)
+    {
+        case DEV_SM_VOLT_SOC:
+            rc = PF53_VoltageGet(&g_pf5302Dev, PF53_REG_SW1, PF53_STATE_VRUN,
+                &level);
+            break;
+        case DEV_SM_VOLT_ARM:
+            rc = PF53_VoltageGet(&g_pf5301Dev, PF53_REG_SW1, PF53_STATE_VRUN,
+                &level);
+
+            if (rc)
+            {
+                /* Set status if level is not within int32_t range */
+                status = SM_ERR_INVALID_PARAMETERS;
+
+                /* Check level is within int32_t range */
+                if (CHECK_U32_FIT_I32(level))
+                {
+                    /* Save level to restore */
+                    s_levelArm = (int32_t) level;
+                    status = SM_ERR_SUCCESS;
+                }
+            }
+            else
+            {
+                /* Set status if level is not within int32_t range */
+                status = SM_ERR_INVALID_PARAMETERS;
+
+                /* Check s_levelArm has positive value */
+                if (CHECK_I32_POSITIVE(s_levelArm))
+                {
+                    /* Return saved level */
+                    level = (uint32_t) s_levelArm;
+                    rc = true;
+                    status = SM_ERR_SUCCESS;
+                }
+            }
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_3P3:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_SW1, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_VDD_ANA_0P8:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_SW2, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_VDD_GPIO_1P8:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_SW3, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_VDDQ_DDR:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_SW4, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_VDD2_DDR:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_SW5, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_SD_CARD:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_LDO1, PF09_STATE_VRUN,
+                &level);
+            break;
+        case BRD_SM_VOLT_NVCC_SD2:
+            rc = PF09_VoltageGet(&g_pf09Dev, PF09_REG_LDO2, PF09_STATE_VRUN,
+                &level);
+            break;
+        default:
+            status = SM_ERR_NOT_FOUND;
+            break;
+    }
+
+    /* Return result */
+    if (status == SM_ERR_SUCCESS)
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+
+        if (rc)
+        {
+            /* Set the status if parameters are out of range */
+            status = SM_ERR_INVALID_PARAMETERS;
+
+            /* Check level value within int32_t range */
+            if (CHECK_U32_FIT_I32(level))
+            {
+                *voltageLevel = (int32_t) level;
+                status = SM_ERR_SUCCESS;
+            }
+        }
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Suspend SoC voltages                                                     */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_VoltageSuspend(bool offArm)
+{
+    /* Saved inside the branch, it could only ever record ON, never OFF */
+    s_modeArmSave = s_modeArm;
+
+    /* Turn off VDD_ARM */
+    if (offArm && (s_modeArm != DEV_SM_VOLT_MODE_OFF))
+    {
+        (void) BRD_SM_VoltageModeSet(DEV_SM_VOLT_ARM, DEV_SM_VOLT_MODE_OFF);
+    }
+}
+
+/*--------------------------------------------------------------------------*/
+/* Restore SoC voltages                                                     */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_VoltageRestore(void)
+{
+    /* Restore VDD_SOC level */
+    if (s_levelSoc != BOARD_VOLT_SOC)
+    {
+        /* Restore voltage as enable resets the PF53 */
+        (void) BRD_SM_VoltageLevelSet(DEV_SM_VOLT_SOC, s_levelSoc);
+    }
+
+    /* Restore VDD_ARM mode, never turn on a rail the agent had shut down */
+    if ((s_modeArmSave == DEV_SM_VOLT_MODE_ON)
+        && (s_modeArm == DEV_SM_VOLT_MODE_OFF))
+    {
+        BRD_SM_Pf53RailOff(0U, false);
+
+        /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
+        BRD_SM_Pf53PgoodIgnore(0U);
+
+        if (PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
+            true))
+        {
+            /* Wait for PF53 power up and ramp */
+            SystemTimeDelay(1000U);
+
+            s_modeArm = DEV_SM_VOLT_MODE_ON;
+        }
+    }
+
+    /* Restore VDD_ARM level; PF5301 PWRON is low while the rail is off */
+    if ((s_modeArm == DEV_SM_VOLT_MODE_ON) && (s_levelArm != BOARD_VOLT_ARM))
+    {
+        /* Restore voltage as enable resets the PF53 */
+        (void) BRD_SM_VoltageLevelSet(DEV_SM_VOLT_ARM, s_levelArm);
+    }
+
+    /* PF09 may have soft-reset in suspend: re-arm both monitors */
+    s_vmonRefSoc = 0U;
+    s_vmonRefArm = 0U;
+    (void) BRD_SM_VmonInit();
+}
+
+/*--------------------------------------------------------------------------*/
+/* Return the ARM volt mode                                                 */
+/*--------------------------------------------------------------------------*/
+uint32_t BRD_SM_ArmVoltModeGet(void)
+{
+    /* Return status */
+    return s_modeArm;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Rail windows: IMX95IEC Table 22 p.25-27, Micron z42m p.1 for VDD2      */
+/*--------------------------------------------------------------------------*/
+static const struct
+{
+    uint32_t domainId;
+    const char *name;
+    int32_t minUv;
+    int32_t maxUv;
+} s_railWindow[] =
+{
+    /* VDD_SOC/VDD_ARM: all Table 22 setpoints, 0.61 V to 0.955 V */
+    {DEV_SM_VOLT_SOC,          "vdd_soc",      610000,  955000},
+    {DEV_SM_VOLT_ARM,          "vdd_arm",      610000,  955000},
+    /* NVCC 3.3 V mode: 3.0 V to 3.45 V */
+    {BRD_SM_VOLT_VDD_GPIO_3P3, "vdd_gpio_3p3", 3000000, 3450000},
+    /* VDD_ANA_0P8: 0.795 V to 0.88 V */
+    {BRD_SM_VOLT_VDD_ANA_0P8,  "vdd_ana_0p8",  795000,  880000},
+    /* VDD_ANA_1P8: 1.71 V to 1.89 V */
+    {BRD_SM_VOLT_VDD_GPIO_1P8, "vdd_gpio_1p8", 1710000, 1890000},
+    /* VDDQ_DDR LPDDR4X: 0.57 V to 0.65 V */
+    {BRD_SM_VOLT_VDDQ_DDR,     "vddq_ddr",     570000,  650000},
+    /* Micron VDD2: 1.06 V to 1.17 V */
+    {BRD_SM_VOLT_VDD2_DDR,     "vdd2_ddr",     1060000, 1170000},
+    /* LDO1 feeds NVCC_ENET and the PHYs: 3.3 V mode */
+    {BRD_SM_VOLT_SD_CARD,      "vdd_sd2_3v3",  3000000, 3450000},
+    /* NVCC_SD2 is 1.8 V or 3.3 V by VSELECT */
+    {BRD_SM_VOLT_NVCC_SD2,     "nvcc_sd2",     1650000, 3450000},
+};
+
+/* OTP ID char: first letter A-Z, second 0-9 then A-Z (Tables 9-10) */
+static inline int BRD_SM_OtpIdChar(uint8_t code, char first)
+{
+    int c = (int) code;
+
+    if ((first == '0') && (c >= 10))
+    {
+        c = 'A' + (c - 10);
+    }
+    else
+    {
+        c = first + c;
+    }
+
+    return c;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Read every PMIC rail once, log it, refuse a rail out of its window    */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VoltageGuard(void)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    uint32_t num = (uint32_t) (sizeof(s_railWindow) / sizeof(s_railWindow[0]));
+    uint8_t *id = NULL;
+    uint8_t idLen = 0U;
+
+    /* PF09 OTP ID: PROG_ID1/2 registers 0x03/0x04, data sheet Tables 9-10 */
+    if (PF09_PmicInfoGet(&g_pf09Dev, &id, &idLen) && (idLen >= 5U))
+    {
+        printf("  - PF09 dev 0x%02X rev 0x%02X OTP ID %c%c\n", id[0], id[2],
+            BRD_SM_OtpIdChar(id[3] & 0x1FU, 'A'), BRD_SM_OtpIdChar(id[4] & 0x3FU, '0'));
+    }
+
+    for (uint32_t i = 0U; i < num; i++)
+    {
+        int32_t uV = 0;
+        int32_t rc = BRD_SM_VoltageLevelGet(s_railWindow[i].domainId, &uV);
+        bool ok = (rc == SM_ERR_SUCCESS) && (uV >= s_railWindow[i].minUv)
+            && (uV <= s_railWindow[i].maxUv);
+
+        printf("  - %s: %d uV%s\n", s_railWindow[i].name, (int) uV,
+            ok ? "" : " OUT OF WINDOW");
+
+        if (!ok)
+        {
+            status = SM_ERR_HARDWARE_ERROR;
+        }
+    }
+
+    return status;
+}
