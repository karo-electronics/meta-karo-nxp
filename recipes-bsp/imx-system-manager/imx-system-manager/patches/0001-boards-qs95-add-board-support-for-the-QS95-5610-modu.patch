+/*==========================================================================*/
+/* File containing the implementation of the board controls.                */
+/*==========================================================================*/
+
+/* Includes */
+
+#include "sm.h"
+#include "brd_sm.h"
+
+#if BOARD_PMIC_CTRL
+
+/* Local defines */
+
+/* Cortex-M packs the priority in the upper __NVIC_PRIO_BITS of BASEPRI */
+#define BRD_SM_PMIC_BASEPRI  \
+    (((uint32_t) IRQ_PRIO_NOPREEMPT_CRITICAL) << (8U - __NVIC_PRIO_BITS))
+
+/* Local types */
+
+/* Local variables */
+
+/* Local functions */
+
+/*--------------------------------------------------------------------------*/
+/* Hold off the journal writers                                             */
+/*--------------------------------------------------------------------------*/
+static uint32_t BRD_SM_PmicLock(void)
+{
+    uint32_t basePri = __get_BASEPRI();
+
+    /* The tick and IRQ56 write the journals, and both sit below this level */
+    __set_BASEPRI(BRD_SM_PMIC_BASEPRI);
+
+    /* Return the previous level */
+    return basePri;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Let the journal writers back in                                          */
+/*--------------------------------------------------------------------------*/
+static void BRD_SM_PmicUnlock(uint32_t basePri)
+{
+    __set_BASEPRI(basePri);
+}
+
+/*--------------------------------------------------------------------------*/
+/* Set a control value                                                      */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlSet(uint32_t ctrlId, uint32_t numVal,
+    const uint32_t *val)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Check to see if ctrlId is within bounds */
+    if (ctrlId < SM_NUM_CTRL)
+    {
+        /* Check if device or board */
+        if (ctrlId < DEV_SM_NUM_CTRL)
+        {
+            status = DEV_SM_ControlSet(ctrlId, numVal, val);
+        }
+        else if ((numVal >= 1U) && (val != NULL) && (val[0] == 0U))
+        {
+            /* The ISRs own these counters, so no read can straddle the reset */
+            uint32_t basePri = BRD_SM_PmicLock();
+
+            g_pf09Fault.cnt = 0U;
+            g_pf09Fault.ioErr = 0U;
+
+            for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+            {
+                g_pf09Fault.last[idx] = 0U;
+            }
+
+            for (uint32_t idx = 0U; idx < 2U; idx++)
+            {
+                g_pf53Fault[idx].cnt = 0U;
+                g_pf53Fault[idx].ioErr = 0U;
+                g_pf53Fault[idx].last[0] = 0U;
+                g_pf53Fault[idx].last[1] = 0U;
+            }
+
+            BRD_SM_PmicUnlock(basePri);
+
+            /* ewarn and the boot capture outlive the journal, so keep them */
+        }
+        else
+        {
+            /* Only a zero clears, so a stray write cannot destroy the evidence */
+            status = SM_ERR_INVALID_PARAMETERS;
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Get a control value                                                      */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlGet(uint32_t ctrlId, uint32_t *numRtn, uint32_t *rtn)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Default to no return */
+    *numRtn = 0U;
+
+    /* Check to see if ctrlId is within bounds */
+    if (ctrlId < SM_NUM_CTRL)
+    {
+        /* Check if device or board */
+        if (ctrlId < DEV_SM_NUM_CTRL)
+        {
+            status = DEV_SM_ControlGet(ctrlId, numRtn, rtn);
+        }
+        else
+        {
+            /* A service in the middle of this loop would return half a journal */
+            uint32_t basePri = BRD_SM_PmicLock();
+
+            rtn[0] = g_pf09Fault.cnt;
+            rtn[1] = g_pf09Fault.ioErr;
+            rtn[2] = 0U;
+            rtn[3] = 0U;
+            rtn[4] = 0U;
+
+            /* Raw latches, four groups per word, so field service sees the rail */
+            for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+            {
+                rtn[2U + (idx / 4U)] |=
+                    ((uint32_t) g_pf09Fault.last[idx])
+                    << (8U * (idx % 4U));
+            }
+
+            for (uint32_t idx = 0U; idx < 2U; idx++)
+            {
+                rtn[5U + idx] = ((g_pf53Fault[idx].cnt & 0xFFFFU) << 16U)
+                    | (((uint32_t) g_pf53Fault[idx].last[0]) << 8U)
+                    | ((uint32_t) g_pf53Fault[idx].last[1]);
+            }
+
+            /* MON1/MON2 count in an ISR of their own, kept in the upper half */
+            rtn[7] = (g_vmonFaultCnt & 0xFFFFU) << 16U;
+            if (g_intbPolling)
+            {
+                rtn[7] |= BRD_SM_PMIC_STAT_POLLING;
+            }
+            if (g_pf09Fault.ewarn)
+            {
+                rtn[7] |= BRD_SM_PMIC_STAT_EWARN;
+            }
+
+            BRD_SM_PmicUnlock(basePri);
+
+            /* Boot only: FAULT_FLAGS, HFAULT_FLAGS and the IO_INT read once */
+            rtn[8] = g_pmicFaultFlags;
+            rtn[9] = g_pf53BootFlags;
+
+            *numRtn = BRD_SM_PMIC_FAULT_LEN;
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Set an extended control value                                            */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlExtSet(uint32_t ctrlId, uint32_t addr,
+    uint32_t numVal, const uint32_t *val)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Check to see if ctrlId is within bounds */
+    if (ctrlId < SM_NUM_CTRL)
+    {
+        /* Check if device or board */
+        if (ctrlId < DEV_SM_NUM_CTRL)
+        {
+            status = DEV_SM_ControlExtSet(ctrlId, addr, numVal, val);
+        }
+        else
+        {
+            status = SM_ERR_NOT_SUPPORTED;
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Get an extended control value                                            */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlExtGet(uint32_t ctrlId, uint32_t addr,
+    uint32_t numRtn, uint32_t *rtn)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Check to see if ctrlId is within bounds */
+    if (ctrlId < SM_NUM_CTRL)
+    {
+        /* Check if device or board */
+        if (ctrlId < DEV_SM_NUM_CTRL)
+        {
+            status = DEV_SM_ControlExtGet(ctrlId, addr, numRtn, rtn);
+        }
+        else
+        {
+            status = SM_ERR_NOT_SUPPORTED;
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Do a control action                                                      */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlAction(uint32_t ctrlId, uint32_t action,
+    uint32_t numArg, const uint32_t *arg, uint32_t *numRtn, uint32_t *rtn)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Default to no return */
+    *numRtn = 0U;
+
+    /* Check to see if ctrlId is within bounds */
+    if (ctrlId < SM_NUM_CTRL)
+    {
+        /* Check if device or board */
+        if (ctrlId < DEV_SM_NUM_CTRL)
+        {
+            status = DEV_SM_ControlAction(ctrlId, action, numArg, arg,
+                numRtn, rtn);
+        }
+        else
+        {
+            status = SM_ERR_NOT_SUPPORTED;
+        }
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Configure notification flags                                             */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_ControlFlagsSet(uint32_t ctrlId, uint32_t flags)
+{
+    int32_t status = SM_ERR_SUCCESS;
+
+    /* Check if device or board */
+    if (ctrlId < DEV_SM_NUM_CTRL)
+    {
+        status = DEV_SM_ControlFlagsSet(ctrlId, flags);
+    }
+    else if (ctrlId < SM_NUM_CTRL)
+    {
+        /* The event source is always armed, but the request must be accepted */
+        ;  /* Intentional empty branch */
+    }
+    else
+    {
+        status = SM_ERR_NOT_FOUND;
+    }
+
+    /* Return status */
+    return status;
+}
+
+#endif /* BOARD_PMIC_CTRL */
