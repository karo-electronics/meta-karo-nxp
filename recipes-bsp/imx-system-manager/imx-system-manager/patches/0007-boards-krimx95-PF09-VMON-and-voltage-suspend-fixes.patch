From aff016756deb2fa0c65e1ae1630212bae606cb6a Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Thu, 10 Sep 2026 12:54:28 +0200
Subject: [PATCH] boards: krimx95: PF09 VMON and voltage suspend fixes

- VMON1 VDD_SOC, VMON2 VDD_ARM
- retarget before ramp avoids false UV
- off before rail off avoids guaranteed UV
- re-arm after suspend soft-reset
- SW_UV SW_OV masks include MON1 MON2
- VoltageSuspend save outside branch
- BOARD_PF09_VMON=0 default (OTP mismatch)

Upstream-Status: Inappropriate [board-specific]
---
 boards/krimx95/sm/brd_sm_control.c  |   3 -
 boards/krimx95/sm/brd_sm_control.h  |   3 -
 boards/krimx95/sm/brd_sm_handlers.c |  11 +-
 boards/krimx95/sm/brd_sm_voltage.c  | 237 +++++++++++++++++++++++++---
 boards/krimx95/sm/brd_sm_voltage.h  |  12 ++
 5 files changed, 236 insertions(+), 30 deletions(-)

diff --git a/boards/krimx95/sm/brd_sm_control.c b/boards/krimx95/sm/brd_sm_control.c
index 703af6b..b84f1ab 100644
--- a/boards/krimx95/sm/brd_sm_control.c
+++ b/boards/krimx95/sm/brd_sm_control.c
@@ -43,9 +43,6 @@
 
 #if BOARD_PMIC_CTRL
 
-/* Until VMON lands, keep the counter here so the journal compiles */
-uint32_t g_vmonFaultCnt = 0U;
-
 /* Local defines */
 
 /* Cortex-M packs the priority in the upper __NVIC_PRIO_BITS of BASEPRI */
diff --git a/boards/krimx95/sm/brd_sm_control.h b/boards/krimx95/sm/brd_sm_control.h
index 10a7555..f6ea958 100644
--- a/boards/krimx95/sm/brd_sm_control.h
+++ b/boards/krimx95/sm/brd_sm_control.h
@@ -193,9 +193,6 @@ int32_t BRD_SM_ControlFlagsSet(uint32_t ctrlId, uint32_t flags);
 
 #endif /* BOARD_PMIC_CTRL */
 
-/* Moved to brd_sm_voltage.h when VMON lands */
-extern uint32_t g_vmonFaultCnt;
-
 #endif /* BRD_SM_CONTROL_H */
 
 /** @} */
diff --git a/boards/krimx95/sm/brd_sm_handlers.c b/boards/krimx95/sm/brd_sm_handlers.c
index 41c9669..55c5a14 100755
--- a/boards/krimx95/sm/brd_sm_handlers.c
+++ b/boards/krimx95/sm/brd_sm_handlers.c
@@ -106,8 +106,8 @@ static const uint8_t s_pf09Unmasked[PF09_MASK_LEN] =
     [PF09_MASK_IDX_SW_ILIM] = 0x9FU,
     [PF09_MASK_IDX_LDO_ILIM] = 0x07U,
     /* Bits 7:6 are MON1/MON2, unmasked by BRD_SM_VmonInit when VMON is built */
-    [PF09_MASK_IDX_SW_UV] = 0x1FU,
-    [PF09_MASK_IDX_SW_OV] = 0x1FU,
+    [PF09_MASK_IDX_SW_UV] = 0xDFU,
+    [PF09_MASK_IDX_SW_OV] = 0xDFU,
     [PF09_MASK_IDX_LDO_UV] = 0x0BU,
     [PF09_MASK_IDX_LDO_OV] = 0x0BU,
     /* PF09 Tab.60: ERRMON, FCCU1, FCCU0; RSTB/FS0B/PGOOD_FLT carry no action */
@@ -695,6 +695,13 @@ brd_sm_pf09_status_t BRD_SM_Pf09Handler(void)
         thermStat = stat[PF09_MASK_IDX_STATUS2] & 0x0FU;
         therm = (thermStat != 0U);
 
+        /* MON1/MON2 UV/OV: VDD_SOC or VDD_ARM left its window; record, do not act */
+        if (((stat[PF09_MASK_IDX_SW_UV] | stat[PF09_MASK_IDX_SW_OV])
+            & 0xC0U) != 0U)
+        {
+            g_vmonFaultCnt++;
+        }
+
         /* PF09 12.4.1.1: clearing a masked latch drops evidence and aborts a shutdown */
         for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
         {
diff --git a/boards/krimx95/sm/brd_sm_voltage.c b/boards/krimx95/sm/brd_sm_voltage.c
index f8054bb..7291e3c 100755
--- a/boards/krimx95/sm/brd_sm_voltage.c
+++ b/boards/krimx95/sm/brd_sm_voltage.c
@@ -52,6 +52,156 @@ static int32_t s_levelArm = BOARD_VOLT_ARM;
 static uint32_t s_modeArm = DEV_SM_VOLT_MODE_ON;
 static uint32_t s_modeArmSave = DEV_SM_VOLT_MODE_ON;
 
+/* PF09 VMON1/2 never compare on this OTP program (tested 0.5-1.275V, 0.80V real); keep off */
+#ifndef BOARD_PF09_VMON
+#define BOARD_PF09_VMON         0
+#endif
+
+/* PF09 13.3.3.1: VMON reference range and 25mV step */
+#define BOARD_VMON_MIN_UV       500000U
+#define BOARD_VMON_MAX_UV       1275000U
+#define BOARD_VMON_STEP_UV      25000U
+
+/* PF09 Table 172: 1000us covers a 225mV ramp at 1mV/us plus I2C */
+#define BOARD_VMON_TMASK        0x01U
+
+/* VMONx_CTRL: TMASK[5:4], OVTH_STBY[3], UVTH_STBY[2], SOFTRST_EN[1], PG_EN[0] */
+#define BOARD_VMON_CTRL_TMASK_SHIFT 4U
+#define BOARD_VMON_CTRL_PG_EN       0x01U
+
+/* Reference last written to each VMON; zero means monitor off */
+static uint32_t s_vmonRefSoc = 0U;
+static uint32_t s_vmonRefArm = 0U;
+
+/* Faults seen by the MON handlers, readable for diagnostics */
+uint32_t g_vmonFaultCnt = 0U;
+
+/*--------------------------------------------------------------------------*/
+/* Round a supply level to the nearest VMON reference                       */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonRefFromLevel(int32_t microVolt, uint32_t *ref)
+{
+    bool ok = false;
+
+    if (microVolt > 0)
+    {
+        uint32_t uv = (uint32_t) microVolt;
+
+        /* PF53 steps 6.25mV, VMON steps 25mV; nearest code keeps error under 12.5mV */
+        uv = ((uv + (BOARD_VMON_STEP_UV / 2U)) / BOARD_VMON_STEP_UV)
+            * BOARD_VMON_STEP_UV;
+
+        if ((uv >= BOARD_VMON_MIN_UV) && (uv <= BOARD_VMON_MAX_UV))
+        {
+            *ref = uv;
+            ok = true;
+        }
+    }
+
+    return ok;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Point a VMON at a new supply level, or switch it off if out of range     */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonRetarget(uint8_t monitor, int32_t microVolt)
+{
+    bool rc = true;
+    uint32_t ref = 0U;
+#if BOARD_PF09_VMON == 0
+    (void) monitor; (void) microVolt; (void) ref;
+    return rc;
+#endif
+    uint32_t *cur = (monitor == PF09_VMON1) ? &s_vmonRefSoc : &s_vmonRefArm;
+
+    if (BRD_SM_VmonRefFromLevel(microVolt, &ref))
+    {
+        /* Same reference: no write, no needless TMASK window */
+        if (ref != *cur)
+        {
+            /* PF09 13.3.3.1: set point first, TMASK then hides the ramp */
+            rc = PF09_MonitorSet(&g_pf09Dev, monitor, PF09_STATE_VRUN, ref);
+            if (rc && (*cur == 0U))
+            {
+                rc = PF09_MonitorEnable(&g_pf09Dev, monitor, true);
+            }
+            if (rc)
+            {
+                *cur = ref;
+            }
+        }
+    }
+    else
+    {
+        /* Level outside 0.5-1.275V: nothing valid to compare against */
+        rc = PF09_MonitorEnable(&g_pf09Dev, monitor, false);
+        *cur = 0U;
+    }
+
+    return rc;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Stop a VMON before its supply goes away                                  */
+/*--------------------------------------------------------------------------*/
+static bool BRD_SM_VmonOff(uint8_t monitor)
+{
+    uint32_t *cur = (monitor == PF09_VMON1) ? &s_vmonRefSoc : &s_vmonRefArm;
+
+    *cur = 0U;
+#if BOARD_PF09_VMON == 0
+    (void) monitor;
+    return true;
+#else
+    return PF09_MonitorEnable(&g_pf09Dev, monitor, false);
+#endif
+}
+
+/*--------------------------------------------------------------------------*/
+/* Configure and arm both VMONs on the levels already applied               */
+/*--------------------------------------------------------------------------*/
+int32_t BRD_SM_VmonInit(void)
+{
+    int32_t status = SM_ERR_SUCCESS;
+    bool rc = true;
+#if BOARD_PF09_VMON == 0
+    return status;
+#endif
+    const uint8_t ctrl = (uint8_t) (BOARD_VMON_TMASK << BOARD_VMON_CTRL_TMASK_SHIFT);
+    const uint8_t ctrlMask = (uint8_t) ((0x3U << BOARD_VMON_CTRL_TMASK_SHIFT)
+        | BOARD_VMON_CTRL_PG_EN);
+
+    /* PG_EN off: a VMON fault must reach the SM, not pull PGOOD */
+    rc = rc && PF09_PmicWrite(&g_pf09Dev, PF09_REG_VMON1_CTRL, ctrl, ctrlMask);
+    rc = rc && PF09_PmicWrite(&g_pf09Dev, PF09_REG_VMON2_CTRL, ctrl, ctrlMask);
+
+    /* Arm on the real levels, VDD_ARM only if its regulator is on */
+    rc = rc && BRD_SM_VmonRetarget(PF09_VMON1, s_levelSoc);
+    if (s_modeArm == DEV_SM_VOLT_MODE_ON)
+    {
+        rc = rc && BRD_SM_VmonRetarget(PF09_VMON2, s_levelArm);
+    }
+
+    if (rc)
+    {
+        /* PF09 Table 60: MON1/MON2 are bits 6/7 of SW_UV/SW_OV masks */
+        const uint8_t mask[PF09_MASK_LEN] =
+        {
+            [PF09_MASK_IDX_SW_UV] = 0xC0U,
+            [PF09_MASK_IDX_SW_OV] = 0xC0U
+        };
+
+        rc = PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, true);
+    }
+
+    if (!rc)
+    {
+        status = SM_ERR_HARDWARE_ERROR;
+    }
+
+    return status;
+}
+
 /*--------------------------------------------------------------------------*/
 /* Return voltage name                                                      */
 /*--------------------------------------------------------------------------*/
@@ -186,16 +336,27 @@ int32_t BRD_SM_VoltageModeSet(uint32_t domainId, uint8_t voltMode)
                 mode);
             break;
         case DEV_SM_VOLT_ARM:
-            /* An unpowered PF5301 answers nothing; polling it only counts I2C errors */
-            BRD_SM_Pf53RailOff(0U, !enable);
+            /* Monitoring a rail that is being switched off is a guaranteed UV */
+            if (!enable)
+            {
+                (void) BRD_SM_VmonOff(PF09_VMON2);
 
-            /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
-            if (enable)
+                /* An unpowered PF5301 answers nothing; polling it only counts I2C errors */
+                BRD_SM_Pf53RailOff(0U, true);
+            }
+            else
             {
+                BRD_SM_Pf53RailOff(0U, false);
+
+                /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
                 BRD_SM_Pf53PgoodIgnore(0U);
             }
             rc = PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
                 enable);
+            if (rc)
+            {
+                s_modeArm = voltMode;
+            }
             if (enable && rc)
             {
                 /* Wait for PF53 power up and ramp */
@@ -206,10 +367,11 @@ int32_t BRD_SM_VoltageModeSet(uint32_t domainId, uint8_t voltMode)
                     /* Restore voltage as enable resets the PF53 */
                     status = BRD_SM_VoltageLevelSet(domainId, s_levelArm);
                 }
-            }
-            if (rc)
-            {
-                s_modeArm = voltMode;
+                else
+                {
+                    /* Rail is back at its reset level: re-arm on it */
+                    (void) BRD_SM_VmonRetarget(PF09_VMON2, s_levelArm);
+                }
             }
             break;
         case BRD_SM_VOLT_VDD_GPIO_3P3:
@@ -347,8 +509,13 @@ int32_t BRD_SM_VoltageLevelSet(uint32_t domainId, int32_t voltageLevel)
         switch (domainId)
         {
             case DEV_SM_VOLT_SOC:
-                rc = PF53_VoltageSet(&g_pf5302Dev, PF53_REG_SW1, PF53_STATE_VRUN,
-                    level);
+                /* A stale VMON reference would flag the ramp; move it first */
+                rc = BRD_SM_VmonRetarget(PF09_VMON1, (int32_t) level);
+                if (rc)
+                {
+                    rc = PF53_VoltageSet(&g_pf5302Dev, PF53_REG_SW1,
+                        PF53_STATE_VRUN, level);
+                }
 
                 if (rc)
                 {
@@ -357,12 +524,27 @@ int32_t BRD_SM_VoltageLevelSet(uint32_t domainId, int32_t voltageLevel)
                 }
                 break;
             case DEV_SM_VOLT_ARM:
-                (void) PF53_VoltageSet(&g_pf5301Dev, PF53_REG_SW1, PF53_STATE_VRUN,
-                    level);
+                /* VMON2 only tracks while PF5301 is on */
+                if (s_modeArm == DEV_SM_VOLT_MODE_ON)
+                {
+                    rc = BRD_SM_VmonRetarget(PF09_VMON2, (int32_t) level);
+                }
+                else
+                {
+                    rc = true;
+                }
+                if (rc)
+                {
+                    rc = PF53_VoltageSet(&g_pf5301Dev, PF53_REG_SW1,
+                        PF53_STATE_VRUN, level);
+                }
 
-                /* Save level to restore */
-                s_levelArm = (int32_t) level;
-                rc = true;
+                /* A refused write must not become the level restored later */
+                if (rc)
+                {
+                    /* Save level to restore */
+                    s_levelArm = (int32_t) level;
+                }
                 break;
             case BRD_SM_VOLT_VDD_GPIO_3P3:
                 rc = PF09_VoltageSet(&g_pf09Dev, PF09_REG_SW1, PF09_STATE_VRUN,
@@ -522,12 +704,12 @@ int32_t BRD_SM_VoltageLevelGet(uint32_t domainId, int32_t *voltageLevel)
 /*--------------------------------------------------------------------------*/
 void BRD_SM_VoltageSuspend(bool offArm)
 {
+    /* Saved inside the branch, it could only ever record ON, never OFF */
+    s_modeArmSave = s_modeArm;
+
     /* Turn off VDD_ARM */
     if (offArm && (s_modeArm != DEV_SM_VOLT_MODE_OFF))
     {
-        /* Save VDD_ARM mode */
-        s_modeArmSave = s_modeArm;
-
         (void) BRD_SM_VoltageModeSet(DEV_SM_VOLT_ARM, DEV_SM_VOLT_MODE_OFF);
     }
 }
@@ -544,9 +726,15 @@ void BRD_SM_VoltageRestore(void)
         (void) BRD_SM_VoltageLevelSet(DEV_SM_VOLT_SOC, s_levelSoc);
     }
 
-    /* Restore VDD_ARM mode */
-    if (s_modeArm != s_modeArmSave)
+    /* Restore VDD_ARM mode, never turn on a rail the agent had shut down */
+    if ((s_modeArmSave == DEV_SM_VOLT_MODE_ON)
+        && (s_modeArm == DEV_SM_VOLT_MODE_OFF))
     {
+        BRD_SM_Pf53RailOff(0U, false);
+
+        /* PGOOD_STUCK latches on every PWRON sequence, not only the first */
+        BRD_SM_Pf53PgoodIgnore(0U);
+
         if (PF09_GpioCtrlSet(&g_pf09Dev, PF09_GPIO4, PF53_STATE_VRUN,
             true))
         {
@@ -557,12 +745,17 @@ void BRD_SM_VoltageRestore(void)
         }
     }
 
-    /* Restore VDD_ARM level */
-    if (s_levelArm != BOARD_VOLT_ARM)
+    /* Restore VDD_ARM level; PF5301 PWRON is low while the rail is off */
+    if ((s_modeArm == DEV_SM_VOLT_MODE_ON) && (s_levelArm != BOARD_VOLT_ARM))
     {
         /* Restore voltage as enable resets the PF53 */
         (void) BRD_SM_VoltageLevelSet(DEV_SM_VOLT_ARM, s_levelArm);
     }
+
+    /* PF09 may have soft-reset in suspend: re-arm both monitors */
+    s_vmonRefSoc = 0U;
+    s_vmonRefArm = 0U;
+    (void) BRD_SM_VmonInit();
 }
 
