index 2e21c6d..b74f923 100755
--- a/boards/krimx95/sm/brd_sm_voltage.h
+++ b/boards/krimx95/sm/brd_sm_voltage.h
@@ -207,6 +207,18 @@ void BRD_SM_VoltageSuspend(bool offArm);
  */
 void BRD_SM_VoltageRestore(void);
 
+/*!
+ * Arm VMON1/VMON2 on the current VDD_SOC/VDD_ARM levels.
+ *
+ * Call after the boot performance level is applied.
+ *
+ * @return Returns the status (::SM_ERR_SUCCESS = success).
+ */
+int32_t BRD_SM_VmonInit(void);
+
+/*! Count of VMON faults serviced since boot */
+extern uint32_t g_vmonFaultCnt;
+
 /*!
  * Get the ARM voltage mode.
