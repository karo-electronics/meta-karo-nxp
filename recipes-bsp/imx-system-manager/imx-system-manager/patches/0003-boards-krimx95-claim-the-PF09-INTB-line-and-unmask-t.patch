From 9ea48fb1ae85c21392fdc4d980d83f5c4c0d38dc Mon Sep 17 00:00:00 2001
From: Chedy Souffargi <cs@karo-electronics.de>
Date: Wed, 9 Sep 2026 16:41:45 +0200
Subject: [PATCH] boards: krimx95: claim the PF09 INTB line and unmask the
 fault interrupts

- pad HYS + PU
- GPIO5.IO14 secure, output 1, ICR LK, LOCK
- IRQ56 low prio, LPI GPIO5, re-arm after sleep
- PF09 masks per datasheet, PWRUP latch cleared
- clear filter, THERM re-mask
- IO_INT boot read, W1C
- -Os on board files, fits 179200 slot

Upstream-Status: Inappropriate [board-specific]
---
 boards/krimx95/board.c              |  17 ++-
 boards/krimx95/pin_mux.c            |   5 +-
 boards/krimx95/sm/Makefile          |   8 ++
 boards/krimx95/sm/brd_sm_handlers.c | 193 +++++++++++++++++++++++-----
 boards/krimx95/sm/brd_sm_handlers.h |  18 ++-
 5 files changed, 202 insertions(+), 39 deletions(-)

diff --git a/boards/krimx95/board.c b/boards/krimx95/board.c
index 8de0f0c..e26aa30 100755
--- a/boards/krimx95/board.c
+++ b/boards/krimx95/board.c
@@ -6,6 +6,7 @@
 
 #include "sm.h"
 #include "board.h"
+#include "brd_sm_handlers.h"
 #include "brd_sm_voltage.h"
 #include "fsl_lpuart.h"
 #include "fsl_lpi2c.h"
@@ -360,8 +361,10 @@ void BOARD_InitHandlers(void)
     NVIC_SetPriority(FCCU_INT0_IRQn, IRQ_PRIO_NOPREEMPT_CRITICAL);
     NVIC_EnableIRQ(FCCU_INT0_IRQn);
 
-    /* Enable GPIO5 handler */
-    NVIC_EnableIRQ(Reserved71_IRQn);
+    /* Enable GPIO5 INTB handler (output 1) */
+    /* An INTB storm must yield to the SCMI mailboxes, never tail-chain over them */
+    NVIC_SetPriority(Reserved72_IRQn, IRQ_PRIO_NOPREEMPT_LOW);
+    NVIC_EnableIRQ(Reserved72_IRQn);
 }
 
 /*--------------------------------------------------------------------------*/
@@ -550,6 +553,10 @@ void BOARD_SystemSleepPrepare(uint32_t sleepMode, uint32_t sleepFlags)
     /* Configure LPI for GPIO1 */
     (void) CPU_PerLpiConfigSet(CPU_IDX_M33P, CPU_PER_LPI_IDX_GPIO1,
         CPU_PER_LPI_ON_RUN_WAIT_STOP);
+
+    /* Configure LPI for GPIO5 (PF09 INTB) */
+    (void) CPU_PerLpiConfigSet(CPU_IDX_M33P, CPU_PER_LPI_IDX_GPIO5,
+        CPU_PER_LPI_ON_RUN_WAIT_STOP);
 }
 
 /*--------------------------------------------------------------------------*/
@@ -601,6 +608,12 @@ void BOARD_SystemSleepUnprepare(uint32_t sleepMode, uint32_t sleepFlags)
 {
     BRD_SM_VoltageRestore();
 
+    /* Re-arm INTB if WAKEUPMIX was reset */
+    BRD_SM_IntbConfig();
+
+    /* WAKEUPMIX was off: a latch raised in sleep shows only on a read */
+    (void) BRD_SM_Pf09Handler();
+
     /* Service SM LPUART wakeup events */
     if (s_uartConfig.base != NULL)
     {
diff --git a/boards/krimx95/pin_mux.c b/boards/krimx95/pin_mux.c
index 15553b8..c2c6634 100755
--- a/boards/krimx95/pin_mux.c
+++ b/boards/krimx95/pin_mux.c
@@ -53,6 +53,9 @@ void BOARD_InitPins(void)
 
     /* Configure GPIO5-14 (INT from the PMIC PF09) */
     IOMUXC_SetPinMux(IOMUXC_PAD_GPIO_IO34__GPIO5_IO_BIT14, 0U);
-    IOMUXC_SetPinConfig(IOMUXC_PAD_GPIO_IO34__GPIO5_IO_BIT14, 0U);
+    /* Open-drain rise ~200ns exceeds 25ns Schmitt threshold; hysteresis blocks I2C crosstalk */
+    /* IOMUXC_PAD_HYS() shifts by 11, mask is bit 12; use the mask directly */
+    IOMUXC_SetPinConfig(IOMUXC_PAD_GPIO_IO34__GPIO5_IO_BIT14,
+        IOMUXC_PAD_HYS_MASK | IOMUXC_PAD_PU(0x1U));
 }
 
diff --git a/boards/krimx95/sm/Makefile b/boards/krimx95/sm/Makefile
index 2ef7623..758c292 100755
--- a/boards/krimx95/sm/Makefile
+++ b/boards/krimx95/sm/Makefile
@@ -61,3 +61,11 @@ OBJS += \
 	$(OUT)/fsl_pf09.o  \
 	$(OUT)/fsl_pf53.o  \
 
+
+# The SM slot in imx-boot is 179200 bytes; board code is not hot, size first
+$(OUT)/brd_sm_voltage.o: CFLAGS += -Os
+$(OUT)/brd_sm_handlers.o: CFLAGS += -Os
+$(OUT)/brd_sm.o: CFLAGS += -Os
+
+# Bench-only code, but the M=2 image shares the same 179200 byte slot
+$(OUT)/monitor_cmds.o: CFLAGS += -Os
diff --git a/boards/krimx95/sm/brd_sm_handlers.c b/boards/krimx95/sm/brd_sm_handlers.c
index 7ec26c6..2d522f0 100755
--- a/boards/krimx95/sm/brd_sm_handlers.c
+++ b/boards/krimx95/sm/brd_sm_handlers.c
@@ -51,10 +51,31 @@
 #define BOARD_PF5301_DEV_ADDR       0x2AU
 #define BOARD_PF5302_DEV_ADDR       0x29U
 
+/* PF09 INTB (pin 41) on GPIO_IO34 = GPIO5.IO[14], WAKEUPMIX */
+#define BOARD_INTB_PIN              14U
+
 /* Local types */
 
 /* Local variables */
 
+/* PF09 12.7: a masked latch never asserts INTB, so nothing may clear it here */
+static const uint8_t s_pf09Unmasked[PF09_MASK_LEN] =
+{
+    [PF09_MASK_IDX_STATUS1] = 0x31U,
+    /* THERM is unmasked at runtime, so its bits are added by the service */
+    [PF09_MASK_IDX_STATUS2] = 0xF0U,
+    [PF09_MASK_IDX_STATUS3] = 0x04U,
+    [PF09_MASK_IDX_SW_ILIM] = 0x9FU,
+    [PF09_MASK_IDX_LDO_ILIM] = 0x07U,
+    /* Bits 7:6 are MON1/MON2, unmasked by BRD_SM_VmonInit when VMON is built */
+    [PF09_MASK_IDX_SW_UV] = 0x1FU,
+    [PF09_MASK_IDX_SW_OV] = 0x1FU,
+    [PF09_MASK_IDX_LDO_UV] = 0x0BU,
+    [PF09_MASK_IDX_LDO_OV] = 0x0BU,
+    /* PF09 Tab.60: ERRMON, FCCU1, FCCU0; RSTB/FS0B/PGOOD_FLT carry no action */
+    [PF09_MASK_IDX_IO] = 0x38U
+};
+
 /* Global variables */
 
 PF09_Type g_pf09Dev;
@@ -65,8 +86,6 @@ uint32_t g_pmicFaultFlags = 0U;
 
 /* Local functions */
 
-static void BRD_SM_Pf09Handler(void);
-
 /*--------------------------------------------------------------------------*/
 /* Init serial devices                                                      */
 /*--------------------------------------------------------------------------*/
@@ -88,33 +107,55 @@ int32_t BRD_SM_SerialDevicesInit(void)
             status = SM_ERR_HARDWARE_ERROR;
         }
 
-        /* Disable voltage monitor 1 */
+        /* VMON1/2 stay off until the boot levels are applied (BRD_SM_VmonInit) */
         if (status == SM_ERR_SUCCESS)
         {
-            if (!PF09_MonitorEnable(&g_pf09Dev, PF09_VMON1, false))
+            if (!PF09_MonitorEnable(&g_pf09Dev, PF09_VMON1, false)
+                || !PF09_MonitorEnable(&g_pf09Dev, PF09_VMON2, false))
             {
                 status = SM_ERR_HARDWARE_ERROR;
             }
         }
 
-        /* Disable voltage monitor 2 */
+        /* Disable the PWRUP interrupt */
         if (status == SM_ERR_SUCCESS)
         {
-            if (!PF09_MonitorEnable(&g_pf09Dev, PF09_VMON2, false))
+            const uint8_t mask[PF09_MASK_LEN] =
+            {
+                [PF09_MASK_IDX_STATUS1] = 0x08U
+            };
+
+            if (!PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, false))
             {
                 status = SM_ERR_HARDWARE_ERROR;
             }
         }
 
-        /* Disable the PWRUP interrupt */
+        /* PF09 12.7: only PWRUP is unmasked at reset; faults need explicit unmask */
         if (status == SM_ERR_SUCCESS)
         {
             const uint8_t mask[PF09_MASK_LEN] =
             {
-                [PF09_MASK_IDX_STATUS1] = 0x08U
+                /* STATUS1: VIN_OV, I2C_CRC, DCRC; SDWN stays masked, clearing it aborts shutdown */
+                [PF09_MASK_IDX_STATUS1] = 0x31U,
+                /* STATUS2: VANA_OV, VDIG_OV, BGMON, CLKMON; THERM set by PF09_TempAlarmSet */
+                [PF09_MASK_IDX_STATUS2] = 0xF0U,
+                /* STATUS3: BAD_CMD only; WD unused, LBIST/SHS carry no action */
+                [PF09_MASK_IDX_STATUS3] = 0x04U,
+                /* SW_ILIM: SW1LS OCP plus SW1-5 current limits */
+                [PF09_MASK_IDX_SW_ILIM] = 0x9FU,
+                [PF09_MASK_IDX_LDO_ILIM] = 0x07U,
+                /* SW_UV/OV: SW1-5 here; MON1/2 are unmasked by BRD_SM_VmonInit */
+                [PF09_MASK_IDX_SW_UV] = 0x1FU,
+                [PF09_MASK_IDX_SW_OV] = 0x1FU,
+                /* LDO_UV/OV: LDO1, LDO2, VAON; LDO3 bypasses VDD_SOC and follows DVS */
+                [PF09_MASK_IDX_LDO_UV] = 0x0BU,
+                [PF09_MASK_IDX_LDO_OV] = 0x0BU,
+                /* PF09 Tab.60: ERRMON and FCCU0/1 report SoC faults back to the PMIC */
+                [PF09_MASK_IDX_IO] = 0x38U
             };
 
-            if (!PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, false))
+            if (!PF09_IntEnable(&g_pf09Dev, mask, PF09_MASK_LEN, true))
             {
                 status = SM_ERR_HARDWARE_ERROR;
             }
@@ -176,7 +217,33 @@ int32_t BRD_SM_SerialDevicesInit(void)
         /* Handle any already pending PF09 interrupts */
         if (status == SM_ERR_SUCCESS)
         {
-            BRD_SM_Pf09Handler();
+            (void) BRD_SM_Pf09Handler();
+        }
+
+        /* IO_INT was masked until now, so no service ever reported it */
+        if (status == SM_ERR_SUCCESS)
+        {
+            uint8_t ioInt = 0U;
+
+            if (PF09_PmicRead(&g_pf09Dev, PF09_REG_IO_INT, &ioInt))
+            {
+                /* The journal is rewritten by every service, this must outlive it */
+                g_pmicFaultFlags |= ((uint32_t) ioInt) << BRD_SM_PMIC_IO_SHIFT;
+
+                /* PF09 12.7.2: W1C, and a masked IO latch is cleared nowhere else */
+                if (ioInt != 0U)
+                {
+                    (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_IO_INT, ioInt,
+                        0xFFU);
+                }
+            }
+        }
+
+        /* PWRUP_I is masked from here on, so no later service would clear it */
+        if (status == SM_ERR_SUCCESS)
+        {
+            (void) PF09_PmicWrite(&g_pf09Dev, PF09_REG_STATUS1_INT, 0x08U,
+                0xFFU);
         }
     }
 
@@ -191,7 +258,6 @@ int32_t BRD_SM_SerialDevicesInit(void)
         {
             status = SM_ERR_HARDWARE_ERROR;
         }
-
     }
 
     if (status == SM_ERR_SUCCESS)
@@ -207,8 +273,23 @@ int32_t BRD_SM_SerialDevicesInit(void)
         }
     }
 
-    // Configure PF09 interrupt handler
+    /* Configure the PF09 INTB interrupt */
     if (status == SM_ERR_SUCCESS)
+    {
+        BRD_SM_IntbConfig();
+    }
+
+    /* Return status */
+    return status;
+}
+
+/*--------------------------------------------------------------------------*/
+/* Configure INTB pin and interrupt                                         */
+/*--------------------------------------------------------------------------*/
+void BRD_SM_IntbConfig(void)
+{
+    /* LOCK only clears on reset; nonzero means this ran already */
+    if (GPIO5->LOCK == 0U)
     {
         rgpio_pin_config_t gpioConfig =
         {
@@ -216,34 +297,50 @@ int32_t BRD_SM_SerialDevicesInit(void)
             0U
         };
 
-        /* Init GPIO5-14 */
-        RGPIO_PinInit(GPIO5, 14U, &gpioConfig);
-        RGPIO_SetPinInterruptConfig(GPIO5, 14U, kRGPIO_InterruptOutput0,
-            kRGPIO_InterruptLogicZero);
-    }
+        /* TF-A imx9_bl31_setup.c sets PCNS/ICNS non-secure for GPIO2-5; keep pin 14 secure */
+        GPIO5->PCNS = ~(1UL << BOARD_INTB_PIN);
+        GPIO5->PCNP = ~(1UL << BOARD_INTB_PIN);
 
-    /* Return status */
-    return status;
+        /* RGPIO ICNS: a secure pin cannot target a non-secure output; own both first */
+        GPIO5->ICNS = 0U;
+        GPIO5->ICNP = 0U;
+
+        /* Output 0 belongs to Linux gpio-vf610; level low so no latch is ever missed */
+        RGPIO_PinInit(GPIO5, BOARD_INTB_PIN, &gpioConfig);
+        RGPIO_SetPinInterruptConfig(GPIO5, BOARD_INTB_PIN,
+            kRGPIO_InterruptOutput1, kRGPIO_InterruptLogicZero);
+
+        /* RGPIO ICR.LK: locked until next system reset; gpio-vf610 probe zeroes all ICR */
+        GPIO5->ICR[BOARD_INTB_PIN] |= RGPIO_ICR_LK_MASK;
+
+        /* Hand output 0 back so Linux GPIO interrupts keep working */
+        GPIO5->ICNS = RGPIO_ICNS_NSE0_MASK;
+        GPIO5->ICNP = RGPIO_ICNP_NPE0_MASK;
+
+        /* RGPIO LOCK: PCNS/ICNS/PCNP/ICNP not writable until next reset */
+        GPIO5->LOCK = RGPIO_LOCK_PCNS_MASK | RGPIO_LOCK_ICNS_MASK
+            | RGPIO_LOCK_PCNP_MASK | RGPIO_LOCK_ICNP_MASK;
+    }
 }
 
 /*--------------------------------------------------------------------------*/
-/* GPIO5 handler                                                            */
+/* GPIO5 output 1 handler                                                   */
 /*--------------------------------------------------------------------------*/
-void Reserved71_IRQHandler(void)
+void Reserved72_IRQHandler(void)
 {
     uint32_t flags;
 
     /* Get GPIO status */
-    flags = RGPIO_GetPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput0);
-
-    /* Clear GPIO interrupts */
-    RGPIO_ClearPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput0, flags);
+    flags = RGPIO_GetPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1);
 
     /* Handle PF09 interrupt */
-    if ((flags & (1U << 14)) != 0U)
+    if ((flags & (1UL << BOARD_INTB_PIN)) != 0U)
     {
         BRD_SM_Pf09Handler();
     }
+
+    /* RGPIO ISF re-asserts while level is low; clear after the PMIC latches */
+    RGPIO_ClearPinsInterruptFlags(GPIO5, kRGPIO_InterruptOutput1, flags);
 }
 
 /*==========================================================================*/
@@ -251,20 +348,48 @@ void Reserved71_IRQHandler(void)
 /*--------------------------------------------------------------------------*/
 /* PF09 handler                                                             */
 /*--------------------------------------------------------------------------*/
-static void BRD_SM_Pf09Handler(void)
+void BRD_SM_Pf09Handler(void)
 {
     uint8_t stat[PF09_MASK_LEN] = { 0 };
 
     /* Read status of interrupts */
-    (void) PF09_IntStatus(&g_pf09Dev, stat, PF09_MASK_LEN);
+    if (PF09_IntStatus(&g_pf09Dev, stat, PF09_MASK_LEN))
+    {
+        bool therm;
+        uint8_t thermStat;
 
-    /* Clear pending */
-    (void) PF09_IntClear(&g_pf09Dev, stat, PF09_MASK_LEN);
+        thermStat = stat[PF09_MASK_IDX_STATUS2] & 0x0FU;
+        therm = (thermStat != 0U);
 
-    /* Handle pending temp interrupts */
-    if ((stat[PF09_MASK_IDX_STATUS2] & 0x0FU) != 0U)
-    {
-        BRD_SM_SensorHandler();
+        /* PF09 12.4.1.1: clearing a masked latch drops evidence and aborts a shutdown */
+        for (uint32_t idx = 0U; idx < PF09_MASK_LEN; idx++)
+        {
+            stat[idx] &= s_pf09Unmasked[idx];
+        }
+
+        /* PF09_TempAlarmSet moves the armed THERM bit, and it must still be cleared */
+        if (therm)
+        {
+            uint8_t tMask;
+
+            /* A failed read clears them all: losing evidence beats a stuck INTB */
+            if (!PF09_PmicRead(&g_pf09Dev, PF09_REG_STATUS2_MASK, &tMask))
+            {
+                tMask = 0x00U;
+            }
+
+            stat[PF09_MASK_IDX_STATUS2] |=
+                (uint8_t) (thermStat & (uint8_t) (~tMask));
+        }
+
+        /* Clear pending */
+        (void) PF09_IntClear(&g_pf09Dev, stat, PF09_MASK_LEN);
+
+        /* Handle pending temp interrupts */
+        if (therm)
+        {
+            BRD_SM_SensorHandler();
+        }
     }
 }
 
diff --git a/boards/krimx95/sm/brd_sm_handlers.h b/boards/krimx95/sm/brd_sm_handlers.h
index 86d1138..6e58393 100755
--- a/boards/krimx95/sm/brd_sm_handlers.h
+++ b/boards/krimx95/sm/brd_sm_handlers.h
@@ -57,6 +57,9 @@
 
 /* Defines */
 
+/* PF09 12.7: the driver keeps FAULT_FLAGS in 0-7 and HFAULT_FLAGS in 8-15 */
+#define BRD_SM_PMIC_IO_SHIFT  16U  /*!< IO_INT latches read once at boot */
+
 /* Types */
 
 /* External variables */
@@ -82,11 +85,22 @@ extern uint32_t g_pmicFaultFlags;
  */
 int32_t BRD_SM_SerialDevicesInit(void);
 
+/*!
+ * Configure the PF09 INTB pin and interrupt.
+ *
+ * Does nothing while GPIO5 is still locked.
+ */
+void BRD_SM_IntbConfig(void);
+
+/*!
+ * GPIO 5 interrupt 1 handler.
+ */
+void Reserved72_IRQHandler(void);
 
 /*!
- * GPIO 5 interrupt 0 handler.
+ * Read and clear the pending PF09 interrupts.
  */
-void Reserved71_IRQHandler(void);
+void BRD_SM_Pf09Handler(void);
 
 /** @} */
 
-- 
2.43.0

